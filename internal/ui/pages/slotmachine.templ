package pages

import (
	"github.com/koopa0/yomihon/internal/wording"
	"strconv"

	"github.com/koopa0/yomihon/internal/lesson"
)

// SlotMachine renders one lesson's sentence-pattern practice, a card per
// pattern. Everything visible is server-rendered from each slot's first fill,
// so the sentences read correctly with scripting off; the client upgrades the
// cards to swap fills, recolour, shuffle and speak.
templ SlotMachine(s *lesson.Sidecar, nonce string, lang wording.Lang) {
	<section class="y-slotmachine" lang={ lang.Tag() } aria-label={ wording.SlotMachineLabel.In(lang) }>
		<div class="y-slotmachine__intro">
			<h2 class="y-slotmachine__title">{ wording.SlotMachineLabel.In(lang) }</h2>
			if s.Note != "" {
				<p class="y-slotmachine__sub">{ s.Note }</p>
			} else {
				<p class="y-slotmachine__sub">{ wording.SlotMachineLede.In(lang) }</p>
			}
		</div>
		for i, p := range s.Patterns {
			@slotCard(i, p, nonce, lang)
		}
	</section>
}

// slotCard is one pattern: its data blob, the abstract frame and optional note,
// one select per distinct slot, the live sentence, the gloss, and the speak and
// shuffle actions.
//
// The card is an article, which a screen reader offers as a region to jump to,
// and its abstract frame is the heading that names it. The heading's id comes
// from the card's position rather than the pattern's authored id, which nothing
// checks for being present or distinct.
//
// The card closes with the region the client speaks through: shuffling rewrites
// the sentence in place, which a listening reader does not see. It ships empty
// so arriving announces nothing, and declares Japanese because the sentence is
// Japanese — the nearest declared language above it would be the wrong voice.
templ slotCard(index int, p lesson.Pattern, nonce string, lang wording.Lang) {
	{{ headingID := "slot-pattern-" + strconv.Itoa(index+1) }}
	<article class="y-slotcard" aria-labelledby={ headingID }>
		@templ.Raw(`<script nonce="` + templ.EscapeString(nonce) + `" type="application/json" class="y-slotdata">` + lesson.PatternJSON(p) + `</script>`)
		<header class="y-slotcard__head">
			<h3 class="y-slotcard__abstract" id={ headingID } lang="ja">{ lesson.AbstractTemplate(p.Template) }</h3>
			if p.Note != "" {
				<span class="y-slotcard__note">{ p.Note }</span>
			}
		</header>
		<div class="y-slotcontrols">
			for _, key := range lesson.TemplateKeys(p.Template) {
				@slotControl(key, p.Slots[key])
			}
		</div>
		@slotOutput(p)
		<p class="y-slotgloss">{ lesson.GlossInitial(p) }</p>
		<div class="y-slotactions">
			<button type="button" class="y-slotbtn" data-slot-action="speak" aria-label={ wording.SlotMachineSpeak.In(lang) }>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4z"></path><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg>
			</button>
			<button type="button" class="y-slotbtn" data-slot-action="shuffle" aria-label={ wording.SlotMachineShuffle.In(lang) }>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3h5v5"></path><path d="M4 20 21 3"></path><path d="M21 16v5h-5"></path><path d="m15 15 6 6"></path><path d="M4 4l5 5"></path></svg>
			</button>
		</div>
		<p class="y-slotlive y-offscreen" role="status" aria-live="polite" aria-atomic="true" lang="ja"></p>
	</article>
}

// slotControl is one slot's picker: its label and a <select> whose options are
// the fills. The inner button carries the closed face where the customizable
// select is supported and is inert elsewhere; the colour class assigns --c.
templ slotControl(key string, pos lesson.Position) {
	<label class="y-slotfield">
		<span class="y-slotfield__label">{ pos.LabelZH }</span>
		<select class={ "y-slotselect", "y-slot-" + pos.Color } data-slot-key={ key }>
			<button type="button"><selectedcontent></selectedcontent></button>
			for i, f := range pos.Fills {
				<option value={ strconv.Itoa(i) }>{ f.JP } — { f.ZH }</option>
			}
		</select>
	</label>
}

// slotOutput is the live sentence: literal template text as bare nodes, each
// slot as a coloured, ruby-annotated span the client rewrites on change.
templ slotOutput(p lesson.Pattern) {
	<p class="y-slotoutput" lang="ja">
		for _, seg := range lesson.ParseTemplate(p.Template) {
			if seg.Key == "" {
				{ seg.Text }
			} else {
				@slotOut(seg.Key, p.Slots[seg.Key])
			}
		}
	</p>
}

// slotOut is one slot's rendered word: the first fill's surface form over its
// reading. The client finds it by data-slot-key and rewrites the base and the
// reading; the colour class supplies --c.
templ slotOut(key string, pos lesson.Position) {
	<span class={ "y-slotout", "y-slot-" + pos.Color } data-slot-key={ key }>
		<ruby><span>{ lesson.FirstFill(pos).JP }</span><rt>{ lesson.FirstFill(pos).Reading }</rt></ruby>
	</span>
}
