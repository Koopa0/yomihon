package pages

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/koopa0/yomihon/internal/lesson"
	"github.com/koopa0/yomihon/internal/nav"
	"github.com/koopa0/yomihon/internal/render"
	"github.com/koopa0/yomihon/internal/snapshot"
	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// NoteView is everything the reading page needs. Diagnostic and
// RenderDiagnostics are display-only: yomihon reports what it found, and a
// human edits the file.
type NoteView struct {
	// NestedTitle places this note under a page heading rather than making
	// it the page heading itself. Its body must already occupy that level.
	NestedTitle bool
	Title       string
	RelPath     string
	// Language is what the note is written in, as the note declares it. The
	// language the page's own words are in arrives with the chrome, so one
	// page cannot hold two answers to it.
	Language string
	Type     string
	// Draft is whether the note declares itself unfinished, which the head
	// says in one quiet word and nothing else on the page acts on.
	Draft bool
	// ObsidianHref is the obsidian://open URI for this note, already built
	// and escaped by ObsidianHref. Empty renders no editor link.
	ObsidianHref string
	Diagnostic   string
	// Stale is set where the file could not be read while this page was built,
	// so the words below are the last ones read rather than the current ones.
	Stale bool
	// ParsePanic names a failed attempt to parse the current bytes, including
	// while this reading is retained before a stale generation is published.
	ParsePanic  bool
	ParseReason string
	// VerifiedOn is the day the author wrote down as the one they last checked
	// the note on, as the facts at its end print it, and VerifiedAt its
	// machine-readable value. It is their word, said as theirs. A note that
	// declares none shows no date: a blank is better than a claim, and the
	// file's own change time is the checkout's, not the author's.
	VerifiedOn string
	VerifiedAt string
	// Prerequisites are the notes the author named as ones to know first, in
	// the order they wrote them. A name that placed one note is a link; any
	// other stays the author's own text.
	Prerequisites []nav.NoteRef
	// TitleThoughts are the reader's own thoughts whose source is the note as
	// a whole, listed beside its title.
	TitleThoughts []ThoughtLine
	BodyHTML      string
	// TitleAnchor is the id the title carries, set where the renderer dropped a
	// duplicate opening heading, so a link written at that section still lands.
	// Empty where the note wrote no such heading: an anchor there would answer
	// for a section nobody wrote.
	TitleAnchor string

	RenderDiagnostics []render.Diagnostic
	// Prev and Next are the notes either side of this one in the sequence the
	// foot of the article offers. StepsLabel names that sequence — a course's
	// step onward, or folder adjacency — and is both the landmark's name and,
	// for a folder, the line printed above the steps; a course prints StepsPath
	// there instead. StepsCourse says which order arrived, which picks the step
	// words, and StepsUnit is the noun a course's steps are named in.
	Prev        nav.NoteRef
	Next        nav.NoteRef
	StepsLabel  string
	StepsCourse bool
	StepsUnit   nav.Unit
	// StepsPath is the study path whose order the foot walks, printed as a link
	// to its contents. A side branch's lesson carries the ways off the branch,
	// StepsBack and StepsOnward or StepsToContents, and the lesson a branch hangs
	// from the branches themselves, StepsAsides. None of them is a step: they
	// are drawn beside Prev and Next and never in place of either.
	StepsPath       nav.NoteRef
	StepsBack       nav.NoteRef
	StepsOnward     nav.NoteRef
	StepsToContents bool
	StepsAsides     []nav.NoteRef
	// VaultHasLinks says some note in this folder cites another. Where none
	// does, an empty cited-by block on every page is furniture; where the
	// folder does use links, an empty block is a finding and stays.
	VaultHasLinks bool
	// CitedBy are the notes whose text links here. An empty list is an answer —
	// the note is an island — so the block states that rather than vanishing.
	CitedBy []nav.NoteRef
	// BasedOn are the sources this note declared in based_on, in declaration
	// order, grouped by file with the authored locations retained. An unresolved
	// name stays unlinked. An empty list hides the block — declaring
	// nothing is the default, not a finding.
	BasedOn []snapshot.DeclaredSource
	// DeclaredBy keeps each declaring note separate from places in this source.
	DeclaredBy []DeclaringNoteView
	// Pair is the one other note this one is offered to be read beside, or the
	// zero value where none is. The offer says the same words whichever way the
	// pair was found, so nothing here says which; two candidates at the same
	// footing are no offer at all, this surface never picking one of them.
	Pair nav.NoteRef
	TOC  []render.TOCEntry

	// IDPrefix is the id space this article occupies. It is empty on a page
	// showing one note, where every name inside the article is the note's own,
	// and names a column on a page showing two. The rendered body and the
	// contents entries arrive already named under it; this is what the names
	// the template writes go under, so one article's addresses and described
	// controls never reach into the other's.
	IDPrefix string

	// ReadingRail is the one map this page carries in the left rail.
	ReadingRail ReadingRail

	// ContentIdentity is the hex identity of the source bytes this page
	// rendered, which the freshness watch and a kept place both bind to.
	ContentIdentity string
	// MarkAddress is where the control for keeping a reading place posts to.
	// Empty where this process keeps no marks, and the control is then absent
	// rather than offering a reader something with nowhere to go.
	MarkAddress string
	// PlaceKept is whether the place the reader left off at is in this note.
	// The control for keeping one then says so, so a reader who comes back to
	// the note is told it already holds their place and not asked to guess.
	PlaceKept          bool
	UncertaintyAddress string
	ThoughtDoor        bool
	// TranscludedIdentity is the render's digest over what every embed here came
	// to — the excerpt pulled in, or the absence shown in its place — and is
	// empty where the page carries none. It rides the freshness watch beside
	// ContentIdentity, which covers the note's own bytes and no embedded source.
	TranscludedIdentity string
	// FrontmatterUnclosed is set where the note opened a frontmatter fence and
	// nothing closed it. Every reader took such a note for body text with no
	// block, and this is what says the block was meant: the page states the
	// fence never closes.
	FrontmatterUnclosed bool
	// SchemaNotices is what the schema said about this note's frontmatter, one
	// sentence per fault, already in the reader's language and already split
	// into the words and the note's own text they sit around.
	SchemaNotices [][]wording.SchemaPart

	// Concepts are the grammar-concept notes this lesson links to, each
	// pre-rendered for the concept sheet.
	Concepts []lesson.ConceptDoc
}

// Note is the reading page: the article in the shared shell, with the
// navigation sidebar beside it, which carries the note's contents under the row
// that is the note. Everything it shows is either the note's own bytes rendered
// faithfully or a diagnostic about them; it repairs nothing.
templ Note(v NoteView, c layouts.Chrome) {
	{{ lang := c.Lang }}
	// The header carries the same control at the widths that have no rail, and
	// this is where it learns it may: only a reading page hands the chrome an
	// offer, so every other page's header has nothing to draw.
	{{ c.Mark = v.markOffer() }}
	// The same holds for the furigana switch: only the page knows whether
	// what it rendered carries any readings to switch.
	{{ c.Readings = v.carriesReadings() }}
	@layouts.Base(c) {
		// The sheet owns an id outside the authored section namespace.
		@conceptSheet(v.Concepts, lang)
		<div class="y-nav-scrim" data-nav-close></div>
		<div class="y-shell">
			@readingRail(v.railWithContents(), c)
			<main id="_y-main" tabindex="-1" class="y-main" { freshnessAttrs(&v, lang)... } { readAloudAttrs(v.BodyHTML, lang)... } data-preview-endpoint="/preview/">
				@noteArticle(v, lang)
			</main>
		</div>
		@previewCard()
	}
}

// noteArticle is one note as it reads: its head, whatever the schema said about
// it, the rendered body, the notes that stand beside it, and the way onward. It is a component rather than markup inside the page because a page
// showing two notes beside one another draws the same thing twice, and a second
// copy of this would be free to drift from the one a reader sees on the note's
// own page.
// A nested title and body occupy one level below their enclosing page heading.
templ noteArticle(v NoteView, lang wording.Lang) {
	<article class="y-article" { authoredLanguageAttrs(v.Language)... } { uncertaintyAttrs(&v, lang)... }>
		@articleHead(v, lang)
		@frontmatterUnclosedNotice(v, lang)
		@schemaNotices(v, lang)
		@inlineAids(v, lang)
		@layouts.CodeCopy(lang)
		<div class="y-prose">
			if strings.TrimSpace(v.BodyHTML) == "" && !v.hasUnclosedComment() {
				@nothingToShow(nothingNotice{Kind: "note"}) {
					<p lang={ lang.Tag() }>{ wording.NoteEmptyBody.In(lang) }</p>
				}
			} else {
				@templ.Raw(v.BodyHTML)
			}
		</div>
		@relatedAids(v, lang)
		@sequenceSteps(v, lang)
	</article>
}

// conceptSheet is the grammar-concept drawer: one hidden <template> per concept
// the lesson links to, plus a shared native <dialog> the client clones into.
// With scripting off the triggers stay ordinary links to the concept notes.
//
// Opening it is the one overlay on this page that the markup cannot declare.
// The trigger is a link the renderer writes into the note's own prose, and the
// attributes that name an act belong to buttons; a button there would take
// that navigation away from a reader with no script, and it would be an empty
// sheet they opened, because the words in it are cloned from a template by the
// same script. Closing is another matter: the press says what it closes, and
// the browser closes it.
templ conceptSheet(concepts []lesson.ConceptDoc, lang wording.Lang) {
	if len(concepts) > 0 {
		for _, c := range concepts {
			<template id={ "_y-concept-" + c.ID } data-title={ conceptSheetTitle(c.Title, lang) }>
				@templ.Raw(c.HTML)
			</template>
		}
		<dialog id="_y-concept-sheet" class="y-conceptsheet" data-concept-sheet aria-labelledby="_y-concept-title" closedby="any">
			<div class="y-conceptsheet__head">
				<h2 id="_y-concept-title" class="y-conceptsheet__title" data-concept-title></h2>
				<button type="button" class="y-iconbtn" command="close" commandfor="_y-concept-sheet" aria-label={ wording.CloseControl.In(lang) }>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
				</button>
			</div>
			@layouts.CodeCopy(lang)
			<div class="y-conceptsheet__body y-prose" data-concept-body></div>
		</dialog>
	}
}

// articleHead is the title above the rendered body, which follows it after a
// space rather than a rule. Nothing stands above the title: the sidebar already
// says which course the note is in and which part, or which folder, so a line
// over the heading would say it a second time. Nothing stands under it either:
// the note's facts, the file it is and the way to its editor wait at the end of
// the text, where a reader who has finished looks for them.
//
// A title with thoughts of the reader's own about the note as a whole stands in
// a row with them, as a heading stands with its section's margin.
templ articleHead(v NoteView, lang wording.Lang) {
	if len(v.TitleThoughts) > 0 {
		<div class="y-sect y-sect--title">
			@noteTitle(v)
			@titleMargin(v.TitleThoughts, lang)
		</div>
	} else {
		@noteTitle(v)
	}
	if v.ParsePanic {
		<p class="y-fileinfo__note" lang={ lang.Tag() } data-note-stale>{ wording.NoteParseStale.In(lang) } <code lang="en">{ v.ParseReason }</code></p>
	} else if v.Stale {
		<p class="y-fileinfo__note" lang={ lang.Tag() } data-note-stale>{ wording.NoteStale.In(lang) }</p>
	}
}

// noteTitle is the heading itself. A jump has to land on the words it named, so
// the anchor goes on the visible heading rather than a hidden marker beside it.
templ noteTitle(v NoteView) {
	if v.NestedTitle {
		if v.TitleAnchor != "" {
			<h2 id={ v.TitleAnchor } class="y-title">{ v.Title }</h2>
		} else {
			<h2 class="y-title">{ v.Title }</h2>
		}
	} else if v.TitleAnchor != "" {
		<h1 id={ v.TitleAnchor } class="y-title">{ v.Title }</h1>
	} else {
		<h1 class="y-title">{ v.Title }</h1>
	}
}

// draftMark is the one word a note that declared draft: true carries among its
// facts, in the interface's language. It is a fact about the note, not a
// control: the flag is the author's, written and removed in their editor. A
// finished note carries none, being the ordinary state.
templ draftMark(v NoteView, lang wording.Lang) {
	if v.Draft {
		<p class="y-facts__draft"><span class="ui-status" lang={ lang.Tag() } data-note-draft>{ wording.Draft.In(lang) }</span></p>
	}
}

// noteFacts is the note's own facts, read as a description list: one dt/dd
// pair per fact the note declared, in the same order every time. They stand at
// the end of the text with what stands beside the note, so there is one place
// to look for what the note is. Every term carries the interface's language and
// every value the note's own: a type, a BCP 47 tag and a path are the contract's
// own spelling, never translated, so only the label beside each is.
//
// The day is the author's: the one they wrote as the day they checked the note,
// never the file's change time, which a checkout stamps on every file at once. A
// note that wrote none shows no day. The two doors out of the page, to the file
// in its editor and to a thought of the reader's own about the whole note, stand
// with the file they leave from.
templ noteFacts(v NoteView, lang wording.Lang) {
	if v.factsShown() {
		<div class="y-facts">
			@draftMark(v, lang)
			if v.factRows() {
				<dl class="y-notefacts">
					if v.Type != "" {
						<div>
							<dt lang={ lang.Tag() }>{ wording.FileType.In(lang) }</dt>
							<dd>{ v.Type }</dd>
						</div>
					}
					// A note that declared no lang shows no row for one: the absence is
					// the answer, not a blank waiting to be filled in.
					if v.Language != "" {
						<div>
							<dt lang={ lang.Tag() }>{ wording.NoteLanguage.In(lang) }</dt>
							<dd>{ v.Language }</dd>
						</div>
					}
					if v.VerifiedOn != "" {
						<div>
							<dt lang={ lang.Tag() }>{ wording.VerifiedOn.In(lang) }</dt>
							<dd><time datetime={ v.VerifiedAt }>{ v.VerifiedOn }</time></dd>
						</div>
					}
					if len(v.Prerequisites) > 0 {
						<div>
							<dt lang={ lang.Tag() }>{ wording.Prerequisites.In(lang) }</dt>
							<dd>
								<ul class="y-notefacts__links" role="list">
									for _, ref := range v.Prerequisites {
										<li>
											if ref.RelPath != "" {
												<a href={ templ.URL(notesHref(ref.RelPath)) } { authoredLanguageAttrs(ref.Language)... }>{ ref.Name }</a>
											} else {
												<span>{ ref.Name }</span>
											}
										</li>
									}
								</ul>
							</dd>
						</div>
					}
					if v.RelPath != "" {
						<div>
							<dt lang={ lang.Tag() }>{ wording.RawFile.In(lang) }</dt>
							<dd>
								<a class="y-notefacts__path" href={ templ.URL(rawHref(v.RelPath)) }>{ v.RelPath }</a>
								@obsidianDoor(v, lang)
								@thoughtDoor(v, lang)
							</dd>
						</div>
					}
				</dl>
			}
		</div>
	}
}

// obsidianDoor is the way to where a repair actually happens. It is not a fact
// about the note, so it sits beside the path rather than being a row of its
// own: every repair yomihon's diagnostics report is a hand edit, and this is
// the page's one door to where that edit is made. The href is already built and
// escaped server-side, so it bypasses the sanitizer that would reject its custom
// scheme.
templ obsidianDoor(v NoteView, lang wording.Lang) {
	if v.ObsidianHref != "" {
		<a class="y-notefacts__door" lang={ lang.Tag() } href={ templ.SafeURL(v.ObsidianHref) }>{ wording.OpenInObsidian.In(lang) }</a>
	}
}

// thoughtDoor is the page-level way to leave a thought about the note as a
// whole. It stands beside the Obsidian door, in the same link style, so it reads
// as something the reader can do with the note rather than as a stray line of the
// article. A section has its own beside its heading.
templ thoughtDoor(v NoteView, lang wording.Lang) {
	if v.ThoughtDoor {
		<a class="y-notefacts__door" lang={ lang.Tag() } href={ templ.URL(thoughtHref(v.RelPath, "")) } aria-label={ fmt.Sprintf(wording.ThoughtSectionFmt.In(lang), v.Title) }>{ wording.ThoughtDoor.In(lang) }</a>
	}
}

// pairOffer is the way to the page that holds this note and one other at once.
// It is absent where no other note belongs beside this one, which is the
// ordinary case: a note with no translation and no declared source has no pair
// to offer, and a block saying so on every page would be furniture.
//
// The link reads as what following it does. The partner's own name is the link
// text and carries whatever language that note declared, since a translation's
// title is written in the language it was translated into.
templ pairOffer(v NoteView, lang wording.Lang) {
	if v.Pair.RelPath != "" {
		<nav class="y-pair" aria-label={ wording.CompareOfferNav.In(lang) }>
			<div class="ui-side__label">{ wording.CompareOffer.In(lang) }</div>
			<a class="ui-navitem" href={ templ.URL(compareHref(v.RelPath, v.Pair.RelPath)) } { authoredLanguageAttrs(v.Pair.Language)... }>{ v.Pair.Name }</a>
		</nav>
	}
}

// basedOn lists the sources this note declared in based_on. It is absent when
// the note declared none: that is the default, not a finding. A unique
// resolution is a title and a link; an unresolved or ambiguous value is the
// author's own text, never a guessed address.
templ basedOn(v NoteView, lang wording.Lang) {
	if len(v.BasedOn) > 0 {
		@basedOnBlock(v, lang)
	}
}

templ basedOnBlock(v NoteView, lang wording.Lang) {
	<nav class="y-basedon" aria-label={ wording.BasedOnNav.In(lang) }>
		<div class="ui-side__label">
			{ wording.BasedOn.In(lang) }
			<span class="ui-navitem__count">{ strconv.Itoa(len(v.BasedOn)) }</span>
		</div>
		<ul class="y-basedon__groups">
			for _, ref := range v.BasedOn {
				<li>
					if ref.RelPath == "" {
						<span class="ui-navitem">{ ref.Name }</span>
					} else if len(ref.Locations) == 1 && !ref.WholeFile {
						@sourceLocation(ref.RelPath, ref.Name+" › ", ref.Locations[0])
					} else {
						<a class="ui-navitem" href={ templ.URL(notesHref(ref.RelPath)) }>{ ref.Name }</a>
						if len(ref.Locations) > 0 {
							<ul class="y-basedon__locations">
								for _, location := range ref.Locations {
									<li>
										@sourceLocation(ref.RelPath, "", location)
									</li>
								}
							</ul>
						}
					}
				</li>
			}
		</ul>
	</nav>
}

// sourceLocation keeps missing-place information visible at the point of choice.
templ sourceLocation(relPath, prefix string, location render.SourceLocation) {
	<a class={ "ui-navitem", templ.KV("wikilink-broken wikilink-degraded", location.Reason != "") } href={ templ.URL(sourceLocationHref(relPath, location.Fragment)) } title={ location.Reason }>
		<span>
			{ prefix + location.Label }
			if location.Reason != "" {
				<span class="y-basedon__reason">{ location.Reason }</span>
			}
		</span>
	</a>
}

// citedBy lists the notes whose text links to this one. Nothing is a real
// answer and is said out loud: a block that vanished at zero would leave a
// reader unable to tell an island from an interface that does not know.
templ citedBy(v NoteView, lang wording.Lang) {
	if v.citedByShown() {
		@citedByBlock(v, lang)
	}
}

// citedByBlock is the block itself, rendered only where the answer means
// something.
templ citedByBlock(v NoteView, lang wording.Lang) {
	<nav class="y-citedby" aria-label={ wording.CitedByNav.In(lang) }>
		<div class="ui-side__label">
			{ wording.CitedBy.In(lang) }
			if len(v.CitedBy) > 0 {
				<span class="ui-navitem__count">{ strconv.Itoa(len(v.CitedBy)) }</span>
			}
		</div>
		if len(v.CitedBy) > 0 {
			for _, ref := range v.CitedBy {
				<a class="ui-navitem" href={ templ.URL(notesHref(ref.RelPath)) }>{ ref.Name }</a>
			}
		} else {
			<p class="y-citedby__none">{ wording.CitedByNone.In(lang) }</p>
		}
	</nav>
}

// sequenceSteps closes the article with the way onward: a folder of dated
// entries is a line, and so is a course of lessons. The foot says which order
// arrived, so the arrow never claims one it is not walking, and it is printed
// rather than only spoken, because a course's declared order and folder
// adjacency can disagree completely.
//
// The folder's foot prints its label and names the landmark with the same
// field, so the two cannot drift apart. A course's foot prints the path's title
// as a link to its contents and names the landmark with the step onward, on
// purpose: the sidebar already carries a landmark named for the course's order,
// and a second landmark with the same words as the link inside it would be one
// name heard twice.
//
// The foot's own words belong to the interface, and the two titles it names
// belong to the notes they lead to, each carrying whatever language that note
// declared and none where it declared nothing.
templ sequenceSteps(v NoteView, lang wording.Lang) {
	if v.hasSteps() {
		<nav class={ "y-steps", templ.KV("y-steps--course", v.StepsCourse) } lang={ lang.Tag() } aria-label={ v.StepsLabel }>
			// A course names itself with a link to its contents, which is the
			// way off the foot the book offers wherever the reader is; the
			// folder's order is only named. The landmark's own name stays the
			// step onward from this note, so it is not the link's words twice.
			if v.StepsCourse && v.StepsPath.RelPath != "" {
				<p class="y-steps__source"><a class="y-steps__path" href={ templ.URL(courseHrefFrom(v.StepsPath.RelPath, v.RelPath)) } { authoredLanguageAttrs(v.StepsPath.Language)... }>{ v.StepsPath.Name }</a></p>
			} else {
				<p class="y-steps__source">{ v.StepsLabel }</p>
			}
			// The left place is the step back, or on a side branch's first
			// lesson, which has none, the way back to the lesson it hangs
			// from. The right is the step on, or on its last lesson the way
			// on to the main line. A lesson is never both a branch's first and
			// a main-line lesson with a step back, so the two never compete.
			if v.Prev.RelPath != "" {
				<a class="y-steps__link y-steps__link--prev" href={ templ.URL(notesHref(v.Prev.RelPath)) } rel="prev">
					<span class="y-steps__role"><span class="y-steps__dir" aria-hidden="true">←</span> { stepWordPrev(v.StepsCourse, v.StepsUnit, lang) }</span>
					<span class="y-steps__name" { authoredLanguageAttrs(v.Prev.Language)... }>{ v.Prev.Name }</span>
				</a>
			} else if v.StepsBack.RelPath != "" {
				<a class="y-steps__link y-steps__link--prev y-steps__link--back" href={ templ.URL(notesHref(v.StepsBack.RelPath)) }>
					<span class="y-steps__role"><span class="y-steps__dir" aria-hidden="true">←</span> { wording.BranchBackTo.In(lang) }</span>
					<span class="y-steps__name" { authoredLanguageAttrs(v.StepsBack.Language)... }>{ v.StepsBack.Name }</span>
				</a>
			}
			if v.Next.RelPath != "" {
				<a class="y-steps__link y-steps__link--next" href={ templ.URL(notesHref(v.Next.RelPath)) } rel="next">
					<span class="y-steps__role">{ stepWordNext(v.StepsCourse, v.StepsUnit, lang) } <span class="y-steps__dir" aria-hidden="true">→</span></span>
					<span class="y-steps__name" { authoredLanguageAttrs(v.Next.Language)... }>{ v.Next.Name }</span>
				</a>
			} else if v.StepsOnward.RelPath != "" {
				<a class="y-steps__link y-steps__link--next y-steps__link--onward" href={ templ.URL(notesHref(v.StepsOnward.RelPath)) }>
					<span class="y-steps__role">{ wording.BranchOnward.In(lang) }</span>
					<span class="y-steps__name" { authoredLanguageAttrs(v.StepsOnward.Language)... }>{ v.StepsOnward.Name } <span class="y-steps__dir" aria-hidden="true">→</span></span>
				</a>
			} else if v.StepsToContents && v.StepsPath.RelPath != "" {
				<a class="y-steps__link y-steps__link--next y-steps__link--onward" href={ templ.URL(courseHrefFrom(v.StepsPath.RelPath, v.RelPath)) }>
					<span class="y-steps__role">{ wording.BranchToContents.In(lang) }</span>
				</a>
			}
			// The branches hanging from this lesson, as one quiet line each. They
			// are beside the steps and not among them: the next lesson is still
			// the main line's.
			for _, aside := range v.StepsAsides {
				<p class="y-steps__aside">
					<span class="y-steps__asidelabel">{ wording.BranchPrefix.In(lang) }</span><a class="y-steps__asidelink" href={ templ.URL(notesHref(aside.RelPath)) } { authoredLanguageAttrs(aside.Language)... }>{ aside.Name }</a>
				</p>
			}
		</nav>
	}
}

// tocList is the table-of-contents link list: the sidebar draws it under the
// row that is the note, and a column of a page holding two notes, which has no
// sidebar to carry it, draws it in its folded row. Both are this one list, so
// the two surfaces read as one.
//
// Every heading is the note's own text, so the list carries its language. It
// needs saying on the list because neither copy would otherwise inherit the right answer:
// the folded one sits inside a block that declares the language the interface
// speaks, and the sidebar one sits outside the article entirely, where the
// document's language is all there is. A note that declared no language stamps
// nothing here either, and both copies inherit the same page language the
// article does.
//
// The last row, where the note has an end block, leads down to it. It is named
// with the end block's own first heading, so the row and what it leads to say
// the same words.
templ tocList(v NoteView, lang wording.Lang) {
	<div class="y-toc__list" { authoredLanguageAttrs(v.Language)... }>
		for _, h := range v.TOC {
			<div class="y-toc__row">
				<a href={ templ.URL("#" + h.ID) } data-level={ strconv.Itoa(h.Level) }>{ h.Text }</a>
			</div>
		}
		if v.endShown() {
			<div class="y-toc__row y-toc__row--end">
				<a href={ templ.URL("#" + v.endID()) } lang={ lang.Tag() } data-level="2">{ v.endLabel(lang) }</a>
			</div>
		}
	</div>
}

// inlineAids is the folded contents row of a note that stands in a column of a
// page holding two. Such a column has no sidebar beside it, and the contents
// are what a reader reaches for before reading; every other aid waits at the
// end of the text, in the same block a note's own page ends on.
templ inlineAids(v NoteView, lang wording.Lang) {
	if v.NestedTitle && len(v.TOC) > 0 {
		<div class="y-inlineaids" lang={ lang.Tag() }>
			<details class="y-toc-inline">
				<summary class="y-toc-inline__summary">
					@chevron()
					<span class="y-toc-inline__parts">
						<span class="y-toc-inline__part">{ wording.OnThisPage.In(lang) }</span>
					</span>
				</summary>
				<div class="y-toc-inline__body">
					// The summary opens on the contents' own name, so the list
					// follows it without saying the name a second time.
					<nav aria-label={ wording.OnThisPage.In(lang) }>
						@tocList(v, lang)
					</nav>
				</div>
			</details>
		</div>
	}
}

// relatedAids closes the article with what stands beside the note and what the
// note is: the note to read beside it, the sources it declared, the notes
// declared on it, the notes whose text links here, what the check found in it,
// and its facts. They are what a reader who has finished looks for next, so they
// wait at the end of the text, at every width, in one block rather than between
// the title and the first sentence or in a column of their own, and the
// sidebar's last contents row leads down to them. Nothing in the block writes
// anywhere: the facts are the author's words, shown.
//
// The block is the target of that row, so it can be focused without being a stop
// of its own. A note with only facts has no row leading to it, and so no name to
// be led to by.
templ relatedAids(v NoteView, lang wording.Lang) {
	if v.endShown() || v.factsShown() {
		<div class="y-related" { v.endAttrs()... } lang={ lang.Tag() }>
			@pairOffer(v, lang)
			@basedOn(v, lang)
			@declaredByBlock(v, lang)
			@citedBy(v, lang)
			@diagnostics(v, lang)
			@noteFacts(v, lang)
		</div>
	}
}

// schemaNotices states what the schema made of this note's frontmatter, each
// sentence naming its own field. It lives in the reading column rather than the rail so the notice stays
// visible at every width; the rail is hidden on narrow viewports and dropped
// when a note has no reading aids.
templ schemaNotices(v NoteView, lang wording.Lang) {
	if len(v.SchemaNotices) > 0 {
		<div lang={ lang.Tag() }>
			for _, notice := range v.SchemaNotices {
				<p class="y-statuspanel__notice y-statusflag">
					@schemaParts(notice)
				</p>
			}
		</div>
	}
}

// frontmatterUnclosedNotice states that this note opened a frontmatter fence
// that never closes. It sits above the article whatever the vault governs,
// because the fact does not depend on a contract: the keys below it are shown as
// the prose they were read as, and without this nothing on the page says they
// were meant to be fields. It is its own block rather than a schema notice
// because the schema's verdict is absent from a vault with no contract.
templ frontmatterUnclosedNotice(v NoteView, lang wording.Lang) {
	if v.FrontmatterUnclosed {
		<div lang={ lang.Tag() }>
			<p class="y-statuspanel__notice y-statusflag">{ wording.FrontmatterNeverCloses.In(lang) }</p>
		</div>
	}
}

// fragmentSplit states how a link that named a section was read, for a link
// whose base name resolved to nothing. Its words say the missing half is the
// note, which is false of a link whose note was found and whose section was
// not, so the caller gates it on the kind rather than on a section name being
// present.
templ fragmentSplit(target, section string, lang wording.Lang) {
	<p class="y-diag__split">
		{ wording.LinkSplitBefore.In(lang) }<code>{ target }</code>{ wording.LinkSplitBetween.In(lang) }<code>{ section }</code>{ wording.LinkSplitAfter.In(lang) }
		{ fmt.Sprintf(wording.LinkMissingHalfIsTheNote.In(lang), target) }
	</p>
}

// diagnostics is the read-only diagnostics rail: the frontmatter diagnostic and
// every render diagnostic, stated but never repaired.
templ diagnostics(v NoteView, lang wording.Lang) {
	if v.Diagnostic != "" || len(v.RenderDiagnostics) > 0 {
		<section>
			<div class="ui-side__label y-diaghead">
				{ wording.NoteHealth.In(lang) }
				<span class="y-diagcount">{ strconv.Itoa(v.diagCount()) }</span>
			</div>
			<div class="y-diaglist">
				if v.Diagnostic != "" {
					<div class="y-diag">
						<div class="y-diag__label">frontmatter</div>
						<p class="y-diag__body">
							{{ summary, detail := wording.FrontmatterExplanation(lang, v.Diagnostic) }}
							@browserDiagnostic(summary, detail)
						</p>
					</div>
				}
				for _, d := range v.RenderDiagnostics {
					<div class="y-diag">
						<div class="y-diag__label">{ diagKindLabel(d.Kind, lang) }</div>
						<p class="y-diag__body">
							{ diagnosticSummary(&d, lang) }
							if d.Target != "" {
								<code class="y-diag__target">{ diagnosticAddress(&d) }</code>
							}
							if d.Message != "" {
								<code lang="en">{ d.Message }</code>
							}
						</p>
						if d.Kind == render.DiagWikilinkBroken && d.Section != "" {
							@fragmentSplit(d.Target, d.Section, lang)
						}
					</div>
				}
			</div>
		</section>
	}
}

// schemaParts keeps authored values and localized words separate while templ
// escapes both; a declaration is evidence rather than executable markup.
templ schemaParts(parts []wording.SchemaPart) {
	for _, part := range parts {
		if part.Code {
			<code>{ part.Text }</code>
		} else {
			{ part.Text }
		}
	}
}
