package pages

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/koopa0/yomihon/internal/drill"
	"github.com/koopa0/yomihon/internal/nav"
	"github.com/koopa0/yomihon/internal/render"
	"github.com/koopa0/yomihon/internal/snapshot"
	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// NoteView is everything the reading page needs. Diagnostic and
// RenderDiagnostics are display-only: yomihon reports what it found, and a
// human edits the file.
type NoteView struct {
	// NestedTitle places this note under a page heading rather than making
	// it the page heading itself. Its body must already occupy that level.
	NestedTitle bool
	Title       string
	RelPath     string
	// Language is what the note is written in, as the note declares it. The
	// language the page's own words are in arrives with the chrome, so one
	// page cannot hold two answers to it.
	Language string
	Type     string
	// Draft is whether the note declares itself unfinished, which the head
	// says in one quiet word and nothing else on the page acts on.
	Draft bool
	// Kind is what the note is to the vault besides a note, which the head
	// says beside its draft. The colophon's type and path already say it.
	Kind NoteKind
	// ObsidianHref is the obsidian://open URI for this note, already built
	// and escaped by ObsidianHref. Empty renders no editor link.
	ObsidianHref string
	// FilePath is the note's file as its full path, which the header offers to
	// copy for the reader's own editor. Empty where the vault has no path.
	FilePath   string
	Diagnostic string
	// Stale is set where the file could not be read while this page was built,
	// so the words below are the last ones read rather than the current ones.
	Stale bool
	// ParsePanic names a failed attempt to parse the current bytes, including
	// while this reading is retained before a stale generation is published.
	ParsePanic  bool
	ParseReason string
	// VerifiedOn is the day the author wrote down as the one they last checked
	// the note on, as the facts at its end print it, and VerifiedAt its
	// machine-readable value. It is their word, said as theirs. A note that
	// declares none shows no date: a blank is better than a claim, and the
	// file's own change time is the checkout's, not the author's.
	VerifiedOn string
	VerifiedAt string
	// Prerequisites are the notes the author named as ones to know first, in
	// the order they wrote them. A name that placed one note is a link; any
	// other stays the author's own text.
	Prerequisites []nav.NoteRef
	// TitleThoughts are the reader's own thoughts whose source is the note as
	// a whole, listed beside its title.
	TitleThoughts []ThoughtLine
	BodyHTML      string
	// TitleAnchor is the id the title carries, set where the renderer dropped a
	// duplicate opening heading, so a link written at that section still lands.
	// Empty where the note wrote no such heading: an anchor there would answer
	// for a section nobody wrote.
	TitleAnchor string

	RenderDiagnostics []render.Diagnostic
	// Prev and Next are the notes either side of this one in the sequence the
	// foot of the article offers. StepsLabel names that sequence — a course's
	// step onward, or folder adjacency — and is both the landmark's name and,
	// for a folder, the line printed above the steps; a course prints StepsPath
	// there instead. StepsCourse says which order arrived, which picks the step
	// words.
	Prev        nav.NoteRef
	Next        nav.NoteRef
	StepsLabel  string
	StepsCourse bool
	// StepsPath is the study path whose order the foot walks, printed as a link
	// to its contents. A side branch's lesson carries the ways off the branch,
	// StepsBack and StepsOnward or StepsToContents, and the lesson a branch hangs
	// from the branches themselves, StepsAsides. None of them is a step: they
	// are drawn beside Prev and Next and never in place of either.
	StepsPath       nav.NoteRef
	StepsBack       nav.NoteRef
	StepsOnward     nav.NoteRef
	StepsToContents bool
	StepsAsides     []nav.NoteRef
	// CitedBy are the notes whose text links here. An empty list draws nothing.
	CitedBy []nav.NoteRef
	// BasedOn are the sources this note declared in based_on, in declaration
	// order, grouped by file with the authored locations retained. An unresolved
	// name stays unlinked. An empty list hides the block — declaring
	// nothing is the default, not a finding.
	BasedOn []snapshot.DeclaredSource
	// DeclaredBy keeps each declaring note separate from places in this source.
	DeclaredBy []DeclaringNoteView
	// Pair is the one other note this one is offered to be read beside, or the
	// zero value where none is. The offer says the same words whichever way the
	// pair was found, so nothing here says which; two candidates at the same
	// footing are no offer at all, this surface never picking one of them.
	Pair nav.NoteRef
	TOC  []render.TOCEntry

	// IDPrefix is the id space this article occupies. It is empty on a page
	// showing one note, where every name inside the article is the note's own,
	// and names a column on a page showing two. The rendered body and the
	// contents entries arrive already named under it; this is what the names
	// the template writes go under, so one article's addresses and described
	// controls never reach into the other's.
	IDPrefix string

	// Sidebar is the column beside the note: the course that teaches it, the
	// index it is, or the folder it is in.
	Sidebar Sidebar

	// ContentIdentity is the hex identity of the source bytes this page
	// rendered, which the freshness watch and a kept place both bind to.
	ContentIdentity string
	// MarkAddress is where the control for keeping a reading place posts to.
	// Empty where this process keeps no marks, and the control is then absent
	// rather than offering a reader something with nowhere to go.
	MarkAddress string
	// VaultID is the id of the vault this note is in, which the browser keeps
	// the reader's place in it against, so that a vault later served from the
	// same address does not inherit a place kept in this one. Empty where the
	// page was made with none, and the note is then kept no place.
	VaultID string
	// rubyOn is whether the reader has readings switched on, which the page
	// learns from its chrome and the switch in its head must be drawn to match.
	rubyOn bool
	// vault is what the vault is called, which the row above the title starts
	// from, as a book's running head starts from the book. The page learns it
	// from its chrome; empty where the page was made with none.
	vault string
	// PlaceKept is whether the place the reader left off at is in this note.
	// The control for keeping one then says so, so a reader who comes back to
	// the note is told it already holds their place and not asked to guess.
	PlaceKept       bool
	QuestionAddress string
	ThoughtDoor     bool
	// TranscludedIdentity is the render's digest over what every embed here came
	// to — the excerpt pulled in, or the absence shown in its place — and is
	// empty where the page carries none. It rides the freshness watch beside
	// ContentIdentity, which covers the note's own bytes and no embedded source.
	TranscludedIdentity string
	// FrontmatterUnclosed is set where the note opened a frontmatter fence and
	// nothing closed it. Every reader took such a note for body text with no
	// block, and this is what says the block was meant: the page states the
	// fence never closes.
	FrontmatterUnclosed bool
	// SchemaNotices is what the schema said about this note's frontmatter, one
	// sentence per fault, already in the reader's language and already split
	// into the words and the note's own text they sit around.
	SchemaNotices []SchemaNotice

	// Concepts are the grammar-concept notes this lesson links to, each
	// pre-rendered for the concept sheet.
	Concepts []drill.ConceptDoc
}

// Note is the reading page: the article in the shared shell, with the
// navigation sidebar beside it, which carries the note's contents under the row
// that is the note. Everything it shows is either the note's own bytes rendered
// faithfully or a diagnostic about them; it repairs nothing.
templ Note(v NoteView, c layouts.Chrome) {
	{{ lang := c.Lang }}
	// The header carries the same control at the widths that have no rail, and
	// this is where it learns it may: only a reading page hands the chrome an
	// offer, so every other page's header has nothing to draw.
	{{ c.Mark = v.markOffer() }}
	{{ c.FilePath = v.FilePath }}
	// The browser keeps where the reader stopped in this note, against this
	// vault and this path, so the page says which note it is.
	{{ c.Reading = v.readingNote() }}
	// The header names the section being read and lists the others.
	{{ c.RunningHead = v.runningHead() }}
	{{ v.rubyOn = c.Ruby == "on" }}
	{{ v.vault = c.Vault }}
	{{ c.Diagrams = render.CarriesDiagrams(v.BodyHTML) }}
	@layouts.Base(c) {
		// The sheet owns an id outside the authored section namespace.
		@conceptSheet(v.Concepts, lang)
		<div class="y-nav-scrim" data-nav-close></div>
		<div class="y-shell">
			@sidebar(v.sidebarWithContents(), c)
			<main id="_y-main" tabindex="-1" class="y-main" { freshnessAttrs(&v, lang)... } { readAloudAttrs(v.BodyHTML, lang)... } data-preview-endpoint="/preview/">
				@noteArticle(v, lang)
			</main>
		</div>
		@previewCard()
	}
}

// noteArticle is one note as it reads: its head, whatever the schema said about
// it, the rendered body, the notes that stand beside it, and the colophon. It is
// a component rather than markup inside the page because a page
// showing two notes beside one another draws the same thing twice, and a second
// copy of this would be free to drift from the one a reader sees on the note's
// own page.
// A nested title and body occupy one level below their enclosing page heading.
templ noteArticle(v NoteView, lang wording.Lang) {
	<article class="y-article" { authoredLanguageAttrs(v.Language)... } { questionAttrs(&v, lang)... }>
		@articleHead(v, lang)
		@inlineAids(v, lang)
		@layouts.CodeCopy(lang)
		<div class="y-prose" data-section-numbers?={ v.numbersSections() }>
			if strings.TrimSpace(v.BodyHTML) == "" && !v.hasUnclosedComment() {
				@nothingToShow(nothingNotice{Kind: "note"}) {
					<p lang={ lang.Tag() }>{ wording.NoteEmptyBody.In(lang) }</p>
				}
			} else {
				@templ.Raw(v.BodyHTML)
			}
		</div>
		@relatedAids(v, lang)
		@colophon(v, lang)
	</article>
}

// conceptSheet is the grammar-concept drawer: one hidden <template> per concept
// the lesson links to, plus a shared native <dialog> the client clones into.
// With scripting off the triggers stay ordinary links to the concept notes.
//
// Opening it is the one overlay on this page that the markup cannot declare.
// The trigger is a link the renderer writes into the note's own prose, and the
// attributes that name an act belong to buttons; a button there would take
// that navigation away from a reader with no script, and it would be an empty
// sheet they opened, because the words in it are cloned from a template by the
// same script. Closing is another matter: the press says what it closes, and
// the browser closes it.
templ conceptSheet(concepts []drill.ConceptDoc, lang wording.Lang) {
	if len(concepts) > 0 {
		for _, c := range concepts {
			<template id={ "_y-concept-" + c.ID } data-title={ conceptSheetTitle(c.Title, lang) }>
				@templ.Raw(c.HTML)
			</template>
		}
		<dialog id="_y-concept-sheet" class="y-conceptsheet" data-concept-sheet aria-labelledby="_y-concept-title" closedby="any">
			<div class="y-conceptsheet__head">
				<h2 id="_y-concept-title" class="y-conceptsheet__title" data-concept-title></h2>
				<button type="button" class="y-iconbtn" command="close" commandfor="_y-concept-sheet" aria-label={ wording.CloseControl.In(lang) }>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
				</button>
			</div>
			@layouts.CodeCopy(lang)
			<div class="y-conceptsheet__body y-prose" data-concept-body></div>
		</dialog>
	}
}

// articleHead is the head of a note: where it is, its title, and the controls
// that act on the whole note, which follow the title after a space rather than
// a rule. The note's facts, the file it is and the way to its editor wait at the
// end of the text, where a reader who has finished looks for them.
//
// A title with thoughts of the reader's own about the note as a whole stands in
// a row with them, as a heading stands with its section's margin.
templ articleHead(v NoteView, lang wording.Lang) {
	<header class="y-frontis">
		@noteWhere(v, lang)
		if len(v.TitleThoughts) > 0 {
			<div class="y-sect y-sect--title">
				@noteTitle(v)
				@titleMargin(v.TitleThoughts, lang)
			</div>
		} else {
			@noteTitle(v)
		}
		@headNotes(v, lang)
		@noteTools(v, lang)
		if v.carriesRibbon() {
			@bookmarkRibbon()
		}
	</header>
}

// bookmarkRibbon is the bookmark as a picture: a silk ribbon hanging from the
// header's lower edge over the text's right edge, there while this note holds
// the place the reader kept and drawn back up out of sight while it does not.
// It is a picture of state and nothing else. The header's control is the one
// thing that keeps a place and says so to a screen reader, so the ribbon is
// hidden from assistive technology and answers no pointer. It carries no state
// of its own either: the stylesheet reads whether the header's control says
// the place is here, which the server writes on the first byte and the script
// keeps true as the reader keeps a place or the place moves away, so the two
// cannot disagree.
templ bookmarkRibbon() {
	<span class="y-ribbon" aria-hidden="true">
		<svg class="y-ribbon__cloth" width="15" height="42" viewBox="0 0 15 42" focusable="false">
			<path class="y-ribbon__face" d="M0 0H15V42L7.5 34.5L0 42Z"></path>
			<path class="y-ribbon__edge" d="M2 0V38M13 0V38"></path>
		</svg>
	</span>
}

// noteWhere is the row above the title that says where the note is: the vault,
// then the folders it lies in or the course a unit belongs to, each a link. What
// the note is besides a note, an index, a course or a report, and that it is a
// draft, are said at its end. A note on a page holding two notes has no place
// to name, the page naming each column, but still says what it is.
templ noteWhere(v NoteView, lang wording.Lang) {
	{{ standings := v.standings(lang) }}
	if len(standings) > 0 || (!v.NestedTitle && v.whereShown()) {
		<p class="y-notewhere" lang={ lang.Tag() }>
			if v.NestedTitle {
				// The page names the column's note itself.
			} else {
				if v.vault != "" {
					<a href="/">{ v.vault }</a>
				}
				if v.StepsCourse && v.StepsPath.RelPath != "" {
					if v.vault != "" {
						<span aria-hidden="true">›</span>
					}
					<a href={ templ.URL(courseHrefFrom(v.StepsPath.RelPath, v.RelPath)) } { authoredLanguageAttrs(v.StepsPath.Language)... }>{ v.StepsPath.Name }</a>
				} else {
					for i, folder := range v.folders() {
						if i > 0 || v.vault != "" {
							<span aria-hidden="true">›</span>
						}
						<a href={ templ.URL(folderHref(folder.Path)) }>{ folder.Name }</a>
					}
				}
			}
			for _, st := range standings {
				@standingMark(st)
			}
		</p>
	}
}

// standingMark is one word the note's head ends on: the pictogram the
// interface draws that kind with, then the word.
templ standingMark(st standing) {
	if st.Draft {
		<span class="y-notewhere__draft" data-note-draft>
			@layouts.Icon(st.Icon)
			{ st.Word }
		</span>
	} else {
		<span class="y-notewhere__kind" data-note-kind>
			@layouts.Icon(st.Icon)
			{ st.Word }
		</span>
	}
}

// noteTools is the row of controls under the title that act on the whole note:
// reading it aloud, where it marks paragraphs to be read, and showing the
// readings over Japanese text, where it has some. Neither is offered to a note
// that has nothing for it to act on.
templ noteTools(v NoteView, lang wording.Lang) {
	if !v.NestedTitle && (v.readsAloud() || v.carriesReadings()) {
		<div class="y-notetools" lang={ lang.Tag() }>
			if v.readsAloud() {
				<button class="y-toolbtn" type="button" data-readaloud-play aria-pressed="false">
					@layouts.Icon("play")
					<span>{ wording.ReadAloudPlayAll.In(lang) }</span>
				</button>
			}
			if v.carriesReadings() {
				@readingsSwitch(v.rubyOn, lang)
			}
		</div>
	}
}

// readingsSwitch shows and hides the readings over Japanese text. The setting is
// one cookie for the whole site, so a reader who switched readings off on one
// note finds them off on the next; preferences.js flips the root's data-ruby and
// the cookie, and the button's pressed state is the one thing that says which
// way it is set.
templ readingsSwitch(on bool, lang wording.Lang) {
	<button class="y-toolbtn" type="button" data-ruby-toggle aria-pressed={ strconv.FormatBool(on) }>
		@layouts.Icon("ruby")
		<span>{ wording.FuriganaLabel.In(lang) }</span>
	</button>
}

// readingsTools is the toolbar of a page that has readings to show and nothing
// else to put in one.
templ readingsTools(on bool, lang wording.Lang) {
	<div class="y-notetools" lang={ lang.Tag() }>
		@readingsSwitch(on, lang)
	</div>
}

// noteTitle is the heading itself. A jump has to land on the words it named, so
// the anchor goes on the visible heading rather than a hidden marker beside it.
templ noteTitle(v NoteView) {
	if v.NestedTitle {
		if v.TitleAnchor != "" {
			<h2 id={ v.TitleAnchor } class="y-title">{ v.Title }</h2>
		} else {
			<h2 class="y-title">{ v.Title }</h2>
		}
	} else if v.TitleAnchor != "" {
		<h1 id={ v.TitleAnchor } class="y-title">{ v.Title }</h1>
	} else {
		<h1 class="y-title">{ v.Title }</h1>
	}
}

// colophon is where a note ends, as a book ends on its colophon: a rule, a
// small seal, the way on to the note before and after this one, and a foot that
// says what the file is and offers the two doors out of the page. It closes
// every note, whatever stands above it, so a reader always finds the end in the
// same place and the same shape.
//
// The seal is a picture and nothing else. The way on is the one place a page
// offers a previous and a next, whether the order is a course's or the folder's.
// The foot holds nothing the header already does: the header copies the file's
// full path and leads home, to the marks and to the settings, and the foot
// prints the path within the vault, which opens the file as it is on disk.
templ colophon(v NoteView, lang wording.Lang) {
	if v.colophonShown() {
		<footer class="y-colophon" lang={ lang.Tag() }>
			<span class="y-colophon__seal" aria-hidden="true">
				<span class="y-colophon__rule"></span>
				@layouts.Icon("bookmark")
				<span class="y-colophon__rule"></span>
			</span>
			@sequenceSteps(v, lang)
			@colophonFoot(v, lang)
		</footer>
	}
}

// colophonFoot is the foot of the colophon: the note's facts on the left, read
// as a description list, and the doors out of the page on the right.
//
// Every term carries the interface's language and every value the note's own:
// a type, a BCP 47 tag and a path are the contract's own spelling, never
// translated, so only the label beside each is. The path needs no label on the
// page, its shape says what it is, so its term is there for a screen reader
// alone.
//
// The day is the author's: the one they wrote as the day they checked the note,
// never the file's change time, which a checkout stamps on every file at once. A
// note that wrote none shows no day.
templ colophonFoot(v NoteView, lang wording.Lang) {
	if v.factRows() || v.ObsidianHref != "" || v.ThoughtDoor {
		<div class="y-colophon__foot">
			if v.factRows() {
				<dl class="y-colophon__facts">
					if v.RelPath != "" {
						<div>
							<dt class="y-offscreen">{ wording.RawFile.In(lang) }</dt>
							<dd><a class="y-colophon__path" href={ templ.URL(rawHref(v.RelPath)) }>{ v.RelPath }</a></dd>
						</div>
					}
					if v.Type != "" {
						<div>
							<dt>{ wording.FileType.In(lang) }</dt>
							<dd>{ v.Type }</dd>
						</div>
					}
					// A note that declared no lang shows no fact for one: the absence
					// is the answer, not a blank waiting to be filled in.
					if v.Language != "" {
						<div>
							<dt>{ wording.NoteLanguage.In(lang) }</dt>
							<dd>{ v.Language }</dd>
						</div>
					}
					if v.VerifiedOn != "" {
						<div>
							<dt>{ wording.VerifiedOn.In(lang) }</dt>
							<dd><time datetime={ v.VerifiedAt }>{ v.VerifiedOn }</time></dd>
						</div>
					}
				</dl>
			}
			if v.ObsidianHref != "" || v.ThoughtDoor {
				<p class="y-colophon__doors">
					@obsidianDoor(v, lang)
					@thoughtDoor(v, lang)
				</p>
			}
		</div>
	}
}

// prerequisites are the notes the author named as ones to know first, in the
// order they wrote them. A name that placed one note is a link; any other stays
// the author's own text.
templ prerequisites(v NoteView, lang wording.Lang) {
	if len(v.Prerequisites) > 0 {
		<nav class="y-prereq" aria-label={ wording.Prerequisites.In(lang) }>
			<div class="ui-side__label">{ wording.Prerequisites.In(lang) }</div>
			<ul class="y-related__list" role="list">
				for _, ref := range v.Prerequisites {
					<li>
						if ref.RelPath != "" {
							<a class="ui-navitem" href={ templ.URL(notesHref(ref.RelPath)) } { authoredLanguageAttrs(ref.Language)... }>{ ref.Name }</a>
						} else {
							<span class="ui-navitem">{ ref.Name }</span>
						}
					</li>
				}
			</ul>
		</nav>
	}
}

// obsidianDoor is the way to where a repair actually happens. It is not a fact
// about the note, so it stands with the doors at the foot rather than among
// the facts: every repair yomihon's diagnostics report is a hand edit, and this is
// the page's one door to where that edit is made. The href is already built and
// escaped server-side, so it bypasses the sanitizer that would reject its custom
// scheme.
templ obsidianDoor(v NoteView, lang wording.Lang) {
	if v.ObsidianHref != "" {
		<a class="y-colophon__door" lang={ lang.Tag() } href={ templ.SafeURL(v.ObsidianHref) }>{ wording.OpenInObsidian.In(lang) }</a>
	}
}

// thoughtDoor is the page-level way to leave a thought about the note as a
// whole. It stands beside the Obsidian door, in the same quiet style, so it reads
// as something the reader can do with the note rather than as a stray line of the
// article. A section has its own beside its heading.
templ thoughtDoor(v NoteView, lang wording.Lang) {
	if v.ThoughtDoor {
		<a class="y-colophon__door" lang={ lang.Tag() } href={ templ.URL(thoughtHref(v.RelPath, "")) } aria-label={ fmt.Sprintf(wording.ThoughtSectionFmt.In(lang), v.Title) }>{ wording.ThoughtDoor.In(lang) }</a>
	}
}

// pairOffer is the way to the page that holds this note and one other at once.
// It is absent where no other note belongs beside this one, which is the
// ordinary case: a note with no translation and no declared source has no pair
// to offer, and a block saying so on every page would be furniture.
//
// The link reads as what following it does. The partner's own name is the link
// text and carries whatever language that note declared, since a translation's
// title is written in the language it was translated into.
templ pairOffer(v NoteView, lang wording.Lang) {
	if v.Pair.RelPath != "" {
		<nav class="y-pair" aria-label={ wording.CompareOfferNav.In(lang) }>
			<div class="ui-side__label">{ wording.CompareOffer.In(lang) }</div>
			<a class="ui-navitem" href={ templ.URL(compareHref(v.RelPath, v.Pair.RelPath)) } { authoredLanguageAttrs(v.Pair.Language)... }>{ v.Pair.Name }</a>
		</nav>
	}
}

// basedOn lists the sources this note declared in based_on. It is absent when
// the note declared none: that is the default, not a finding. A unique
// resolution is a title and a link; an unresolved or ambiguous value is the
// author's own text, never a guessed address.
templ basedOn(v NoteView, lang wording.Lang) {
	if len(v.BasedOn) > 0 {
		@basedOnBlock(v, lang)
	}
}

templ basedOnBlock(v NoteView, lang wording.Lang) {
	<nav class="y-basedon" aria-label={ wording.BasedOnNav.In(lang) }>
		<div class="ui-side__label">
			{ wording.BasedOn.In(lang) }
			<span class="ui-navitem__count">{ strconv.Itoa(len(v.BasedOn)) }</span>
		</div>
		<ul class="y-basedon__groups">
			for _, ref := range v.BasedOn {
				<li>
					if ref.RelPath == "" {
						<span class="ui-navitem">{ ref.Name }</span>
					} else if len(ref.Locations) == 1 && !ref.WholeFile {
						@sourceLocation(ref.RelPath, ref.Name+" › ", ref.Locations[0])
					} else {
						<a class="ui-navitem" href={ templ.URL(notesHref(ref.RelPath)) }>{ ref.Name }</a>
						if len(ref.Locations) > 0 {
							<ul class="y-basedon__locations">
								for _, location := range ref.Locations {
									<li>
										@sourceLocation(ref.RelPath, "", location)
									</li>
								}
							</ul>
						}
					}
				</li>
			}
		</ul>
	</nav>
}

// sourceLocation keeps missing-place information visible at the point of choice.
templ sourceLocation(relPath, prefix string, location render.SourceLocation) {
	<a class={ "ui-navitem", templ.KV("wikilink-broken wikilink-degraded", location.Reason != "") } href={ templ.URL(sourceLocationHref(relPath, location.Fragment)) } title={ location.Reason }>
		<span>
			{ prefix + location.Label }
			if location.Reason != "" {
				<span class="y-basedon__reason">{ location.Reason }</span>
			}
		</span>
	</a>
}

// citedBy lists the notes whose text links to this one. A note nothing links
// to draws no block: the end shows what stands beside the note, and an empty
// list there is a line the reader reads to learn nothing.
templ citedBy(v NoteView, lang wording.Lang) {
	if v.citedByShown() {
		<nav class="y-citedby" aria-label={ wording.CitedByNav.In(lang) }>
			<div class="ui-side__label">
				{ wording.CitedBy.In(lang) }
				<span class="ui-navitem__count">{ strconv.Itoa(len(v.CitedBy)) }</span>
			</div>
			<ul class="y-related__list" role="list">
				for _, ref := range v.CitedBy {
					<li><a class="ui-navitem" href={ templ.URL(notesHref(ref.RelPath)) }>{ ref.Name }</a></li>
				}
			</ul>
		</nav>
	}
}

// sequenceSteps is the way on, in the colophon: the note before this one on
// the left and the note after it on the right, each a small label over its
// title. It is the only previous and next the page draws, whichever order
// arrived: a course's declared order, or the files either side of this one in
// its folder. The step words say which, so the arrow never claims an order it is
// not walking: a course steps by unit and a folder by file, because the two can
// disagree completely. A course also prints its own title over the steps, as a
// link to its contents, which is the way off the foot the book offers wherever
// the reader is.
//
// The landmark is named for the order. A course's is named with the step onward
// from this note rather than with the course's title, on purpose: the sidebar
// already carries a landmark named for the course's order, and a second
// landmark with the same words as the link inside it would be one name heard
// twice.
//
// The step words belong to the interface, and the titles to the notes they lead
// to, each carrying whatever language that note declared and none where it
// declared nothing.
templ sequenceSteps(v NoteView, lang wording.Lang) {
	if v.hasSteps() {
		<nav class={ "y-steps", templ.KV("y-steps--course", v.StepsCourse) } aria-label={ v.StepsLabel }>
			if v.StepsCourse && v.StepsPath.RelPath != "" {
				<p class="y-steps__source"><a class="y-steps__path" href={ templ.URL(courseHrefFrom(v.StepsPath.RelPath, v.RelPath)) } { authoredLanguageAttrs(v.StepsPath.Language)... }>{ v.StepsPath.Name }</a></p>
			}
			// The left place is the step back, or on a side branch's first
			// lesson, which has none, the way back to the lesson it hangs
			// from. The right is the step on, or on its last lesson the way
			// on to the main line or back to the contents. A lesson is never
			// both a branch's first and a main-line lesson with a step back,
			// so the two never compete.
			if v.Prev.RelPath != "" {
				@stepBack("", notesHref(v.Prev.RelPath), "prev", stepWordPrev(v.StepsCourse, lang), v.Prev)
			} else if v.StepsBack.RelPath != "" {
				@stepBack("y-steps__link--back", notesHref(v.StepsBack.RelPath), "", wording.BranchBackTo.In(lang), v.StepsBack)
			}
			if v.Next.RelPath != "" {
				@stepOn("", notesHref(v.Next.RelPath), "next", stepWordNext(v.StepsCourse, lang), v.Next)
			} else if v.StepsOnward.RelPath != "" {
				@stepOn("y-steps__link--onward", notesHref(v.StepsOnward.RelPath), "", wording.BranchOnward.In(lang), v.StepsOnward)
			} else if v.StepsToContents && v.StepsPath.RelPath != "" {
				@stepOn("y-steps__link--onward", courseHrefFrom(v.StepsPath.RelPath, v.RelPath), "", wording.BranchToContents.In(lang), v.StepsPath)
			}
			// The branches hanging from this lesson, as one quiet line each,
			// under the steps. They are beside the steps and not among them:
			// the next lesson is still the main line's.
			for _, aside := range v.StepsAsides {
				<p class="y-steps__aside">
					<span class="y-steps__asidelabel">{ wording.BranchPrefix.In(lang) }</span><a class="y-steps__asidelink" href={ templ.URL(notesHref(aside.RelPath)) } { authoredLanguageAttrs(aside.Language)... }>{ aside.Name }</a>
				</p>
			}
		</nav>
	}
}

// stepBack and stepOn are the two sides of the way on: the step's word, small,
// over the title of the note it leads to, with the arrow on the title's outer
// side. class is the link's modifiers, and rel the relation a step in the order
// has, which the ways off a side branch do not.
templ stepBack(class, href, rel, word string, to nav.NoteRef) {
	<a class={ "y-steps__link y-steps__link--prev", templ.KV(class, class != "") } href={ templ.URL(href) } { stepRel(rel)... }>
		<span class="y-steps__role">{ word }</span>
		<span class="y-steps__name" { authoredLanguageAttrs(to.Language)... }><span class="y-steps__dir" aria-hidden="true">←</span> { to.Name }</span>
	</a>
}

templ stepOn(class, href, rel, word string, to nav.NoteRef) {
	<a class={ "y-steps__link y-steps__link--next", templ.KV(class, class != "") } href={ templ.URL(href) } { stepRel(rel)... }>
		<span class="y-steps__role">{ word }</span>
		<span class="y-steps__name" { authoredLanguageAttrs(to.Language)... }>{ to.Name } <span class="y-steps__dir" aria-hidden="true">→</span></span>
	</a>
}

// tocList is the table-of-contents link list: the sidebar draws it under the
// row that is the note, and a column of a page holding two notes, which has no
// sidebar to carry it, draws it in its folded row. Both are this one list, so
// the two surfaces read as one.
//
// Every heading is the note's own text, so the list carries its language. It
// needs saying on the list because neither copy would otherwise inherit the right answer:
// the folded one sits inside a block that declares the language the interface
// speaks, and the sidebar one sits outside the article entirely, where the
// document's language is all there is. A note that declared no language stamps
// nothing here either, and both copies inherit the same page language the
// article does.
//
// The last row, where the note has an end block, leads down to it. It is named
// with the end block's own first heading, so the row and what it leads to say
// the same words.
templ tocList(v NoteView, lang wording.Lang) {
	<div class="y-toc__list" { authoredLanguageAttrs(v.Language)... }>
		for _, h := range v.TOC {
			<div class="y-toc__row">
				<a href={ templ.URL("#" + h.ID) } data-level={ strconv.Itoa(h.Level) }>{ h.Text }</a>
			</div>
		}
		if v.endShown() {
			<div class="y-toc__row y-toc__row--end">
				<a href={ templ.URL("#" + v.endID()) } lang={ lang.Tag() } data-level="2">{ v.endLabel(lang) }</a>
			</div>
		}
	</div>
}

// inlineAids is the folded contents row of a note that stands in a column of a
// page holding two. Such a column has no sidebar beside it, and the contents
// are what a reader reaches for before reading; every other aid waits at the
// end of the text, in the same block a note's own page ends on.
templ inlineAids(v NoteView, lang wording.Lang) {
	if v.NestedTitle && len(v.TOC) > 0 {
		<div class="y-inlineaids" lang={ lang.Tag() }>
			<details class="y-toc-inline">
				<summary class="y-toc-inline__summary">
					@chevron()
					<span class="y-toc-inline__parts">
						<span class="y-toc-inline__part">{ wording.OnThisPage.In(lang) }</span>
					</span>
				</summary>
				<div class="y-toc-inline__body">
					// The summary opens on the contents' own name, so the list
					// follows it without saying the name a second time.
					<nav aria-label={ wording.OnThisPage.In(lang) }>
						@tocList(v, lang)
					</nav>
				</div>
			</details>
		</div>
	}
}

// relatedAids is what stands beside the note, between its last words and its
// colophon: the note to read beside it, the notes to know first, the sources it
// declared, the notes declared on it, the notes whose text links here, and last
// what the check found in it, nearest the foot that opens the file where a
// repair is made. Each is a quiet label beside its list, and a list with nothing
// in it is not drawn, so a note with none of them goes from its text straight to
// its colophon. Nothing in the block writes anywhere.
//
// The block is the target of the sidebar's last contents row, so it can be
// focused without being a stop of its own.
templ relatedAids(v NoteView, lang wording.Lang) {
	if v.endShown() {
		<div class="y-related" { v.endAttrs()... } lang={ lang.Tag() }>
			@pairOffer(v, lang)
			@prerequisites(v, lang)
			@basedOn(v, lang)
			@declaredByBlock(v, lang)
			@citedBy(v, lang)
			@diagnostics(v, lang)
		</div>
	}
}

// headNotes is what the page says about the file rather than reads from it,
// under the title and above the double rule that opens the text: that the
// words below are a reading kept from before, that a frontmatter fence never
// closes, and what the schema made of the frontmatter. Each is one sentence led
// by the hollow warning triangle in the diagnostics' ochre, in the interface's
// small face, with no box and no tint: the note still reads in full below it,
// so nothing here is an alarm, and it stays where the reader arrives, at every
// width, until the file says otherwise.
//
// A field whose values the rules list folds that list under its sentence,
// closed, so a type the rules do not know is one line in the head and the
// vocabulary is one press away.
//
// The unclosed fence is said whatever the vault governs, because the fact does
// not depend on a contract: the keys below it are shown as the prose they were
// read as, and without this nothing on the page says they were meant to be
// fields.
templ headNotes(v NoteView, lang wording.Lang) {
	if v.headNoted() {
		<div class="y-headnotes" lang={ lang.Tag() }>
			if v.ParsePanic {
				@headNote(templ.Attributes{"data-note-stale": true}) {
					{ wording.NoteParseStale.In(lang) } <code lang="en">{ v.ParseReason }</code>
				}
			} else if v.Stale {
				@headNote(templ.Attributes{"data-note-stale": true}) {
					{ wording.NoteStale.In(lang) }
				}
			}
			if v.FrontmatterUnclosed {
				@headNote(templ.Attributes{"data-frontmatter-unclosed": true}) {
					{ wording.FrontmatterNeverCloses.In(lang) }
				}
			}
			for _, notice := range v.SchemaNotices {
				@headNote(templ.Attributes{"data-schema-notice": true}) {
					@schemaParts(notice.Says)
				}
				if notice.Known != nil {
					<details class="y-headnote__known">
						<summary>
							@schemaParts(wording.AllowedEnumHeading(lang, notice.Field))
							@chevron()
						</summary>
						<p>
							@schemaParts(wording.AllowedEnumList(lang, notice.Known))
						</p>
					</details>
				}
			}
		</div>
	}
}

// headNote is one of the head's notes: the triangle, then the sentence.
templ headNote(attrs templ.Attributes) {
	<p class="y-headnote" { attrs... }>
		@layouts.Icon("warning")
		<span>
			{ children... }
		</span>
	</p>
}

// fragmentSplit states how a link that named a section was read, for a link
// whose base name resolved to nothing. Its words say the missing half is the
// note, which is false of a link whose note was found and whose section was
// not, so the caller gates it on the kind rather than on a section name being
// present.
templ fragmentSplit(target, section string, lang wording.Lang) {
	<p class="y-diag__split">
		{ wording.LinkSplitBefore.In(lang) }<code>{ target }</code>{ wording.LinkSplitBetween.In(lang) }<code>{ section }</code>{ wording.LinkSplitAfter.In(lang) }
		{ fmt.Sprintf(wording.LinkMissingHalfIsTheNote.In(lang), target) }
	</p>
}

// diagnostics is what the check found in the note: the frontmatter diagnostic
// and every render diagnostic, stated but never repaired. They are the author's
// to act on, so they say what is wrong plainly and in order, each finding on a
// quiet rule in the warning's ochre; nothing about them is an alarm, since the
// note still reads.
templ diagnostics(v NoteView, lang wording.Lang) {
	if v.Diagnostic != "" || len(v.RenderDiagnostics) > 0 {
		<section>
			<div class="ui-side__label y-diaghead">
				{ wording.NoteHealth.In(lang) }
				<span class="y-diagcount">{ strconv.Itoa(v.diagCount()) }</span>
			</div>
			<div class="y-diaglist">
				if v.Diagnostic != "" {
					<div class="y-diag">
						<div class="y-diag__label">frontmatter</div>
						<p class="y-diag__body">
							{{ summary, detail := wording.FrontmatterExplanation(lang, v.Diagnostic) }}
							@browserDiagnostic(summary, detail)
						</p>
					</div>
				}
				for _, d := range v.RenderDiagnostics {
					<div class="y-diag">
						<div class="y-diag__label">{ diagKindLabel(d.Kind, lang) }</div>
						<p class="y-diag__body">
							{ diagnosticSummary(&d, lang) }
							if d.Target != "" {
								<code class="y-diag__target">{ diagnosticAddress(&d) }</code>
							}
							if d.Message != "" {
								<code lang="en">{ d.Message }</code>
							}
						</p>
						if d.Kind == render.DiagWikilinkBroken && d.Section != "" {
							@fragmentSplit(d.Target, d.Section, lang)
						}
					</div>
				}
			</div>
		</section>
	}
}

// schemaParts keeps authored values and localized words separate while templ
// escapes both; a declaration is evidence rather than executable markup.
templ schemaParts(parts []wording.SchemaPart) {
	for _, part := range parts {
		if part.Code {
			<code>{ part.Text }</code>
		} else {
			{ part.Text }
		}
	}
}
