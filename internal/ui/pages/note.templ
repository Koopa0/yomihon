package pages

import (
	"strconv"

	"github.com/koopa0/yomihon/internal/lesson"
	"github.com/koopa0/yomihon/internal/nav"
	"github.com/koopa0/yomihon/internal/render"
	"github.com/koopa0/yomihon/internal/sequence"
	"github.com/koopa0/yomihon/internal/ui/layouts"
)

const nonInstanceReason = "不屬於生命週期治理範圍"

// diagKindLabel names a rendering diagnostic in the reader's language. A kind
// without a name here arrives as its raw slug rather than a dead page: the
// diagnostics exist to report trouble, and the panel failing on an unnamed
// kind would be the reporter breaking on the news.
func diagKindLabel(kind render.DiagnosticKind) string {
	switch kind {
	case render.DiagWikilinkBroken:
		return "連結沒有目標"
	case render.DiagWikilinkAmbiguous:
		return "連結有多個目標"
	case render.DiagUnknownCallout:
		return "沒見過的提示框類型"
	case render.DiagRiskyFence:
		return "程式碼區塊裡的筆記語法"
	case render.DiagEmbedFragmentMissing:
		return "找不到嵌入指定的段落"
	default:
		return string(kind)
	}
}

func articleLanguage(tag string) string {
	if tag == "" {
		return "und"
	}
	return tag
}

// NoteView is everything the reading page needs. Diagnostic (frontmatter YAML)
// and RenderDiagnostics (dialect passes) are both display-only: yomihon reports
// what it found, and a human edits the file.
//
// Transitions, WriteDiagnostic, NonInstance, and NoFrontmatter drive the rail
// status panel and responsive seal bar, the reading page's two status faces.
// SealTarget and Sealed carry the schema-owned seal semantics into both.
// JustSealed / SealedHash are meaningful only when Sealed is true.
type NoteView struct {
	Title      string
	RelPath    string
	Language   string
	Type       string
	Status     string
	SealTarget string
	Sealed     bool
	Diagnostic string
	// Unsearchable is set for a note too large to hold in the index. It renders
	// like any other; a reader who later searches for a phrase in it would be
	// told there are no results, which would be untrue of the folder.
	Unsearchable bool
	BodyHTML     string
	// TitleAnchor is the id the title carries, set when the note opened with a
	// heading saying the same thing and the renderer dropped it as a
	// duplicate. A link may be written at that section, and the title is where
	// its words now live. Empty when the note wrote no such heading — the
	// title is then a page's name rather than a place in the document, and
	// giving it an anchor would answer for a section nobody wrote.
	TitleAnchor string

	RenderDiagnostics []render.Diagnostic
	// Prev and Next are the notes either side of this one in the sequence the
	// foot of the article offers, so a reader walking it — a month of entries,
	// a course of lessons — can take the next step from where they are reading
	// rather than from the rail. StepsLabel names that sequence, printed and
	// spoken alike; StepsCourse says whether it is a course's declared order
	// rather than folder adjacency, which picks the step words.
	Prev        nav.NoteRef
	Next        nav.NoteRef
	StepsLabel  string
	StepsCourse bool
	// VaultHasLinks says some note in this folder cites another. Where nothing
	// does — a folder of dated entries, a shelf of transcripts — an empty
	// cited-by block on every page is furniture: a reader of three years of
	// diary entries met the same "nothing cites this" seven hundred times, and
	// it was true every time and told her nothing. Where the folder does use
	// links, an empty block is a finding and stays.
	VaultHasLinks bool
	// CitedBy are the notes whose text links here. It is the resolver's own
	// knowledge read backwards, and the reading face's answer to the question a
	// reader standing on a note actually has: who depends on this. An empty
	// list is an answer — the note is an island — so the block states that
	// rather than disappearing.
	CitedBy []nav.NoteRef
	TOC     []render.TOCEntry

	// Sidebar is the resolved left navigation for this page: the whole-vault
	// model plus this note's wayfinding context — its same-directory siblings,
	// map and folder branches to open, and the entry to mark.
	Sidebar Sidebar

	// Governed says whether anything claimed authority over this vault. Both
	// status faces are absent when it is false: a folder with no contract has no
	// lifecycle, and a panel announcing that is an apology for a fault that does
	// not exist. Every other field below is meaningful only under it.
	Governed bool

	Transitions     []string
	NonInstance     bool
	WriteDiagnostic string
	NoFrontmatter   bool
	// WithheldByOwner is meaningful only when Transitions is empty: the
	// contract defines onward transitions from this note's status, but every
	// one of them belongs to another owner. The panel then names the owner
	// boundary instead of claiming the schema defines nothing.
	WithheldByOwner bool

	// WriteBlock is the reason a transition would be refused right now — an
	// uncommitted edit to this note, or an unreadable working tree. Empty means
	// nothing is known to stand in the way. The controls stay visible either
	// way: the reason is advisory, and the operator can clear it and reload.
	//
	// WriteBlockHeadline and WriteBlockNextStep are the same refusal's title and
	// clearing step where it has them. The headline is what a control carries as
	// its accessible name, so a reason long enough to explain itself in the
	// paragraph does not have to be read out before the control's own purpose.
	WriteBlock         string
	WriteBlockHeadline string
	WriteBlockNextStep string

	// JustSealed is set from a one-shot ?sealed=1 PRG signal; SealedHash is the
	// read-only git short hash of the sealing commit. Both apply only to a sealed
	// note.
	JustSealed bool
	SealedHash string

	// Concepts are the grammar-concept notes this lesson links to, each
	// pre-rendered for the in-app concept sheet. Empty for a non-lesson note or a
	// lesson that references none.
	Concepts []lesson.ConceptDoc
}

// diagCount is the diagnostics rail's badge number: the frontmatter diagnostic
// (0 or 1) plus every render diagnostic.
func (v NoteView) diagCount() int {
	n := len(v.RenderDiagnostics)
	if v.Diagnostic != "" {
		n++
	}
	return n
}

// hasAids reports whether this note carries reading aids — a table of
// contents or any diagnostic. The right rail exists to hold reading aids:
// when a note has none, the rail's column is dropped entirely and the write
// face appears in the fixed-bottom seal bar instead, so the reader never
// sits beside a tall gutter holding a lone status card.
func (v NoteView) hasAids() bool {
	return len(v.TOC) > 0 || v.Diagnostic != "" || len(v.RenderDiagnostics) > 0 || v.citedByShown()
}

// citedByShown reports whether the answer about what links here means anything
// on this page — either there are citations, or the library has links at all
// and their absence is itself the finding. Counting it among the aids matters
// twice: a rail holding only this block is not an empty rail, and the narrow
// projection has to carry it. Left out of both, a note whose sole aid was its
// backlinks lost them at every width, not only the narrow ones.
func (v NoteView) citedByShown() bool {
	return len(v.CitedBy) > 0 || v.VaultHasLinks
}

// breadcrumb is the reading crumb: the note's directory segments (the filename
// dropped), e.g. "Writing/lessons/japanese/L20.md" → [Writing lessons japanese].
templ Note(v NoteView, c layouts.Chrome) {
	@layouts.Base(c) {
		<div class="y-nav-scrim" data-nav-close></div>
		<div class={ "y-shell", templ.KV("y-shell--rail-empty", !v.hasAids()) }>
			@sidebar(v.Sidebar, c.Nonce)
			<main id="main-content" tabindex="-1" class="y-main">
				<article class="y-article" lang={ articleLanguage(v.Language) }>
					@articleHead(v)
					@inlineAids(v)
					<div class="y-prose">
						@templ.Raw(v.BodyHTML)
					</div>
					@sequenceSteps(v)
				</article>
			</main>
			@rightRail(v)
		</div>
		@sealBar(v)
		@sealToast(v)
		@conceptSheet(v.Concepts)
	}
}

// sealToast is the one-shot seal confirmation: server-rendered from the same
// redirect signal that plays the chip's settle pulse, it enters from its
// first-frame style and fades itself away — pure CSS, so it plays with or
// without the enhancement script (the script's only role is stripping the
// query parameter so a manual refresh does not replay it; a reload of the
// sealed URL replaying it is accepted for a single-operator local tool).
templ sealToast(v NoteView) {
	if v.JustSealed {
		<div class="y-toast" role="status">済 · 已鈐印 { v.SealTarget }</div>
	}
}

// conceptSheet is the in-app grammar-concept drawer: one hidden <template> of
// rendered content per concept the lesson links to, plus a single shared native
// <dialog>. lesson.js clones the matching template into the dialog on a trigger
// click and calls showModal(); with JS off the triggers stay ordinary links to
// the concept notes, so nothing here renders unless a concept is referenced.
templ conceptSheet(concepts []lesson.ConceptDoc) {
	if len(concepts) > 0 {
		for _, c := range concepts {
			<template id={ "concept-" + c.ID } data-title={ c.Title }>
				@templ.Raw(c.HTML)
			</template>
		}
		<dialog class="y-conceptsheet" data-concept-sheet aria-label="文法筆記" closedby="any">
			<div class="y-conceptsheet__head">
				<span class="y-conceptsheet__title" data-concept-title></span>
				<button type="button" class="y-iconbtn" data-concept-close aria-label="關閉">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
				</button>
			</div>
			<div class="y-conceptsheet__body y-prose" data-concept-body></div>
		</dialog>
	}
}

// articleHead is the breadcrumb + title + type meta + the kintsugi seam above
// the rendered body.
templ articleHead(v NoteView) {
	if crumbs := Breadcrumb(v.RelPath); len(crumbs) > 0 {
		<div class="y-crumbs">
			for i, seg := range crumbs {
				if i > 0 {
					<span class="y-crumbs__sep" aria-hidden="true">·</span>
				}
				<a class="y-crumbs__link" href={ templ.URL(folderHref(seg.RelPath)) }>{ seg.Name }</a>
			}
		</div>
	}
	// The anchor goes on the heading the reader can actually see, not on a
	// hidden marker beside it: a jump has to land on the words it named.
	if v.TitleAnchor != "" {
		<h1 id={ v.TitleAnchor } class="y-title">{ v.Title }</h1>
	} else {
		<h1 class="y-title">{ v.Title }</h1>
	}
	if v.Type != "" || v.Status != "" || v.RelPath != "" {
		<div class="y-metarow">
			if v.Type != "" {
				<span class="ui-type">{ v.Type }</span>
			}
			if v.RelPath != "" {
				<span>{ v.RelPath }</span>
				// The file view has always offered this and the note view never
				// did, so the one surface where a reader is most likely to ask
				// "what does the file actually say" was the one with no way to
				// look. The endpoint was there; only the door was missing.
				<a class="y-metarow__raw" href={ templ.URL(rawHref(v.RelPath)) }>原始檔</a>
			}
		</div>
	}
	if v.Unsearchable {
		<p class="y-fileinfo__note" data-note-unsearchable>這個筆記太大,內容不會被搜尋讀取;閱讀不受影響。</p>
	}
	<div class="y-seam" aria-hidden="true"></div>
}

// ============================ LEFT RAIL ============================

// sidebar is the navigation face, ordered for a daily reader: a filter box
// (shipped hidden, revealed by the pre-paint script below), the "here" list of
// the current note's same-directory siblings, content-derived Paths and Maps,
// recent Journal entries, reports, and the folder tree with the current note's
// branch expanded.
// It takes one resolved Sidebar, so the reading page and the report shell mount
// the same navigation; a report builds it with no current note, so every branch
// renders closed and unmarked. A nil model renders nothing.
templ sidebar(sb Sidebar, nonce string) {
	<aside class="y-rail-left" id="nav-rail" aria-label="書庫導覽">
		<input
			class="y-filter"
			type="text"
			placeholder="篩選導覽…"
			aria-label="篩選導覽"
			autocomplete="off"
			spellcheck="false"
			data-nav-filter
			hidden
		/>
		<p class="y-filter-empty" data-filter-empty hidden>沒有相符項目；按 Esc 清除篩選。</p>
		<p class="y-filter-partial" data-filter-partial hidden></p>
		if sb.Model != nil {
			if len(sb.Here) > 0 {
				<nav class="y-here" aria-label="目前資料夾">
					<a class="y-here__label" href={ templ.URL(folderHref(sb.HereDir)) }>{ hereLabel(sb.HereDir) }</a>
					for _, n := range sb.Here {
						<a
							class={ "ui-navitem", templ.KV("is-active", sb.current(n.RelPath)) }
							href={ templ.URL(notesHref(n.RelPath)) }
							{ currentAttr(sb.current(n.RelPath))... }
						>{ n.Name }</a>
					}
					if sb.HereTrimmed > 0 {
						<a class="y-here__more" href={ templ.URL(folderHref(sb.HereDir)) } data-rail-trimmed={ strconv.Itoa(sb.HereTrimmed) } data-rail-dir={ sb.HereDir }>另外 { strconv.Itoa(sb.HereTrimmed) } 篇 →</a>
					}
				</nav>
			}
			// The rail carries a capability fault on every page, including the
			// ones reached straight from the command palette that never render
			// Home. It appears only for a declaration the vault made and yomihon
			// could not read: a folder that declared nothing has no paths and no
			// maps, and saying so on every page would be an apology for the
			// ordinary shape of a directory.
			if faults := sb.CapabilityFaults(); len(faults) > 0 {
				<div class="y-railsep" aria-hidden="true"></div>
				<section class="y-navdiag" data-sidebar-group="navigation-diagnostics" aria-labelledby="sidebar-navigation-diagnostics-title">
					<h2 class="y-railsummary y-railsummary--label" id="sidebar-navigation-diagnostics-title">路徑與地圖</h2>
					for _, fault := range faults {
						<p>
							@browserDiagnostic(fault.Summary, fault.Detail)
						</p>
					}
				</section>
			}
			if len(sb.Model.Paths()) > 0 {
				<div class="y-railsep" aria-hidden="true"></div>
				<details open?={ sb.pathsChainOpen() } data-sidebar-group="paths" { disclosureAttrs("paths", sb.pathsChainOpen())... }>
					<summary class="y-railsummary">
						@chevron()
						路徑
					</summary>
					<div class="y-railgroup">
						for _, step := range sb.Steps {
							<nav class="y-lessonsteps" aria-label={ step.PathTitle + " 課程順序" }>
								if len(sb.Steps) > 1 {
									<div class="y-lessonsteps__path">{ step.PathTitle }</div>
								}
								if step.Prev.RelPath != "" {
									<a class="ui-navitem" href={ templ.URL(notesHref(step.Prev.RelPath)) }>← 上一課：{ step.Prev.Name }</a>
								}
								if step.Next.RelPath != "" {
									<a class="ui-navitem" href={ templ.URL(notesHref(step.Next.RelPath)) }>下一課：{ step.Next.Name } →</a>
								}
							</nav>
						}
						for _, p := range sb.Model.Paths() {
							@pathTree(sb, p)
						}
					</div>
				</details>
			}
			if len(sb.Model.Maps()) > 0 {
				<div class="y-railsep" aria-hidden="true"></div>
				<details open?={ sb.mapsChainOpen() } data-sidebar-group="maps" { disclosureAttrs("maps", sb.mapsChainOpen())... }>
					<summary class="y-railsummary">
						@chevron()
						地圖
					</summary>
					<div class="y-railgroup">
						for _, m := range sb.Model.Maps() {
							@mapTree(sb, m, notesHref(m.RelPath))
						}
					</div>
				</details>
			}
			if len(sb.Model.Journal()) > 0 {
				<div class="y-railsep" aria-hidden="true"></div>
				<details open?={ sb.journalOpen() } data-sidebar-group="journal" { disclosureAttrs("journal", false)... }>
					<summary class="y-railsummary">
						@chevron()
						日誌
					</summary>
					<div class="y-railgroup">
						for _, entry := range sb.Model.Journal() {
							<a class={ "ui-navitem", templ.KV("is-active", sb.current(entry.RelPath)) } href={ templ.URL(notesHref(entry.RelPath)) } data-sidebar-journal-entry { currentAttr(sb.current(entry.RelPath))... }>{ entry.Title }</a>
						}
					</div>
				</details>
			}
			if len(sb.Model.Reports()) > 0 {
				<div class="y-railsep" aria-hidden="true"></div>
				<details open?={ sb.reportsOpen() } data-sidebar-group="reports" { disclosureAttrs("reports", false)... }>
					<summary class="y-railsummary">
						@chevron()
						報告
					</summary>
					<div class="y-railgroup">
						for _, rep := range sb.Model.Reports() {
							if rep.Briefing {
								<a class="ui-navitem" href={ templ.URL(reportHref(rep.Name)) }>
									{ rep.Name }
									if rep.Latest {
										<span class="y-navmark">最新</span>
									}
								</a>
							} else {
								<a class="ui-navitem" href={ templ.URL(notesHref(rep.RelPath)) }>
									{ rep.Name }
								</a>
							}
						}
					</div>
				</details>
			}
			<div class="y-railsep" aria-hidden="true"></div>
			<details open?={ sb.folderTreeOpen() } { disclosureAttrs("folders", sb.folderTreeOpen())... }>
				<summary class="y-railsummary">
					@chevron()
					資料夾
				</summary>
				<div class="y-railgroup">
					@folderList(sb)
				</div>
			</details>
		}
	</aside>
	// The pre-paint settle: reveals the filter box and reapplies the reader's
	// persisted disclosure toggles before the sidebar first paints, so the box
	// never pops in late and a section the reader closed never flashes open or
	// replays its opening animation. The wayfinding chain always wins over a
	// stored value; the enhancement script owns every change after this point.
	<script nonce={ nonce }>
		(() => {
			"use strict";
			const filter = document.querySelector(".y-rail-left [data-nav-filter]");
			if (filter) {
				filter.hidden = false;
			}
			let stored = {};
			try {
				stored =
					JSON.parse(sessionStorage.getItem("yomihon.nav") || "{}") || {};
			} catch {
				stored = {};
			}
			document
				.querySelectorAll(".y-rail-left details[data-key]")
				.forEach((d) => {
					if (d.hasAttribute("data-chain")) {
						d.open = true;
						return;
					}
					const want = stored[d.dataset.key];
					if (typeof want === "boolean") {
						d.open = want;
					}
				});
		})();
	</script>
}

templ chevron() {
	<svg class="y-chevron" aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m6 9 6 6 6-6"></path></svg>
}

// folderList renders the vault-root notes then the lifecycle-ordered folders.
templ folderList(sb Sidebar) {
	for _, n := range sb.Model.RootNotes() {
		<a
			class={ "ui-navitem", templ.KV("is-active", sb.current(n.RelPath)) }
			href={ templ.URL(notesHref(n.RelPath)) }
			{ currentAttr(sb.current(n.RelPath))... }
		>{ n.Name }</a>
	}
	for _, f := range sb.Model.Folders() {
		@folderNode(sb, f)
	}
}

// folderNode renders one folder and recurses — the tree mirrors the real
// directory structure to whatever depth it has, as a nested native <details>.
// The branch holding the current note opens by default, revealing it in place.
templ folderNode(sb Sidebar, f nav.Folder) {
	if len(f.Subfolders) > 0 || len(f.Notes) > 0 {
		{{ shown, trimmed := sb.TreeFiles(&f) }}
		<details open?={ sb.folderOpen(f.RelPath) } { disclosureAttrs("dir:"+f.RelPath, sb.folderOpen(f.RelPath))... }>
			<summary class="ui-navitem">
				@chevron()
				{ f.Name }
			</summary>
			<div class="y-tree">
				for _, sub := range f.Subfolders {
					@folderNode(sb, sub)
				}
				for _, n := range shown {
					<a
						class={ "ui-navitem", templ.KV("is-active", sb.current(n.RelPath)) }
						href={ templ.URL(notesHref(n.RelPath)) }
						{ currentAttr(sb.current(n.RelPath))... }
					>{ n.Name }</a>
				}
				if trimmed > 0 {
					<a class="y-here__more" href={ templ.URL(folderHref(f.RelPath)) } data-rail-trimmed={ strconv.Itoa(trimmed) } data-rail-dir={ f.RelPath }>另外 { strconv.Itoa(trimmed) } 篇 →</a>
				}
			</div>
		</details>
	} else {
		<span class="ui-navitem">{ f.Name }</span>
	}
}

// mapTree renders one map as a closed disclosure that opens when it holds the
// current note. href points Paths at their dedicated route and other maps at
// their note page.
templ mapTree(sb Sidebar, m nav.Map, href string) {
	<details open?={ sb.mapOpen(m.RelPath) } data-map-tree={ m.RelPath } { disclosureAttrs("map:"+m.RelPath, sb.mapOpen(m.RelPath))... }>
		<summary class="y-railitem">
			@chevron()
			<span class="y-railitem__name">{ m.Title }</span>
		</summary>
		<div class="y-tree">
			<a class="y-railitem__full" href={ templ.URL(href) }>開啟地圖</a>
			for _, branch := range m.Branches {
				@branchNode(sb, m.RelPath, childChain(nil, branch.Heading), branch)
			}
		</div>
	</details>
}

// pathTree renders one study path as a closed disclosure that opens when it
// holds the current note. It draws the declared structure navigation already
// read: a branch the course does not include is not in the rail either, and a
// side branch sits under the lesson it hangs from, in source order.
templ pathTree(sb Sidebar, p nav.Path) {
	<details open?={ sb.mapOpen(p.RelPath) } data-map-tree={ p.RelPath } { disclosureAttrs("map:"+p.RelPath, sb.mapOpen(p.RelPath))... }>
		<summary class="y-railitem">
			@chevron()
			<span class="y-railitem__name">{ p.Title }</span>
		</summary>
		<div class="y-tree">
			<a class="y-railitem__full" href={ templ.URL(syllabusHref(p.RelPath)) }>開啟課綱</a>
			for _, g := range p.Groups {
				@pathGroupNode(sb, p.RelPath, childChain(nil, g.Name), g)
			}
		</div>
	</details>
}

// pathGroupNode renders one branch of a study path, opened when it lies on the
// way to the current note. A branch the grammar does not project draws nothing:
// it is not part of the course, so it is not a way to a lesson.
templ pathGroupNode(sb Sidebar, pathRel string, chain []string, g *nav.PathGroup) {
	if pathGroupDrawn(g) {
		<details open?={ sb.branchOpen(pathRel, chain) } { disclosureAttrs("mapbranch:"+branchKey(pathRel, chain), sb.branchOpen(pathRel, chain))... }>
			<summary class="y-treeitem">
				@chevron()
				{ g.Name }
			</summary>
			<div class="y-tree">
				@pathGroupItems(sb, pathRel, chain, g)
			</div>
		</details>
	}
}

// pathGroupItems draws a branch's lessons and side branches in source order.
templ pathGroupItems(sb Sidebar, pathRel string, chain []string, g *nav.PathGroup) {
	for _, item := range g.Items {
		if item.Entry != nil {
			if g.Projectable && item.Entry.State == sequence.EntryAccepted {
				@pathEntryLink(sb, item.Entry)
			}
		} else if item.Group != nil {
			@pathGroupNode(sb, pathRel, childChain(chain, item.Group.Name), item.Group)
		}
	}
}

// pathEntryLink renders one lesson row: a lesson that resolves links and may
// mark the current note; a planned or ambiguous one stays non-interactive and
// keeps its place in the course.
templ pathEntryLink(sb Sidebar, entry *nav.PathEntry) {
	if entry.Kind == nav.EntryResolved {
		<a
			class={ "ui-navitem", templ.KV("is-active", sb.current(entry.RelPath)) }
			href={ templ.URL(notesHref(entry.RelPath)) }
			{ currentAttr(sb.current(entry.RelPath))... }
		>
			<span class="y-navdot" aria-hidden="true"></span>
			{ entry.Text }
			if entry.Status != "" {
				<span class="ui-navitem__count">{ entry.Status }</span>
			}
		</a>
	} else {
		<span
			class="ui-navitem y-navitem--broken"
			data-resolution={ entryResolutionCode(entry.Kind) }
			title={ entryResolutionTitle(entry.Kind) }
		>
			<span class="y-navmark y-navmark--warn" aria-hidden="true">!</span>
			{ entry.Text }
			<span class="ui-navitem__count">{ entryResolutionLabel(entry.Kind) }</span>
		</span>
	}
}

// branchNode renders one map branch as a disclosure, opened when it lies on the
// path to the current note, and recurses for nested branches.
templ branchNode(sb Sidebar, mapPath string, chain []string, branch nav.Branch) {
	<details open?={ sb.branchOpen(mapPath, chain) } { disclosureAttrs("mapbranch:"+branchKey(mapPath, chain), sb.branchOpen(mapPath, chain))... }>
		<summary class="y-treeitem">
			@chevron()
			{ branch.Heading }
		</summary>
		<div class="y-tree">
			for _, sub := range branch.Subbranches {
				@branchNode(sb, mapPath, childChain(chain, sub.Heading), sub)
			}
			for _, entry := range branch.Entries {
				@entryLink(sb, entry)
			}
		</div>
	</details>
}

// entryLink renders one map row: governed unique targets link and may mark the
// current note; study-path warning rows remain non-interactive.
templ entryLink(sb Sidebar, entry nav.Entry) {
	if entry.Kind == nav.EntryResolved {
		<a
			class={ "ui-navitem", templ.KV("is-active", sb.current(entry.RelPath)) }
			href={ templ.URL(notesHref(entry.RelPath)) }
			{ currentAttr(sb.current(entry.RelPath))... }
		>
			<span class="y-navdot" aria-hidden="true"></span>
			{ entry.Text }
			if entry.Status != "" {
				<span class="ui-navitem__count">{ entry.Status }</span>
			}
		</a>
	} else {
		<span
			class="ui-navitem y-navitem--broken"
			data-resolution={ entryResolutionCode(entry.Kind) }
			title={ entryResolutionTitle(entry.Kind) }
		>
			<span class="y-navmark y-navmark--warn" aria-hidden="true">!</span>
			{ entry.Text }
			<span class="ui-navitem__count y-navmark--warn">{ entryResolutionLabel(entry.Kind) }</span>
		</span>
	}
}

// ============================ RIGHT RAIL ============================
// The status panel comes first, before the outline. The rail is its own scroll
// container, so an outline of any length pushed the panel past the bottom of
// the window and scrolling the article moved it not one pixel — the one action
// this product is built around was, on most notes, somewhere the reader never
// looked. Ordering it first pins it a fixed distance from the rail's top on
// every note, whatever the outline's length.
templ rightRail(v NoteView) {
	<aside class="y-rail-right" aria-label="閱讀輔助">
		if v.Governed && (v.Diagnostic == "" || v.NonInstance) {
			@statusPanel(v)
		}
		if len(v.TOC) > 0 {
			<nav aria-label="本頁內容">
				<div class="ui-side__label">本頁內容</div>
				@tocList(v)
			</nav>
		}
		@citedBy(v)
		@diagnostics(v)
	</aside>
}

// citedBy lists the notes whose text links to this one. Nothing is a real
// answer here and gets said out loud: a note nothing cites is an island, and a
// block that vanished when the count reached zero would leave the reader
// unable to tell "no one cites this" from "this interface does not know".
templ citedBy(v NoteView) {
	if v.citedByShown() {
		@citedByBlock(v)
	}
}

// citedByBlock is the block itself, rendered only where the answer means
// something.
templ citedByBlock(v NoteView) {
	<nav class="y-citedby" aria-label="連到這篇的筆記">
		<div class="ui-side__label">
			連到這篇
			if len(v.CitedBy) > 0 {
				<span class="ui-navitem__count">{ strconv.Itoa(len(v.CitedBy)) }</span>
			}
		</div>
		if len(v.CitedBy) > 0 {
			for _, ref := range v.CitedBy {
				<a class="ui-navitem" href={ templ.URL(notesHref(ref.RelPath)) }>{ ref.Name }</a>
			}
		} else {
			<p class="y-citedby__none">目前沒有其他筆記連到這篇。</p>
		}
	</nav>
}

// sequenceSteps closes the article with the way onward. A folder of dated
// entries is a line and a course of lessons is a line; a reader who has
// finished one wants the next, and until this existed the only way to take that
// step was back into the rail — a diarist reading a week found herself retyping
// the same filter seven times to do it.
//
// Which line it offers is decided beside the two orders that could answer, and
// the label says which one arrived, so the arrow never claims an order it is
// not walking. The label is printed, not only spoken: it once lived in the
// accessible name alone, and a sighted reader had no way to tell a course's
// declared order from mere folder adjacency — the two can disagree completely.
// The step words carry the same fact per link: a course hands over the next
// lesson, a folder merely the file beside this one. The printed label and the
// accessible name render one field, so the two can never drift apart.
templ sequenceSteps(v NoteView) {
	if v.Prev.RelPath != "" || v.Next.RelPath != "" {
		<nav class="y-steps" aria-label={ v.StepsLabel }>
			<p class="y-steps__source">{ v.StepsLabel }</p>
			if v.Prev.RelPath != "" {
				<a class="y-steps__link y-steps__link--prev" href={ templ.URL(notesHref(v.Prev.RelPath)) } rel="prev">
					<span class="y-steps__dir" aria-hidden="true">←</span>
					<span class="y-steps__role">{ stepWordPrev(v.StepsCourse) }</span>
					<span class="y-steps__name">{ v.Prev.Name }</span>
				</a>
			}
			if v.Next.RelPath != "" {
				<a class="y-steps__link y-steps__link--next" href={ templ.URL(notesHref(v.Next.RelPath)) } rel="next">
					<span class="y-steps__role">{ stepWordNext(v.StepsCourse) }</span>
					<span class="y-steps__name">{ v.Next.Name }</span>
					<span class="y-steps__dir" aria-hidden="true">→</span>
				</a>
			}
		</nav>
	}
}

// tocList is the table-of-contents link list, shared by the right rail and
// the inline disclosure so the two render one surface, never two variants.
templ tocList(v NoteView) {
	<div class="y-toc__list">
		for _, h := range v.TOC {
			<a href={ templ.URL("#" + h.ID) } data-level={ strconv.Itoa(h.Level) }>{ h.Text }</a>
		}
	</div>
}

// inlineAids keeps the reading aids reachable at widths where the right rail
// is hidden: the table of contents as a closed native disclosure at the top
// of the article, the diagnostics list beneath it. Wide viewports hide this
// block and show the rail instead; a note with no aids renders nothing here.
templ inlineAids(v NoteView) {
	if v.hasAids() {
		<div class="y-inlineaids" lang="zh-Hant">
			if len(v.TOC) > 0 {
				<details class="y-toc-inline">
					<summary class="y-toc-inline__summary">
						@chevron()
						本頁內容
					</summary>
					@tocList(v)
				</details>
			}
			// At these widths the rail is gone and this block sits between the
			// title and the first sentence, so an open list of findings is the
			// last thing the page says before the prose it is about. It folds
			// like the contents above it: the count is still stated, and what
			// the note is remains the first thing read.
			if v.diagCount() > 0 {
				<details class="y-toc-inline">
					<summary class="y-toc-inline__summary">
						@chevron()
						筆記狀況
						<span class="y-diagcount">{ strconv.Itoa(v.diagCount()) }</span>
					</summary>
					@diagnostics(v)
				</details>
			}
			// What links here is a fact about the library, not a decoration the
			// narrow layout can drop. It folds like the two above it so the
			// prose still starts near the top.
			if v.citedByShown() {
				<details class="y-toc-inline">
					<summary class="y-toc-inline__summary">
						@chevron()
						連到這篇
						if len(v.CitedBy) > 0 {
							<span class="y-diagcount">{ strconv.Itoa(len(v.CitedBy)) }</span>
						}
					</summary>
					@citedByBlock(v)
				</details>
			}
		</div>
	}
}

// statusPanel is the rail status face: one plain form per legal transition (the
// PRG pattern, no JS dependency). The responsive seal bar is the second status
// face. The schema-owned seal target is the only primary, with the
// press-and-hold ceremony layered on by JS; every other legal transition is a
// quiet one-click form. The legal set is only what the schema contract returns —
// never a fabricated key.
templ statusPanel(v NoteView) {
	<section class={ "y-statuspanel", templ.KV("y-justsealed", v.JustSealed) } data-seal-panel data-status-state={ statusState(v) }>
		if v.NonInstance {
			<p class="y-statuspanel__notice">{ nonInstanceReason }</p>
		} else {
			<div class="y-statuspanel__head">
				<div class="y-statuspanel__row">
					<span class="ui-side__label">狀態</span>
					if v.WriteDiagnostic == "" {
						<span class="y-actor">操作者 · koopa</span>
					}
				</div>
				if v.Sealed {
					@sealedBadge(v)
				} else if v.Status != "" {
					<span class={ "ui-status", "ui-status--" + v.Status }>{ v.Status }</span>
				}
			</div>
			switch  {
				case v.WriteDiagnostic != "":
					<p class="y-statuspanel__notice">
						@browserDiagnostic("生命週期寫入目前無法使用。", v.WriteDiagnostic)
					</p>
				case v.NoFrontmatter:
					<p class="y-statuspanel__notice">沒有 frontmatter（合法）。</p>
				case len(v.Transitions) == 0:
					if !v.Sealed {
						if v.WithheldByOwner {
							<p class="y-statuspanel__notice">接下來的狀態轉換由其他 owner 持有；目前操作者沒有執行權限。</p>
						} else {
							<p class="y-statuspanel__notice">目前沒有合法的狀態轉換。</p>
						}
					}
				default:
					if v.WriteBlock != "" {
						<p class="y-statuspanel__notice y-writeblock">
							@writeBlockNotice(v)
						</p>
					}
					<div class="y-statuspanel__forms">
						@legalTransitionForms(v)
					</div>
			}
		}
	</section>
}

// sealedBadge is the 済 display for a sealed note: the stamp, the kintsugi
// hairline, and the paired CJK · English provenance line with the read-only git
// short hash. Its one-shot animation fires from y-justsealed (added when
// ?sealed=1) via CSS.
templ sealedBadge(v NoteView) {
	<div class="y-sealed">
		<span class="y-sealed__stamp" lang="ja" aria-hidden="true">済</span>
		<span class="y-sealed__label">{ v.SealTarget }</span>
	</div>
	<div class="y-sealline" aria-hidden="true"></div>
	<div class="y-sealby">
		<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="9"></circle><path d="m9 12 2 2 4-4"></path></svg>
		鈐印 · koopa
		if v.JustSealed {
			· 剛剛
		}
	</div>
	if v.SealedHash != "" {
		<div class="y-sealgit">git · commit { v.SealedHash }</div>
	}
}

// sealForm is the koopa-only seal: a plain POST form (no-JS: one press
// submits) that JS upgrades into a press-and-hold. requestSubmit on completion,
// never fetch — the server sees exactly the no-JS request.
//
// When the working tree would refuse this transition the control stays on the
// page and stops working. The refusal is a fact about the tree, not about the
// contract: the transition is legal and becomes pressable again the moment the
// note's own edit is committed, so removing it would hide a target the reader
// is about to be able to reach. The ceremony's hint and its line about the act
// go with the ability to perform it — a page that keeps advertising a hold it
// will not honour is the half-finished notice this replaces.
templ sealForm(v NoteView) {
	<form class="y-statusform" method="post" action="/status" data-seal>
		<input type="hidden" name="path" value={ v.RelPath }/>
		<input type="hidden" name="from" value={ v.Status }/>
		<input type="hidden" name="to" value={ v.SealTarget }/>
		<button class="y-sealbtn" type="submit" data-seal-btn disabled?={ v.WriteBlock != "" } aria-label={ sealButtonLabel(v) }>
			<span class="y-sealfill" aria-hidden="true"></span>
			<span class="y-sealbtn__stamp" lang="ja" aria-hidden="true">印</span>
			<span>認證 { v.SealTarget }</span>
			if v.WriteBlock == "" {
				<span class="y-sealbtn__hint" aria-hidden="true">按住 R</span>
			}
		</button>
	</form>
	if v.WriteBlock == "" {
		<p class="y-sealpoem">最後一步只由 koopa 完成。按住一次，不撤回。</p>
	}
}

// transitionForm is a quiet, one-click secondary transition (everything that is
// not the seal): a plain POST form, no ceremony. It carries the same refusal as
// the seal, for the same reason.
templ transitionForm(v NoteView, to string) {
	<form class="y-statusform" method="post" action="/status">
		<input type="hidden" name="path" value={ v.RelPath }/>
		<input type="hidden" name="from" value={ v.Status }/>
		<input type="hidden" name="to" value={ to }/>
		<button class="y-xbtn" type="submit" { refusalAttrs(writeBlockLabel(v), to)... }>{ to }</button>
	</form>
}

// sealButtonLabel names the seal control: the ceremony while it can be
// performed, and the target plus the reason once the working tree would refuse
// it.
//
// The reason travels in the accessible name rather than through a reference to
// the paragraph that states it, because both status faces are in the document
// at every width and a reference needs an identifier that occurs once. A name
// also survives the disabled state on every engine, and a reader who reaches a
// control without having read the paragraph above still gets the reason with
// the control.
func sealButtonLabel(v NoteView) string {
	if v.WriteBlock != "" {
		return "認證 " + v.SealTarget + "：" + writeBlockLabel(v)
	}
	return "按住以認證 " + v.SealTarget
}

// writeBlockLabel is the refusal in the length an accessible name can carry:
// the headline where the refusal has one, and the reason itself otherwise. The
// full text is in the notice beside the control either way, so the name says
// which refusal this is rather than reading the whole paragraph aloud first.
func writeBlockLabel(v NoteView) string {
	if v.WriteBlockHeadline != "" {
		return v.WriteBlockHeadline
	}
	return v.WriteBlock
}

// writeBlockNotice states a refusal in both status faces. The headline is the
// operator's own next move, so it leads; the reason and the step that clears it
// follow. Every part is inline-level markup, because one face is a paragraph
// and the other a span inside the seal bar.
templ writeBlockNotice(v NoteView) {
	if v.WriteBlockHeadline != "" {
		<strong class="y-writeblock__head">{ v.WriteBlockHeadline }</strong>
	}
	<span class="y-writeblock__body">{ v.WriteBlock }</span>
	if v.WriteBlockNextStep != "" {
		<span class="y-writeblock__step">{ v.WriteBlockNextStep }</span>
	}
}

// refusalAttrs marks a quiet transition control the working tree would refuse.
// It adds nothing while the transition can be taken, so a pressable control
// carries no name of its own and keeps the one its visible text already gives
// it.
func refusalAttrs(reason, to string) templ.Attributes {
	if reason == "" {
		return nil
	}
	return templ.Attributes{"disabled": true, "aria-label": to + "：" + reason}
}

// legalTransitionForms renders the complete schema-provided set for either
// status face. The seal target alone gets the hold ceremony; every other
// target remains a quiet one-click form.
templ legalTransitionForms(v NoteView) {
	for _, to := range v.Transitions {
		if to == v.SealTarget {
			@sealForm(v)
		} else {
			@transitionForm(v, to)
		}
	}
}

// diagnostics is the read-only diagnostics rail: the frontmatter
// diagnostic and every render diagnostic, amber, stated but never repaired.
templ diagnostics(v NoteView) {
	if v.Diagnostic != "" || len(v.RenderDiagnostics) > 0 {
		<section>
			<div class="ui-side__label y-diaghead">
				筆記狀況
				<span class="y-diagcount">{ strconv.Itoa(v.diagCount()) }</span>
			</div>
			<div class="y-diaglist">
				if v.Diagnostic != "" {
					<div class="y-diag">
						<div class="y-diag__label">frontmatter</div>
						<p class="y-diag__body">
							@browserDiagnostic("frontmatter 不是有效的 YAML。", v.Diagnostic)
						</p>
					</div>
				}
				for _, d := range v.RenderDiagnostics {
					<div class="y-diag">
						<div class="y-diag__label">{ diagKindLabel(d.Kind) }</div>
						<p class="y-diag__body">
							{ renderDiagnosticSummary(d.Kind) }
							if d.Target != "" {
								<code>{ d.Target }</code>
							}
							if d.Message != "" {
								<code lang="en">{ d.Message }</code>
							}
						</p>
					</div>
				}
			</div>
			<p class="y-diag__note">只陳述狀態，不自動修復。</p>
		</section>
	}
}

// ============================ SEAL BAR (≤1280) ============================

// sealBar is the status face at every width where the right rail is absent:
// narrow viewports hide the rail, and a note with no reading aids drops its
// column entirely. It mirrors the status panel's states — the sealed badge,
// the current chip with every legal transition (shared data-seal hook, so the
// hold ceremony behaves identically), and the closed-face notices — so the
// write face's state always has somewhere to appear. A frontmatter
// diagnostic suppresses governance state because no status was parsed; a
// non-instance remains named because that classification comes from its path,
// independent of frontmatter.
templ sealBar(v NoteView) {
	if v.Governed && (v.Diagnostic == "" || v.NonInstance) {
		<div class={ "y-sealbar", templ.KV("y-justsealed", v.JustSealed) } data-seal-panel data-status-state={ statusState(v) }>
			switch  {
				case v.NonInstance:
					<p class="y-sealbar__notice">{ nonInstanceReason }</p>
				case v.WriteDiagnostic != "":
					<p class="y-sealbar__notice">
						@browserDiagnostic("生命週期寫入目前無法使用。", v.WriteDiagnostic)
					</p>
				case v.NoFrontmatter:
					<p class="y-sealbar__notice">沒有 frontmatter（合法）。</p>
				case v.Sealed:
					<div class="y-sealed">
						<span class="y-sealed__stamp" lang="ja" aria-hidden="true">済</span>
						<span class="y-sealed__label">{ v.SealTarget }</span>
					</div>
					<span class="y-actor">鈐印 · 已認證</span>
					if len(v.Transitions) > 0 {
						if v.WriteBlock != "" {
							<span class="y-sealbar__notice y-writeblock">
								@writeBlockNotice(v)
							</span>
						}
						<span class="y-sealbar__spacer"></span>
						@legalTransitionForms(v)
					}
				default:
					if v.Status != "" {
						<span class={ "ui-status", "ui-status--" + v.Status }>{ v.Status }</span>
					}
					if v.WriteBlock != "" {
						<span class="y-sealbar__notice y-writeblock">
							@writeBlockNotice(v)
						</span>
					}
					<span class="y-sealbar__spacer"></span>
					@legalTransitionForms(v)
			}
		</div>
	}
}

func statusState(v NoteView) string {
	switch {
	case v.NonInstance:
		return "non-instance"
	case v.WriteDiagnostic != "":
		return "unavailable"
	default:
		return "instance"
	}
}
