package pages

import (
	"fmt"
	"strconv"

	"github.com/koopa0/yomihon/internal/lesson"
	"github.com/koopa0/yomihon/internal/nav"
	"github.com/koopa0/yomihon/internal/render"
	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// NoteView is everything the reading page needs. Diagnostic and
// RenderDiagnostics are display-only: yomihon reports what it found, and a
// human edits the file. Transitions, WriteDiagnostic, NonInstance,
// OutsideKnowledgeScope and NoFrontmatter drive the two status faces.
type NoteView struct {
	Title   string
	RelPath string
	// Language is what the note is written in, as the note declares it. The
	// language the page's own words are in arrives with the chrome, so one
	// page cannot hold two answers to it.
	Language string
	Type     string
	Status   string
	// ObsidianHref is the obsidian://open URI for this note, already built
	// and escaped by ObsidianHref. Empty renders no editor link.
	ObsidianHref string
	Diagnostic   string
	// Unsearchable is set for a note too large to hold in the index, whose
	// phrases a later search would report as no results at all.
	Unsearchable bool
	// Stale is set where the file could not be read while this page was built,
	// so the words below are the last ones read rather than the current ones.
	Stale bool
	// Updated is the display date the metarow carries and UpdatedAt its
	// machine-readable value: the author's declared update where the
	// frontmatter has a readable one, the file's recorded change time
	// otherwise, with UpdatedFromFile picking the label. Both empty renders no
	// date, a blank being better than a claim.
	Updated         string
	UpdatedAt       string
	UpdatedFromFile bool
	BodyHTML        string
	// TitleAnchor is the id the title carries, set where the renderer dropped a
	// duplicate opening heading, so a link written at that section still lands.
	// Empty where the note wrote no such heading: an anchor there would answer
	// for a section nobody wrote.
	TitleAnchor string

	RenderDiagnostics []render.Diagnostic
	// Prev and Next are the notes either side of this one in the sequence the
	// foot of the article offers. StepsLabel names that sequence, printed and
	// spoken alike; StepsCourse says whether it is a course's declared order
	// rather than folder adjacency, which picks the step words.
	Prev        nav.NoteRef
	Next        nav.NoteRef
	StepsLabel  string
	StepsCourse bool
	// VaultHasLinks says some note in this folder cites another. Where none
	// does, an empty cited-by block on every page is furniture; where the
	// folder does use links, an empty block is a finding and stays.
	VaultHasLinks bool
	// CitedBy are the notes whose text links here. An empty list is an answer —
	// the note is an island — so the block states that rather than vanishing.
	CitedBy []nav.NoteRef
	TOC     []render.TOCEntry

	// Sidebar is the resolved left navigation for this page.
	Sidebar Sidebar

	// Governed says whether anything claimed authority over this vault. Both
	// status faces are absent where it is false, a folder with no contract
	// having no lifecycle, and every field below is meaningful only under it.
	Governed bool

	Transitions []Transition
	// ContentIdentity is the hex identity of the source bytes this page
	// rendered, carried in every transition form so the write face can refuse
	// a ruling that was read against content the disk no longer holds.
	ContentIdentity string
	// TranscludedIdentity is the render's digest over the excerpts this page
	// pulled in, empty where it pulled in none. It rides the freshness watch
	// alone: a ruling binds the note's own bytes, and an embedded source is not
	// among them.
	TranscludedIdentity string
	NonInstance         bool
	WriteDiagnostic     string
	NoFrontmatter       bool
	// OutsideKnowledgeScope is set for a note the write face reaches no further
	// than reading: it sits outside the layer scan.knowledge_dirs declares, so
	// its transition set is empty for that reason rather than because the
	// schema defines nothing onward.
	OutsideKnowledgeScope bool
	// FlippedFrom is the status a successful flip left, on the reading that
	// flip redirected to. The address carries only the name: the handler
	// legalises the move against the contract and then spends the one-time
	// receipt the write minted, so a bookmarked or reloaded address finds that
	// receipt spent and gets no sentence.
	FlippedFrom string
	// FlipNoReturn is set where the offered controls cannot walk the stated
	// change back, so the receipt also says how recovery happens.
	FlipNoReturn bool

	// StatusUnknown is set where the note's non-empty status is not in the
	// contract's declared list for its type, which both faces flag rather than
	// implying the contract defines nothing onward.
	StatusUnknown bool

	// SchemaNotices is what the schema said about this note's frontmatter, one
	// sentence per fault, already in the reader's language and already split
	// into the words and the note's own text they sit around.
	SchemaNotices [][]wording.SchemaPart

	// Concepts are the grammar-concept notes this lesson links to, each
	// pre-rendered for the concept sheet.
	Concepts []lesson.ConceptDoc
}

// Transition is one offered lifecycle target and how its control behaves. A
// no-return target — one the write face could not walk the note back from —
// submits only behind a second interaction; every other target is a single
// press.
type Transition struct {
	To       string
	NoReturn bool
}

// Note is the reading page: the article in the shared shell, with the
// navigation sidebar, whatever aids the note earns on the right, and the status
// face. Everything it shows is either the note's own bytes rendered faithfully
// or a diagnostic about them; it repairs nothing.
templ Note(v NoteView, c layouts.Chrome) {
	{{ lang := c.Lang }}
	@layouts.Base(c) {
		<div class="y-nav-scrim" data-nav-close></div>
		<div class={ "y-shell", templ.KV("y-shell--rail-empty", !v.hasAids()) }>
			@sidebar(v.Sidebar, c)
			<main id="main-content" tabindex="-1" class="y-main" { freshnessAttrs(&v, lang)... } { readAloudAttrs(&v, lang)... } data-preview-endpoint="/preview/">
				@flipReceipt(v, lang)
				<article class="y-article" { articleLanguageAttrs(v.Language)... }>
					@articleHead(v, lang)
					@inlineAids(v, lang)
					<div class="y-prose">
						@templ.Raw(v.BodyHTML)
					</div>
					@sequenceSteps(v, lang)
				</article>
			</main>
			@rightRail(v, lang)
		</div>
		@statusBar(v, lang)
		@conceptSheet(v.Concepts, lang)
		@previewCard()
	}
}

// conceptSheet is the grammar-concept drawer: one hidden <template> per concept
// the lesson links to, plus a shared native <dialog> the client clones into.
// With scripting off the triggers stay ordinary links to the concept notes.
templ conceptSheet(concepts []lesson.ConceptDoc, lang wording.Lang) {
	if len(concepts) > 0 {
		for _, c := range concepts {
			<template id={ "concept-" + c.ID } data-title={ c.Title }>
				@templ.Raw(c.HTML)
			</template>
		}
		<dialog class="y-conceptsheet" data-concept-sheet aria-label={ wording.GrammarNote.In(lang) } closedby="any">
			<div class="y-conceptsheet__head">
				<span class="y-conceptsheet__title" data-concept-title></span>
				<button type="button" class="y-iconbtn" data-concept-close aria-label={ wording.CloseControl.In(lang) }>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
				</button>
			</div>
			<div class="y-conceptsheet__body y-prose" data-concept-body></div>
		</dialog>
	}
}

// articleHead is the breadcrumb + title + type meta + the kintsugi seam above
// the rendered body.
templ articleHead(v NoteView, lang wording.Lang) {
	if crumbs := Breadcrumb(v.RelPath); len(crumbs) > 0 {
		<div class="y-crumbs">
			for i, seg := range crumbs {
				if i > 0 {
					<span class="y-crumbs__sep" aria-hidden="true">·</span>
				}
				<a class="y-crumbs__link" href={ templ.URL(folderHref(seg.RelPath)) }>{ seg.Name }</a>
			}
		</div>
	}
	// A jump has to land on the words it named, so the anchor goes on the
	// visible heading rather than a hidden marker beside it.
	if v.TitleAnchor != "" {
		<h1 id={ v.TitleAnchor } class="y-title">{ v.Title }</h1>
	} else {
		<h1 class="y-title">{ v.Title }</h1>
	}
	if v.Type != "" || v.Status != "" || v.RelPath != "" || v.Updated != "" {
		<div class="y-metarow">
			if v.Type != "" {
				<span class="ui-type">{ v.Type }</span>
			}
			// The date is a fact about the note like its type, so it sits with
			// the facts, before the links that act.
			if v.Updated != "" {
				<span>{ noteDateLabel(&v, lang) } <time datetime={ v.UpdatedAt }>{ v.Updated }</time></span>
			}
			if v.RelPath != "" {
				<span>{ v.RelPath }</span>
				// The reading page is the surface where a reader is most likely
				// to ask what the file actually says, so it carries the door to
				// the bytes. The line count is load-bearing: templ emits a
				// comment's newlines as whitespace between these two links.
				<a class="y-metarow__raw" href={ templ.URL(rawHref(v.RelPath)) }>{ wording.RawFile.In(lang) }</a>
			}
			if v.ObsidianHref != "" {
				// Every repair yomihon reports is a hand edit, so the page
				// offers the way to where editing happens. The href is already
				// built and escaped server-side, so it bypasses the sanitizer
				// that would reject its custom scheme. The line count is
				// load-bearing here too, for the whitespace before this link.
				<a class="y-metarow__raw" href={ templ.SafeURL(v.ObsidianHref) }>{ wording.OpenInObsidian.In(lang) }</a>
			}
		</div>
	}
	if v.Unsearchable {
		<p class="y-fileinfo__note" data-note-unsearchable>{ wording.NoteTooLargeToIndex.In(lang) }</p>
	}
	if v.Stale {
		<p class="y-fileinfo__note" data-note-stale>{ wording.NoteStale.In(lang) }</p>
	}
	<div class="y-seam" aria-hidden="true"></div>
}

// ============================ RIGHT RAIL ============================
// Reading leads and the ruling closes: the note's own shape, then what leads
// to it from elsewhere in the vault, then the status panel. The panel used to
// open the rail so a long outline could not push it past the bottom of the
// window, which put the page's smallest verb above both of the things the
// reader came to the rail for. It is reached by scrolling the rail, like
// everything else in it.
templ rightRail(v NoteView, lang wording.Lang) {
	<aside class="y-rail-right" aria-label={ wording.ReadingAids.In(lang) }>
		if len(v.TOC) > 0 {
			<nav aria-label={ wording.OnThisPage.In(lang) }>
				<div class="ui-side__label">{ wording.OnThisPage.In(lang) }</div>
				@tocList(v, lang)
			</nav>
		}
		@citedBy(v, lang)
		@diagnostics(v, lang)
		@statusPanel(v, lang)
	</aside>
}

// citedBy lists the notes whose text links to this one. Nothing is a real
// answer and is said out loud: a block that vanished at zero would leave a
// reader unable to tell an island from an interface that does not know.
templ citedBy(v NoteView, lang wording.Lang) {
	if v.citedByShown() {
		@citedByBlock(v, lang)
	}
}

// citedByBlock is the block itself, rendered only where the answer means
// something.
templ citedByBlock(v NoteView, lang wording.Lang) {
	<nav class="y-citedby" aria-label={ wording.CitedByNav.In(lang) }>
		<div class="ui-side__label">
			{ wording.CitedBy.In(lang) }
			if len(v.CitedBy) > 0 {
				<span class="ui-navitem__count">{ strconv.Itoa(len(v.CitedBy)) }</span>
			}
		</div>
		if len(v.CitedBy) > 0 {
			for _, ref := range v.CitedBy {
				<a class="ui-navitem" href={ templ.URL(notesHref(ref.RelPath)) }>{ ref.Name }</a>
			}
		} else {
			<p class="y-citedby__none">{ wording.CitedByNone.In(lang) }</p>
		}
	</nav>
}

// sequenceSteps closes the article with the way onward: a folder of dated
// entries is a line, and so is a course of lessons. The label says which order
// arrived, so the arrow never claims one it is not walking, and it is printed
// rather than only spoken, because a course's declared order and folder
// adjacency can disagree completely. The printed label and the accessible name
// render one field, so the two cannot drift apart.
templ sequenceSteps(v NoteView, lang wording.Lang) {
	if v.Prev.RelPath != "" || v.Next.RelPath != "" {
		<nav class="y-steps" aria-label={ v.StepsLabel }>
			<p class="y-steps__source">{ v.StepsLabel }</p>
			if v.Prev.RelPath != "" {
				<a class="y-steps__link y-steps__link--prev" href={ templ.URL(notesHref(v.Prev.RelPath)) } rel="prev">
					<span class="y-steps__dir" aria-hidden="true">←</span>
					<span class="y-steps__role">{ stepWordPrev(v.StepsCourse, lang) }</span>
					<span class="y-steps__name">{ v.Prev.Name }</span>
				</a>
			}
			if v.Next.RelPath != "" {
				<a class="y-steps__link y-steps__link--next" href={ templ.URL(notesHref(v.Next.RelPath)) } rel="next">
					<span class="y-steps__role">{ stepWordNext(v.StepsCourse, lang) }</span>
					<span class="y-steps__name">{ v.Next.Name }</span>
					<span class="y-steps__dir" aria-hidden="true">→</span>
				</a>
			}
		</nav>
	}
}

// tocList is the table-of-contents link list, shared by the right rail and the
// inline disclosure so the two render one surface.
templ tocList(v NoteView, lang wording.Lang) {
	<div class="y-toc__list">
		for _, h := range v.TOC {
			<a href={ templ.URL("#" + h.ID) } data-level={ strconv.Itoa(h.Level) }>{ h.Text }</a>
		}
	</div>
}

// inlineAids keeps the reading aids reachable at widths where the right rail is
// hidden. Wide viewports hide this block and show the rail instead.
templ inlineAids(v NoteView, lang wording.Lang) {
	if v.hasAids() {
		<div class="y-inlineaids" lang={ lang.Tag() }>
			if len(v.TOC) > 0 {
				<details class="y-toc-inline">
					<summary class="y-toc-inline__summary">
						@chevron()
						{ wording.OnThisPage.In(lang) }
					</summary>
					@tocList(v, lang)
				</details>
			}
			// This block sits between the title and the first sentence, so it
			// folds like the contents above it and states only its count.
			if v.diagCount() > 0 {
				<details class="y-toc-inline">
					<summary class="y-toc-inline__summary">
						@chevron()
						{ wording.NoteHealth.In(lang) }
						<span class="y-diagcount">{ strconv.Itoa(v.diagCount()) }</span>
					</summary>
					@diagnostics(v, lang)
				</details>
			}
			// A fact about the library rather than a decoration the narrow
			// layout can drop, so it folds like the two above it.
			if v.citedByShown() {
				<details class="y-toc-inline">
					<summary class="y-toc-inline__summary">
						@chevron()
						{ wording.CitedBy.In(lang) }
						if len(v.CitedBy) > 0 {
							<span class="y-diagcount">{ strconv.Itoa(len(v.CitedBy)) }</span>
						}
					</summary>
					@citedByBlock(v, lang)
				</details>
			}
		</div>
	}
}

// statusPanel is the rail status face: one plain POST form per legal
// transition, needing no script — a single press for a target the reader can
// walk back from, a two-step confirm for a no-return one. The legal set is only
// what the contract returns, never a fabricated key, and an empty set is stated
// by its reason: the knowledge layer that withheld it, or the schema that
// defines nothing onward.
templ statusPanel(v NoteView, lang wording.Lang) {
	if v.showsStatusFace() {
		{{ face := statusFace(&v) }}
		<section class="y-statuspanel" data-status-state={ face.token() }>
			if face == faceNonInstance {
				<p class="y-statuspanel__notice">{ wording.NonInstanceReason.In(lang) }</p>
			} else {
				<div class="y-statuspanel__head">
					<div class="y-statuspanel__row">
						<span class="ui-side__label">{ wording.StatusLabel.In(lang) }</span>
					</div>
					if v.Status != "" {
						<span class={ "ui-status", "ui-status--" + v.Status }>{ v.Status }</span>
					}
				</div>
				switch face {
					case faceWriteUnavailable:
						<p class="y-statuspanel__notice">
							@browserDiagnostic(wording.WriteFaceUnavailable.In(lang), v.WriteDiagnostic)
						</p>
					case faceNoFrontmatter:
						<p class="y-statuspanel__notice">{ wording.NoFrontmatter.In(lang) }</p>
					case faceStatusUnknown:
						@statusUnknownFlag(v, "y-statuspanel__notice", lang)
					case faceStatusUnreadable:
						@statusUnreadableFlag(v, "y-statuspanel__notice", lang)
					case faceOutsideScope:
						<p class="y-statuspanel__notice">{ wording.OutsideKnowledgeScope.In(lang) }</p>
					case faceNoTransitions:
						<p class="y-statuspanel__notice">{ wording.NoLegalTransitions.In(lang) }</p>
						<p class="y-statuspanel__notice">{ frontmatterDoorLine(&v, lang) }</p>
					default:
						<div class="y-statuspanel__forms">
							@legalTransitionForms(v, lang)
						</div>
				}
				@schemaNotices(v, lang)
			}
		</section>
	}
}

// schemaNotices states what the schema made of this note's frontmatter. A
// schema fault is not an alternative to the status notice above — a note can
// carry both at once — so these are said alongside, each naming its own field.
// The block carries the id the transition submits describe themselves by and
// renders only where there is a finding, so id and references appear together.
templ schemaNotices(v NoteView, lang wording.Lang) {
	if len(v.SchemaNotices) > 0 {
		<div id={ schemaNoticesID }>
			for _, notice := range v.SchemaNotices {
				<p class="y-statuspanel__notice y-statusflag">
					for _, part := range notice {
						if part.Code {
							<code>{ part.Text }</code>
						} else {
							{ part.Text }
						}
					}
				</p>
			}
		</div>
	}
}

// statusUnknownFlag states that the note's status value is outside the
// contract's declared list. It replaces the empty-transitions notice, which
// would imply the contract defines nothing onward from a value it never
// defined.
templ statusUnknownFlag(v NoteView, noticeClass string, lang wording.Lang) {
	<p class={ noticeClass, "y-statusflag" }>{ wording.StatusValuePrefix.In(lang) }<code>{ v.Status }</code> { wording.StatusOutsideList.In(lang) }</p>
}

// statusUnreadableFlag states that this note's frontmatter yielded no status to
// govern by. The frontmatter parsed and carries keys, so the diagnostics face
// has nothing to report; the status is absent or written as a shape no single
// value can be read out of, and the repair is the same either way.
templ statusUnreadableFlag(v NoteView, noticeClass string, lang wording.Lang) {
	<p class={ noticeClass, "y-statusflag" }>{ wording.StatusUnreadable.In(lang) }{ frontmatterDoorLine(&v, lang) }</p>
}

// transitionForm is one transition control: a plain POST form whose re-rendered
// status chip after the redirect is the whole confirmation. The hidden content
// identity states which version of the note the reader saw, so the write face
// can refuse a press that outlived the content.
//
// A target the reader can walk back from is a quiet single press; a no-return
// one keeps its submit behind a closed native disclosure, whose first
// interaction states what is lost and whose second submits. No script is
// involved, so a reader without JavaScript walks the same two steps.
templ transitionForm(v NoteView, t Transition, lang wording.Lang) {
	<form class="y-statusform" method="post" action="/status">
		<input type="hidden" name="path" value={ v.RelPath }/>
		<input type="hidden" name="from" value={ v.Status }/>
		<input type="hidden" name="to" value={ t.To }/>
		<input type="hidden" name="content_identity" value={ v.ContentIdentity }/>
		if t.NoReturn {
			<details class="y-statusconfirm">
				<summary class="y-xbtn y-statusconfirm__summary" aria-label={ wording.NoReturnSummaryBefore.In(lang) + t.To + wording.NoReturnSummaryAfter.In(lang) }>{ t.To }</summary>
				<p class="y-statusconfirm__note">{ wording.NoReturnTargetBefore.In(lang) }{ t.To }{ wording.NoReturnTargetAfter.In(lang) }</p>
				<button class="y-xbtn y-statusconfirm__submit" type="submit" { schemaNoticesRef(&v)... }>{ wording.ConfirmSetBefore.In(lang) }{ t.To }{ wording.ConfirmSetAfter.In(lang) }</button>
			</details>
		} else {
			<button class="y-xbtn" type="submit" { schemaNoticesRef(&v)... }>{ t.To }</button>
		}
	</form>
}

// legalTransitionForms renders the complete schema-provided set for either
// status face.
templ legalTransitionForms(v NoteView, lang wording.Lang) {
	for _, t := range v.Transitions {
		@transitionForm(v, t, lang)
	}
}

// fragmentSplit states how a link that named a section was read, for a link
// whose base name resolved to nothing. Its words say the missing half is the
// note, which is false of a link whose note was found and whose section was
// not, so the caller gates it on the kind rather than on a section name being
// present.
templ fragmentSplit(target, section string, lang wording.Lang) {
	<p class="y-diag__split">
		{ wording.LinkSplitBefore.In(lang) }<code>{ target }</code>{ wording.LinkSplitBetween.In(lang) }<code>{ section }</code>{ wording.LinkSplitAfter.In(lang) }
		{ fmt.Sprintf(wording.LinkMissingHalfIsTheNote.In(lang), target) }
	</p>
}

// diagnostics is the read-only diagnostics rail: the frontmatter diagnostic and
// every render diagnostic, stated but never repaired.
templ diagnostics(v NoteView, lang wording.Lang) {
	if v.Diagnostic != "" || len(v.RenderDiagnostics) > 0 {
		<section>
			<div class="ui-side__label y-diaghead">
				{ wording.NoteHealth.In(lang) }
				<span class="y-diagcount">{ strconv.Itoa(v.diagCount()) }</span>
			</div>
			<div class="y-diaglist">
				if v.Diagnostic != "" {
					<div class="y-diag">
						<div class="y-diag__label">frontmatter</div>
						<p class="y-diag__body">
							@browserDiagnostic(wording.FrontmatterNotYAML.In(lang), v.Diagnostic)
						</p>
					</div>
				}
				for _, d := range v.RenderDiagnostics {
					<div class="y-diag">
						<div class="y-diag__label">{ diagKindLabel(d.Kind, lang) }</div>
						<p class="y-diag__body">
							{ renderDiagnosticSummary(d.Kind, lang) }
							if d.Target != "" {
								<code>{ diagnosticAddress(&d) }</code>
							}
							if d.Message != "" {
								<code lang="en">{ d.Message }</code>
							}
						</p>
						if d.Kind == render.DiagWikilinkBroken && d.Section != "" {
							@fragmentSplit(d.Target, d.Section, lang)
						}
					</div>
				}
			</div>
			<p class="y-diag__note">{ wording.ReportsOnlyNote.In(lang) }</p>
		</section>
	}
}

// statusBar is the status face at every width where the right rail is absent:
// narrow viewports hide the rail, and a note with no reading aids drops its
// column. It mirrors the status panel's states, so the write face always has
// somewhere to appear. A frontmatter diagnostic suppresses governance state,
// no status having been parsed; a non-instance stays named, that classification
// coming from its path.
templ statusBar(v NoteView, lang wording.Lang) {
	if v.showsStatusFace() {
		{{ face := statusFace(&v) }}
		<div class="y-sealbar" data-status-state={ face.token() }>
			switch face {
				case faceNonInstance:
					<p class="y-sealbar__notice">{ wording.NonInstanceReason.In(lang) }</p>
				case faceWriteUnavailable:
					<p class="y-sealbar__notice">
						@browserDiagnostic(wording.WriteFaceUnavailable.In(lang), v.WriteDiagnostic)
					</p>
				case faceNoFrontmatter:
					<p class="y-sealbar__notice">{ wording.NoFrontmatter.In(lang) }</p>
				case faceStatusUnknown:
					<span class={ "ui-status", "ui-status--" + v.Status }>{ v.Status }</span>
					<span class="y-sealbar__spacer"></span>
					@statusUnknownFlag(v, "y-sealbar__notice", lang)
				case faceStatusUnreadable:
					@statusUnreadableFlag(v, "y-sealbar__notice", lang)
				case faceOutsideScope:
					<span class={ "ui-status", "ui-status--" + v.Status }>{ v.Status }</span>
					<span class="y-sealbar__spacer"></span>
					<p class="y-sealbar__notice">{ wording.OutsideKnowledgeScope.In(lang) }</p>
				case faceNoTransitions:
					<span class={ "ui-status", "ui-status--" + v.Status }>{ v.Status }</span>
					<span class="y-sealbar__spacer"></span>
					<p class="y-sealbar__notice">{ wording.NoLegalTransitions.In(lang) }{ frontmatterDoorLine(&v, lang) }</p>
				default:
					if v.Status != "" {
						<span class={ "ui-status", "ui-status--" + v.Status }>{ v.Status }</span>
					}
					<span class="y-sealbar__spacer"></span>
					@legalTransitionForms(v, lang)
			}
		</div>
	}
}

// flipReceipt states the transition this reading arrived from, in words rather
// than by a recoloured chip a reader may not see at all. It is a live region,
// and the first thing in the main column, so it reaches a reader on arrival.
//
// The sentence is doubly gated before it reaches this template: the reported
// move is one the contract legalises from the status the note carries now, and
// the write face held an unspent receipt for it, spent by this render. So it
// appears once, and reaching the same address again states nothing.
templ flipReceipt(v NoteView, lang wording.Lang) {
	if v.showsFlipReceipt() {
		<p class="y-flipreceipt" role="status">
			{ wording.FlipReceiptBefore.In(lang) }<code lang="en">{ v.FlippedFrom }</code>{ wording.FlipReceiptBetween.In(lang) }<code lang="en">{ v.Status }</code>{ wording.FlipReceiptAfter.In(lang) }
			if v.FlipNoReturn {
				{ frontmatterDoorLine(&v, lang) }
			}
		</p>
	}
}
