package pages

import (
	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// Folder lists one level of the vault's directories. It is a reading page, not
// a file manager: no sizes, no dates, no sorting controls, just the order the
// folder is in.
//
// It carries no left rail. A shelf page is the listing itself, and a rail
// beside it would be that listing a second time, in a narrower column.
templ Folder(v FolderView, c layouts.Chrome) {
	@layouts.Base(c) {
		<main id="main-content" tabindex="-1" class="y-main y-deskmain">
			<div class="y-home">
				<header class="y-home__head">
					if len(v.Crumbs) > 0 {
						<div class="y-crumbs">
							for i, crumb := range v.Crumbs {
								if i > 0 {
									<span class="y-crumbs__sep" aria-hidden="true">·</span>
								}
								<a class="y-crumbs__link" href={ templ.URL(folderHref(crumb.RelPath)) }>{ crumb.Name }</a>
							}
						</div>
					}
					<h1 class="y-title">{ v.Shelf.Title }</h1>
					<p class="y-foldercount">{ v.Count }</p>
					<a class="y-back" href={ templ.URL(indexHref(folderMode)) }>{ wording.BackToFolders.In(c.Lang) }</a>
				</header>
				if len(v.Shelf.Rows) == 0 {
					<p class="y-homeempty" data-index-empty>{ v.Shelf.Empty }</p>
				}
				@ShelfPage(v.Shelf)
			</div>
		</main>
	}
}
