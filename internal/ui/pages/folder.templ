package pages

import (
	"github.com/koopa0/yomihon/internal/nav"
	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// Folder lists one level of the vault's directories. Its sidebar is the
// library, which holds the top-level folders; the list here is the level the
// reader chose.
templ Folder(v FolderView, c layouts.Chrome) {
	@layouts.Base(c) {
		<div class="y-nav-scrim" data-nav-close></div>
		<div class="y-shell2">
			@sidebar(v.Sidebar, c)
			<main id="_y-main" tabindex="-1" class="y-main y-deskmain">
				<div class="y-home">
					<header class="y-home__head">
						@crumbTrail(v.Crumbs, c.Lang)
						<h1 class="y-title">{ v.Title }</h1>
						if v.Cover.HTML != "" {
							<div class="y-cover">
								@templ.Raw(v.Cover.HTML)
								if v.Cover.ReadHref != "" {
									<a class="y-cover__more" href={ templ.URL(v.Cover.ReadHref) }>{ wording.ReadInFull.In(c.Lang) }</a>
								}
							</div>
						}
					</header>
					@ListView(v.List, c.Lang)
				</div>
			</main>
		</div>
	}
}

// crumbTrail is the way up from a folder: the vault, then each folder above.
templ crumbTrail(crumbs []nav.NoteRef, lang wording.Lang) {
	if len(crumbs) > 0 {
		<nav class="y-crumbs" aria-label={ wording.Folders.In(lang) }>
			for i, crumb := range crumbs {
				if i > 0 {
					<span class="y-crumbs__sep" aria-hidden="true">›</span>
				}
				<a class="y-crumbs__link" href={ templ.URL(crumbHref(crumb.RelPath)) }>{ crumb.Name }</a>
			}
		</nav>
	}
}
