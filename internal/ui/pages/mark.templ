package pages

import "github.com/koopa0/yomihon/internal/wording"

// continueRow is the desk's way back to the place the reader kept, and the
// largest thing on it: the reader came back for this place, so its name is set
// at the size a page's own title is, with where it sits above it and the
// heading the mark was kept under below. The way back is one link, the
// bookmark leading the verb, drawn as the course page draws its own. The title
// is not a second link: the desk offers exactly one way back.
//
// A row whose note is gone is a sentence and offers no link.
templ continueRow(row ContinueRow, lang wording.Lang) {
	if row.Show {
		<section class="y-continue" data-home-continue aria-labelledby="home-continue-title">
			<p class="y-offscreen">{ wording.MarkKeptHere.In(lang) }</p>
			if row.Kicker != "" {
				<p class="y-continue__kicker" { authoredLanguageAttrs(row.KickerLanguage)... }>{ row.Kicker }</p>
			}
			<h2 class="y-continue__title" id="home-continue-title" { authoredLanguageAttrs(row.Language)... }>{ row.Title }</h2>
			if row.Section.Text != "" {
				<p class="y-continue__section" { authoredLanguageAttrs(row.Section.Language)... }>{ row.Section.Text }</p>
			}
			if row.Href != "" {
				<a class="y-continue__note" href={ templ.URL(row.Href) } aria-describedby="home-continue-title" data-continue-link>
					<span class="y-keptmark" aria-hidden="true"></span>
					<span class="y-cover__verb">{ wording.ContinueReading.In(lang) }</span>
				</a>
			}
			if row.Notice != "" {
				<p class="y-continue__notice">{ row.Notice }</p>
			}
			<p class="y-continue__device">{ wording.MarkPerDevice.In(lang) }</p>
		</section>
	}
}

// keptPlace marks the one note or lesson the reader left off in, wherever a
// list of them is drawn: a bookmark for the eye and the words for a reader who
// is listening. It is one element, so a row laying out its children sees one
// item and not two.
templ keptPlace(lang wording.Lang) {
	<span class="y-keptplace">
		<span class="y-keptmark" aria-hidden="true"></span>
		<span class="y-offscreen">{ wording.MarkKeptHere.In(lang) }</span>
	</span>
}
