package pages

import (
	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// markControl is the reader's own verb on a reading page: keep this place, so
// the desk can offer it back. It sits beside the status panel because both are
// verbs and the rest of the rail is reading matter, and ahead of it because
// this one is the reader's while that one is the author's.
//
// Where the place already kept is in this note, the button is drawn with the
// reader's bookmark — the stylesheet reads data-mark-kept for it — and the
// sentence the press answers with is there for a reader who cannot see it.
//
// It renders only where a script is running. The gate is not a missing
// fallback: what the control sends is where the window is, and a browser with
// no script has no such thing to send. Everything else on this page works
// without one.
templ markControl(v NoteView, lang wording.Lang) {
	if v.offersMark() {
		<section
			class="y-markset"
			data-mark-control
			data-mark-path={ v.RelPath }
			data-mark-identity={ v.ContentIdentity }
			data-mark-endpoint={ v.MarkAddress }
			data-mark-saved={ wording.MarkSaved.In(lang) }
			data-mark-failed={ wording.MarkNotStored.In(lang) }
			data-mark-kept?={ v.PlaceKept }
		>
			<button type="button" class="y-xbtn" data-mark-button>{ wording.MarkSetControl.In(lang) }</button>
			if v.PlaceKept {
				<span class="y-offscreen">{ wording.MarkSaved.In(lang) }</span>
			}
			<p class="y-markset__note">{ wording.MarkPerDevice.In(lang) }</p>
			@layouts.Reply("y-markset__said", templ.Attributes{"data-mark-said": true})
		</section>
	}
}

// continueRow returns the reader to the place they kept. It is one row rather
// than a block: there is one mark, and a list of one is a list the reader has
// to read before finding it holds nothing they did not already know.
//
// The link is drawn with the reader's bookmark. The heading over it already
// says what it is, so the bookmark is decoration here.
templ continueRow(row ContinueRow, lang wording.Lang) {
	if row.Show {
		<section class="y-continue" data-home-continue aria-labelledby="home-continue-title">
			<h2 class="ui-side__label" id="home-continue-title">{ wording.ContinueReading.In(lang) }</h2>
			if row.Href != "" {
				<a class="y-continue__note" href={ templ.URL(row.Href) } data-continue-link>
					<span class="y-keptmark" aria-hidden="true"></span>
					{ row.Title }
				</a>
			} else {
				<span class="y-continue__note">{ row.Title }</span>
			}
			if row.Notice != "" {
				<p class="y-continue__notice">{ row.Notice }</p>
			}
			<p class="y-continue__device">{ wording.MarkPerDevice.In(lang) }</p>
		</section>
	}
}

// keptPlace marks the one note or lesson the reader left off in, wherever a
// list of them is drawn: a bookmark for the eye and the words for a reader who
// is listening. It is one element, so a row laying out its children sees one
// item and not two.
templ keptPlace(lang wording.Lang) {
	<span class="y-keptplace">
		<span class="y-keptmark" aria-hidden="true"></span>
		<span class="y-offscreen">{ wording.MarkKeptHere.In(lang) }</span>
	</span>
}
