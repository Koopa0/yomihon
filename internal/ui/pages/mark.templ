package pages

import "github.com/koopa0/yomihon/internal/wording"

// continueRow is the desk's way back to the place the reader kept, and the
// largest thing on it: the reader came back for this place, so it is set as a
// plate lifted off the desk, the bookmark's ribbon hanging from its top edge,
// with what it is and where it sits above its name, the heading the mark was
// kept under below, and the one way back under both. The title is not a second
// link: the desk offers exactly one way back.
//
// The line over the name says what the plate is — the bookmark — then where
// the note sits and how long ago the bookmark was added; the heading it was
// added under is said as where the reader stopped, in the interface's words
// round the author's.
//
// A row whose note is gone is a sentence and offers no link.
templ continueRow(row ContinueRow, lang wording.Lang) {
	if row.Show {
		<section class="y-continue" data-home-continue aria-labelledby="home-continue-title">
			// The ribbon is the bookmark lying in a note that is there to open; a
			// row whose note is gone is a sentence and wears none.
			if row.Href != "" {
				<svg class="y-continue__ribbon" width="14" height="34" viewBox="0 0 14 34" aria-hidden="true" focusable="false">
					<path class="y-continue__ribbonface" d="M0 0H14V34L7 27.5L0 34Z"></path>
					<path class="y-continue__ribbonedge" d="M2 0V30M12 0V30"></path>
				</svg>
			}
			<div class="y-continue__head">
				<p class="y-continue__tag">{ wording.BookmarkLabel.In(lang) }</p>
				if row.Kicker != "" {
					<p class="y-continue__kicker" { authoredLanguageAttrs(row.KickerLanguage)... }>{ row.Kicker }</p>
				}
				if row.Age != "" {
					<p class="y-continue__age"><time datetime={ row.AgeAt }>{ row.Age }</time></p>
				}
			</div>
			<h2 class="y-continue__title" id="home-continue-title" { authoredLanguageAttrs(row.Language)... }>{ row.Title }</h2>
			if row.Section.Text != "" {
				{{ before, after := around(wording.StoppedAtFmt, lang) }}
				<p class="y-continue__section">{ before }<span class="y-continue__place" { authoredLanguageAttrs(row.Section.Language)... }>{ row.Section.Text }</span>{ after }</p>
			}
			if row.Notice != "" {
				<p class="y-continue__notice">{ row.Notice }</p>
			}
			if row.Href != "" {
				<a class="y-continue__note" href={ templ.URL(row.Href) } aria-describedby="home-continue-title" data-continue-link>
					<span class="y-cover__verb">{ wording.ContinueReading.In(lang) }</span>
					<span class="y-continue__arrow" aria-hidden="true">→</span>
				</a>
			}
			<p class="y-continue__device">{ wording.BookmarkPerDevice.In(lang) }</p>
		</section>
	}
}

// keptPlace marks the one note or lesson the reader left off in, wherever a
// list of them is drawn: a bookmark for the eye and the words for a reader who
// is listening. It is one element, so a row laying out its children sees one
// item and not two.
templ keptPlace(lang wording.Lang) {
	<span class="y-bookmark">
		<span class="y-bookmark__ribbon" aria-hidden="true"></span>
		<span class="y-offscreen">{ wording.BookmarkKeptHere.In(lang) }</span>
	</span>
}
