package pages

import "github.com/koopa0/yomihon/internal/wording"

// continueRow returns the reader to the place they kept. It is one row rather
// than a block: there is one mark, and a list of one is a list the reader has
// to read before finding it holds nothing they did not already know.
//
// The link is drawn with the reader's bookmark. The heading over it already
// says what it is, so the bookmark is decoration here.
templ continueRow(row ContinueRow, lang wording.Lang) {
	if row.Show {
		<section class="y-continue" data-home-continue aria-labelledby="home-continue-title">
			<h2 class="ui-side__label" id="home-continue-title">{ wording.ContinueReading.In(lang) }</h2>
			if row.Href != "" {
				<a class="y-continue__note" href={ templ.URL(row.Href) } data-continue-link>
					<span class="y-keptmark" aria-hidden="true"></span>
					{ row.Title }
				</a>
			} else {
				<span class="y-continue__note">{ row.Title }</span>
			}
			if row.Notice != "" {
				<p class="y-continue__notice">{ row.Notice }</p>
			}
			<p class="y-continue__device">{ wording.MarkPerDevice.In(lang) }</p>
		</section>
	}
}

// keptPlace marks the one note or lesson the reader left off in, wherever a
// list of them is drawn: a bookmark for the eye and the words for a reader who
// is listening. It is one element, so a row laying out its children sees one
// item and not two.
templ keptPlace(lang wording.Lang) {
	<span class="y-keptplace">
		<span class="y-keptmark" aria-hidden="true"></span>
		<span class="y-offscreen">{ wording.MarkKeptHere.In(lang) }</span>
	</span>
}
