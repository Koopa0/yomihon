package pages

import (
	"github.com/koopa0/yomihon/internal/nav"
	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// ListIndex is one mode's own page: everything the vault declares of that kind,
// one line each. It carries no left rail — the rail is the thing being read,
// and a list beside a copy of itself is a second organisation of the same
// notes.
templ ListIndex(v ListIndexView, c layouts.Chrome) {
	@layouts.Base(c) {
		<main id="main-content" tabindex="-1" class="y-main y-deskmain" data-index={ v.Mode }>
			<div class="y-home">
				@indexHead(v.Kicker, v.Shelf.Title, v.Shelf.Lede, c.Lang)
				if v.Fault != "" {
					@indexFault(v.Fault, c)
				} else if len(v.Shelf.Rows) == 0 && v.Shelf.Empty != "" {
					<p class="y-homeempty" data-index-empty>{ v.Shelf.Empty }</p>
				}
				@ShelfPage(v.Shelf)
			</div>
		</main>
	}
}

// FolderIndex is the folder mode's page: the directory tree itself, which is
// the one mode whose contents are not a list. Every folder is a closed
// disclosure carrying what it holds, so the page opens at the shape of the
// vault rather than at all of it.
templ FolderIndex(v FolderIndexView, c layouts.Chrome) {
	@layouts.Base(c) {
		<main id="main-content" tabindex="-1" class="y-main y-deskmain" data-index={ v.Mode }>
			<div class="y-home">
				@indexHead(v.Kicker, v.Title, v.Lede, c.Lang)
				if v.Fault != "" {
					@indexFault(v.Fault, c)
				}
				if len(v.RootNotes) == 0 && len(v.Folders) == 0 {
					if v.Fault == "" {
						<p class="y-homeempty" data-index-empty>{ v.Empty }</p>
					}
				} else {
					<nav class="y-foldertree" aria-label={ wording.Folders.In(c.Lang) }>
						for _, n := range v.RootNotes {
							<a class="ui-navitem" href={ templ.URL(notesHref(n.RelPath)) }>{ n.Name }</a>
						}
						for _, f := range v.Folders {
							@folderIndexNode(f, c)
						}
					</nav>
				}
				// What changed last and where every note sits are questions
				// about how the shelf is kept, so they are answered in the mode
				// that browses by position rather than on the desk a reader
				// arrives at to read something.
				<div class="y-homegrid y-shelfblocks">
					if v.ShowRecent {
						<section class="y-homeblock y-homeblock--recent" data-home-block="recent" aria-labelledby="folders-recent-title">
							@homeBlockHead("folders-recent-title", recentTitle(&v, c.Lang), recentLede(&v, c.Lang))
							<div class="y-homerecent">
								for _, n := range v.Recent {
									<a class="y-homenote" href={ templ.URL(notesHref(n.RelPath)) } data-home-recent-note>
										<span class="y-homenote__main">
											<span class="y-homenote__title">{ n.Title }</span>
											<span class="y-homenote__path">{ n.RelPath }</span>
										</span>
										<span class="y-homenote__meta">
											if n.Status != "" {
												<span class={ "ui-status", "ui-status--" + n.Status }>{ n.Status }</span>
												if n.StatusOutsideEnum {
													@statusOutsideEnumMark(c.Lang)
												}
											}
											if n.Modified != "" {
												<time datetime={ n.ModifiedAt }>{ n.Modified }</time>
											}
										</span>
									</a>
								}
							</div>
						</section>
					}
					if v.ShowLifecycle {
						<section class="y-homeblock y-homeblock--lifecycle" data-home-block="lifecycle" aria-labelledby="folders-lifecycle-title">
							@homeBlockHead("folders-lifecycle-title", wording.HomeLifecycleTitle.In(c.Lang), wording.HomeLifecycleLede.In(c.Lang))
							<div class="y-homechips">
								for _, it := range v.Lifecycle {
									<a class={ "y-homechip", templ.KV("y-homechip--unknown", it.Unknown) } href={ templ.URL(statusHref(it.Name)) }>
										@lifecycleChipBody(it, c.Lang)
									</a>
								}
							</div>
							if len(v.Unstated) > 0 {
								<div class="y-homeunstated">
									for _, it := range v.Unstated {
										if it.Href == "" {
											<span class="y-homeunstated__cell">
												@unstatedChipBody(it, c.Lang)
											</span>
										} else {
											<a class="y-homeunstated__cell" href={ templ.URL(it.Href) }>
												@unstatedChipBody(it, c.Lang)
											</a>
										}
									}
								</div>
								<p class="y-homeblock__note">{ wording.LifecycleUnstatedNote.In(c.Lang) }</p>
							}
						</section>
					}
				</div>
			</div>
		</main>
	}
}

// folderIndexNode is one folder of the index tree: a closed disclosure whose
// summary names the folder, says how much is under it, and reaches the folder's
// own page. It recurses to whatever depth the directory structure has.
templ folderIndexNode(f nav.Folder, c layouts.Chrome) {
	<details>
		<summary class="ui-navitem">
			@chevron()
			{ f.Name }
			<span class="ui-navitem__count">{ folderNoteCount(&f, c.Lang) }</span>
		</summary>
		<div class="y-tree">
			<a class="y-railitem__full" href={ templ.URL(folderHref(f.RelPath)) }>{ wording.OpenFolder.In(c.Lang) }</a>
			for _, sub := range f.Subfolders {
				@folderIndexNode(sub, c)
			}
			for _, n := range f.Notes {
				<a class="ui-navitem" href={ templ.URL(notesHref(n.RelPath)) }>{ n.Name }</a>
			}
		</div>
	</details>
}

// indexHead is the head every mode index carries: what the mode is called and
// how much of it there is, the title, and the sentence saying what a reader is
// looking at.
templ indexHead(kicker, title, lede string, lang wording.Lang) {
	<header class="y-home__head">
		<div class="y-home__kicker">{ kicker }</div>
		<h1 class="y-title">{ title }</h1>
		<p>{ lede }</p>
		<a class="y-back" href="/">{ wording.BackHome.In(lang) }</a>
	</header>
}

// indexFault states, in the one shape every surface uses for it, why a
// projection this page would have listed is unavailable.
templ indexFault(fault string, c layouts.Chrome) {
	<section class="y-homeblock y-homeblock--faults" data-home-block="faults" aria-labelledby="index-faults-title">
		@homeBlockHead("index-faults-title", wording.HomeFaultsTitle.In(c.Lang), wording.HomeFaultsLede.In(c.Lang))
		<p class="y-homeempty" data-home-fault>
			@browserDiagnostic(wording.HomeFaultsBrowser.In(c.Lang), fault)
		</p>
	</section>
}
