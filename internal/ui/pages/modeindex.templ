package pages

import (
	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// ListIndex is one mode's own page: everything the vault declares of that kind,
// one line each. It carries no left rail — the rail is the thing being read,
// and a list beside a copy of itself is a second organisation of the same
// notes. Anything a mode has beyond its listing follows it as children, which
// is how one mode can say more without a second page shape existing.
templ ListIndex(v ListIndexView, c layouts.Chrome) {
	@layouts.Base(c) {
		<main id="_y-main" tabindex="-1" class="y-main y-deskmain" data-index={ v.Mode }>
			<div class="y-home">
				@indexHead(v.Count, v.Shelf.Title, v.Shelf.Lede, c.Lang)
				if v.Notice != "" {
					@nothingToShow(nothingNotice{Kind: v.Mode, Fault: true}) {
						<p>{ v.Notice }</p>
					}
				}
				if v.Fault != "" || v.Restart != "" {
					@indexFault(v.Fault, v.Restart, c)
				} else if len(v.Shelf.Rows) == 0 && v.Shelf.Empty != "" {
					<p class="y-homeempty" data-index-empty>{ v.Shelf.Empty }</p>
				}
				@ShelfPage(v.Shelf)
				{ children... }
			</div>
		</main>
	}
}

// FolderIndex is the folder mode's page: the same listing every mode gets, and
// under it what a reader asks about how the shelf is kept: what changed last.
// That describes how the files are kept, which is a different question from what there is to read, so they are
// answered in the mode that browses by position rather than on the desk a
// reader arrives at to read something.
templ FolderIndex(v ListIndexView, recent RecentBlock, c layouts.Chrome) {
	@ListIndex(v, c) {
		@shelfKeeping(recent, c)
	}
}

// shelfKeeping is the block under the folder listing. It draws only when it
// has something to say: a folder holding no indexed note has no recent list.
templ shelfKeeping(recent RecentBlock, c layouts.Chrome) {
	if len(recent.Notes) > 0 {
		<div class="y-homegrid y-shelfblocks">
			if len(recent.Notes) > 0 {
				<section class="y-homeblock y-homeblock--recent" data-home-block="recent" aria-labelledby="folders-recent-title">
					@homeBlockHead("folders-recent-title", recent.Title, recent.Lede)
					<div class="y-homerecent">
						for _, n := range recent.Notes {
							<a class="y-homenote" href={ templ.URL(notesHref(n.RelPath)) } data-home-recent-note>
								<span class="y-homenote__main">
									<span class="y-homenote__title" { authoredLanguageAttrs(n.Language)... }>{ n.Title }</span>
									<span class="y-homenote__path">{ n.RelPath }</span>
								</span>
								<span class="y-homenote__meta">
									if n.Draft {
										<span class="ui-status">{ wording.Draft.In(c.Lang) }</span>
									}
									if n.Modified != "" {
										<time datetime={ n.ModifiedAt }>{ n.Modified }</time>
									}
								</span>
							</a>
						}
					</div>
				</section>
			}
		</div>
	}
}

// indexHead is the head every mode index carries: the mode's name, how much of
// it there is as one quiet fact under the name, and — when the listing needs
// one — the sentence saying what a reader is looking at. A withheld page has no
// count to print, and an empty count is not written.
templ indexHead(count, title, lede string, lang wording.Lang) {
	<header class="y-home__head">
		<h1 class="y-title">{ title }</h1>
		if count != "" {
			<p class="y-indexcount">{ count }</p>
		}
		if lede != "" {
			<p>{ lede }</p>
		}
		<a class="y-back" href="/">{ wording.BackHome.In(lang) }</a>
	</header>
}

// indexFault states, in the one shape every surface uses for it, why a
// projection this page would have listed is unavailable. The fault is the
// contract's own sentence, quoted; the restart is the dictionary's sentence for
// a cause with words of its own, and takes the place of a quotation rather than
// sitting beside one.
templ indexFault(fault, restart string, c layouts.Chrome) {
	<section class="y-homeblock y-homeblock--faults" data-home-block="faults" aria-labelledby="index-faults-title">
		@homeBlockHead("index-faults-title", wording.HomeFaultsTitle.In(c.Lang), wording.HomeFaultsLede.In(c.Lang))
		<p class="y-homeempty" data-home-fault>
			if restart != "" {
				@browserDiagnostic(restart, "")
			}
			if fault != "" {
				@browserDiagnostic(wording.HomeFaultsBrowser.In(c.Lang), fault)
			}
		</p>
	</section>
}
