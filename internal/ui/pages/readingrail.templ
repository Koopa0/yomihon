package pages

import (
	"github.com/koopa0/yomihon/internal/nav"
	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// readingRail is the narrow left navigation on a reading surface: one map
// chosen by what is being read, never by the address the reader arrived from.
templ readingRail(rr ReadingRail, c layouts.Chrome) {
	<aside class="y-rail-left" id="nav-rail" aria-label={ wording.LibraryNavigation.In(c.Lang) } data-reading-rail={ string(rr.Kind) }>
		@railHead(c, true)
		<div class="y-railbody" id="nav-rail-body">
			<p class="y-filter-empty" data-filter-empty hidden>{ wording.FilterNoMatch.In(c.Lang) }</p>
			<p class="y-filter-partial" data-filter-partial data-filter-partial-one={ wording.FilterPartialOne.In(c.Lang) } data-filter-partial-many={ wording.FilterPartialMany.In(c.Lang) } data-filter-searchall={ wording.FilterSearchAll.In(c.Lang) } hidden></p>
			if rr.Model != nil {
				if faults := rr.CapabilityFaults(c.Lang); len(faults) > 0 {
					<div class="y-railsep" aria-hidden="true"></div>
					<section class="y-navdiag" data-sidebar-group="navigation-diagnostics" aria-labelledby="sidebar-navigation-diagnostics-title">
						<h2 class="y-railsummary y-railsummary--label" id="sidebar-navigation-diagnostics-title">{ wording.PathsAndMaps.In(c.Lang) }</h2>
						for _, fault := range faults {
							<p>
								@browserDiagnostic(fault.Summary, fault.Detail)
							</p>
						}
					</section>
				}
			}
			switch rr.Kind {
				case ReadingRailBook:
					@bookRail(rr, c)
				case ReadingRailFolder:
					if rr.Model != nil {
						@ShelfRail(rr.HereShelf(c.Lang), railWindow, rr.hereDir, wording.MoreInFolder.In(c.Lang))
					}
				case ReadingRailReports:
					if rr.Model != nil {
						@reportsRail(rr, c)
					}
			}
			@railFoot(rr.Vault, c.Lang)
		</div>
	</aside>
	@settleRail(c)
}

templ bookRail(rr ReadingRail, c layouts.Chrome) {
	if rr.book != nil {
		{{ view := rr.bookView() }}
		<div class="y-railbook" data-book-path={ rr.book.RelPath }>
			<a class="y-railbook__title" href={ templ.URL(syllabusHrefFrom(rr.book.RelPath, rr.CurrentPath)) }>{ rr.book.Title }</a>
			<p class="y-railbook__span">{ plural(view.Parts, wording.PartCountOne, wording.PartCountMany, c.Lang) } · { plural(view.Entries, wording.LessonCountOne, wording.LessonCountMany, c.Lang) }</p>
			for _, sec := range view.Branches {
				@bookRailBranch(rr, c, rr.book.RelPath, nil, sec)
			}
		</div>
	}
}

templ bookRailBranch(rr ReadingRail, c layouts.Chrome, pathRel string, chain []string, sec PathBranchView) {
	<details
		open?={ rr.branchOpen(pathRel, childChain(chain, sec.Heading)) }
		data-book-branch={ branchKey(pathRel, childChain(chain, sec.Heading)) }
		{ disclosureAttrs("bookbranch:"+branchKey(pathRel, childChain(chain, sec.Heading)), rr.branchOpen(pathRel, childChain(chain, sec.Heading)))... }
	>
		<summary class="y-railsummary y-railsummary--label">
			@chevron()
			{ sec.Heading }
		</summary>
		<div class="y-railgroup">
			@bookRailItems(rr, c, pathRel, childChain(chain, sec.Heading), sec)
		</div>
	</details>
}

templ bookRailItems(rr ReadingRail, c layouts.Chrome, pathRel string, chain []string, sec PathBranchView) {
	for _, run := range sec.Runs(c.Lang) {
		if run.Branch != nil {
			@bookRailBranch(rr, c, pathRel, chain, *run.Branch)
		} else {
			for _, entry := range run.Entries {
				@bookRailEntry(c, entry)
			}
		}
	}
}

// bookRailEntry is one row of the book: a lesson the reader can open, or the
// words the course lists where nothing could be opened. The title carries
// whatever language the view holds for it, while the status chip and the
// resolution word beside it stay the interface's. Both branches of the row ask
// the same way, so neither can be left behind; navigation reads a declaration
// only off a target that resolved, so today the second branch has none to carry.
//
// Which row the reader is on is decided where the view is built, so the rail
// reads the answer rather than working it out a second time from the address.
// The row the reader is on does not show its status, which the page states
// itself, but where it would print one it still draws the chip hidden so its
// name wraps where it does on the rows beside it. A lesson at a settled status
// prints none, and the bookmark marks the one lesson the reader left off in.
templ bookRailEntry(c layouts.Chrome, entry PathEntryView) {
	if entry.Kind == nav.EntryResolved {
		<a
			class={ "ui-navitem", templ.KV("is-active", entry.Here) }
			href={ templ.URL(entry.Href) }
			{ currentAttr(entry.Here)... }
		>
			<span class="y-navdot" aria-hidden="true"></span>
			<span { authoredLanguageAttrs(entry.Language)... }>{ entry.Name }</span>
			if entry.Kept {
				@keptPlace(c.Lang)
			}
			if entry.labelled() {
				<span class={ "ui-navitem__count", templ.KV("ui-navitem__count--reserved", entry.Here) }>{ entry.Status }</span>
			}
		</a>
	} else {
		<span
			class="ui-navitem y-navitem--broken"
			data-resolution={ entryResolutionCode(entry.Kind) }
			title={ entryResolutionTitle(entry.Kind, c.Lang) }
		>
			<span class="y-navmark y-navmark--warn" aria-hidden="true">!</span>
			<span { authoredLanguageAttrs(entry.Language)... }>{ entry.Name }</span>
			<span class="ui-navitem__count">{ entryResolutionLabel(entry.Kind, c.Lang) }</span>
		</span>
	}
}

templ reportsRail(rr ReadingRail, c layouts.Chrome) {
	<nav class="y-railreports" aria-label={ wording.Reports.In(c.Lang) } data-reading-reports>
		for _, rep := range rr.Model.Reports() {
			if rep.Briefing {
				<a
					class={ "ui-navitem", templ.KV("is-active", rr.current(rep.RelPath)) }
					href={ templ.URL(reportHref(rep.Name)) }
					{ currentAttr(rr.current(rep.RelPath))... }
				>
					{ ReportLabel(&rep) }
					if rep.Latest {
						<span class="y-navmark y-navmark--newest">{ wording.Newest.In(c.Lang) }</span>
					}
				</a>
			} else {
				<a
					class={ "ui-navitem", templ.KV("is-active", rr.current(rep.RelPath)) }
					href={ templ.URL(notesHref(rep.RelPath)) }
					{ currentAttr(rr.current(rep.RelPath))... }
				>
					{ ReportLabel(&rep) }
				</a>
			}
		}
	</nav>
}
