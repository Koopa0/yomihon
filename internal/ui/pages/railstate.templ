package pages

import (
	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// railHead is the first row of a rail long enough to need narrowing: the
// filter box. It is one row, sticking to the top of the rail's own scroll box,
// so the filter stays where it can be reached while the tree under it scrolls.
//
// The whole row is drawn hidden and the script that settles the rail reveals it
// before the first paint, as it always did the filter: a box that filters
// nothing without script is worse than one that is absent.
templ railHead(c layouts.Chrome) {
	<div class="y-railhead" hidden>
		<input
			class="y-filter"
			type="text"
			placeholder={ wording.FilterNavigation.In(c.Lang) }
			aria-label={ wording.FilterNavigationLabel.In(c.Lang) }
			autocomplete="off"
			spellcheck="false"
			data-nav-filter
			hidden
		/>
	</div>
}

// settleRail applies the same tab-session choices to every navigation rail.
templ settleRail(c layouts.Chrome, filter bool) {
	if filter {
		@railFilterInitializer(c.Nonce)
	}
	// The pre-paint settle reveals the filter box and reapplies the reader's
	// persisted disclosure toggles before the sidebar first paints, so nothing
	// pops in late or replays its opening animation. The wayfinding chain wins
	// over a stored value, and the enhancement script owns every later change.
	<script nonce={ c.Nonce }>
		(() => {
			"use strict";
			const filter = document.querySelector(".y-rail-left [data-nav-filter]");
			if (filter) {
				filter.hidden = false;
			}
			const head = document.querySelector(".y-rail-left .y-railhead");
			if (head) {
				head.hidden = false;
			}
			let stored = {};
			try {
				stored =
					JSON.parse(sessionStorage.getItem("yomihon.nav") || "{}") || {};
			} catch {
				stored = {};
			}
			document
				.querySelectorAll(".y-rail-left details[data-key]")
				.forEach((d) => {
					if (d.hasAttribute("data-chain")) {
						d.open = true;
						return;
					}
					const want = stored[d.dataset.key];
					if (typeof want === "boolean") {
						d.open = want;
					}
				});
		})();
	</script>
	if filter {
		<script nonce={ c.Nonce }>
			(() => {
				"use strict";
				document.querySelector(".y-rail-left")?.railFilterState?.restore();
			})();
		</script>
	}
	// A page change is a whole new document, and a new document's rail starts at
	// its top, so on a long course every click threw the reader's place in the
	// rail away. Where the next page belongs to the same book, or to the same
	// kind of rail, the position it left is put back before anything is painted,
	// and only a current row that is out of the view is then brought in, by the
	// least distance. A different rail, and a reload, start at the top as they
	// always did and bring the current row to the top of the view where it is
	// out of it, which is the rule the stylesheet keeps where scripting is off.
	// It runs after the filter's restore, because a filtered tree is a
	// different height.
	<script nonce={ c.Nonce }>
		(() => {
			"use strict";
			const rail = document.querySelector(".y-rail-left");
			if (!rail) return;
			const id =
				rail.querySelector("[data-book-path]")?.dataset.bookPath ??
				rail.dataset.readingRail ??
				rail.getAttribute("aria-label") ??
				"";
			let kept = null;
			try {
				kept = JSON.parse(sessionStorage.getItem("yomihon.railTop") || "null");
			} catch {
				kept = null;
			}
			const reloaded =
				performance.getEntriesByType("navigation")[0]?.type === "reload";
			const same =
				!reloaded && kept !== null && kept.id === id && Number.isFinite(kept.top);
			if (same) rail.scrollTop = kept.top;
			const row = [...rail.querySelectorAll(".ui-navitem[aria-current='page']")].find(
				(item) => item.getClientRects().length > 0,
			);
			if (row) {
				const box = rail.getBoundingClientRect();
				const top =
					box.top +
					rail.clientTop +
					(Number.parseFloat(getComputedStyle(rail).scrollPaddingTop) || 0);
				const bottom = box.top + rail.clientTop + rail.clientHeight;
				const place = row.getBoundingClientRect();
				if (place.top < top) rail.scrollTop += place.top - top;
				else if (place.bottom > bottom && same) rail.scrollTop += place.bottom - bottom;
				else if (place.bottom > bottom) rail.scrollTop += place.top - top;
			}
			// A folded column is hidden rather than removed, so it keeps the
			// position it had and that is the one kept.
			addEventListener("pagehide", () => {
				try {
					sessionStorage.setItem(
						"yomihon.railTop",
						JSON.stringify({ id, top: rail.scrollTop }),
					);
				} catch {
					// A page without storage keeps nothing; the next one starts at the top.
				}
			});
		})();
	</script>
}
