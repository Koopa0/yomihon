package pages

import (
	"fmt"
	"strconv"

	"github.com/koopa0/yomihon/internal/wording"
)

// ShelfBlock is a shelf at its narrowest: what the organisation is called, how
// much of it there is, its one sentence, and the first few rows that lead
// somewhere. It is a way in rather than a fifth listing, so it ends by handing
// the reader to the shelf's own page instead of going on.
//
// What the block shows and what the shelf holds are different questions. A
// shelf whose rows are all listed without being stops — a course whose lessons
// are none of them written yet — shows no rows here and is not empty, so it
// still says how much it holds and still offers the way on. limit is how many
// rows there is room for; a negative one is read as none.
templ ShelfBlock(s Shelf, id string, limit int, lang wording.Lang) {
	<section class="y-homeblock y-modeblock" data-home-block={ id } aria-labelledby={ "home-" + id + "-title" }>
		<header class="y-homeblock__head">
			<h2 id={ "home-" + id + "-title" }><a href={ templ.URL(s.Href) }>{ s.Title }</a></h2>
			if s.Count != "" {
				<p>{ s.Count }</p>
			}
		</header>
		if s.Lede != "" {
			<p class="y-homeblock__lede">{ s.Lede }</p>
		}
		if len(s.Rows) == 0 {
			if s.Empty != "" {
				<p class="y-homeempty">{ s.Empty }</p>
			}
		} else {
			for _, row := range shelfRows(&s, limit) {
				@shelfRowLink(row)
			}
			<a class="ui-navitem y-shelfall" href={ templ.URL(s.Href) }>{ wording.ShelfAll.In(lang) }</a>
		}
	</section>
}

// ShelfRail is a shelf at the width of the left rail: the one organisation the
// reader is inside, opened at where they are. It shows the neighbourhood rather
// than the shelf — the row being read, what is either side of it, and a way to
// the rest — because a rail that listed a folder of seven hundred entries would
// be the folder rather than an aid to reading one document in it.
//
// The tail says how many it left out rather than only offering the rest. The
// number is the one thing a reader cannot see here: this width draws no measure
// above the rows, so a list that quietly stopped being the folder would look
// exactly like a folder that small. The filter box reads the same number to say
// what it could not search.
//
// more is the sentence for that tail, carrying one number, already in the
// reader's language: how a count reads is the owner's business, and how many
// there are is this width's. dir is the vault path the rows live under, which
// the filter turns into a search over the whole of it; a shelf that is not a
// folder leaves it empty.
templ ShelfRail(s Shelf, limit int, dir, more string) {
	if len(s.Rows) > 0 {
		{{ shown, trimmed := railRows(&s, limit) }}
		<nav class="y-here" aria-label={ s.Title }>
			<a class="y-here__label" href={ templ.URL(s.Href) }>{ s.Title }</a>
			for _, row := range shown {
				<a
					class={ "ui-navitem", templ.KV("is-active", row.Current) }
					href={ templ.URL(row.Href) }
					{ currentAttr(row.Current)... }
				>{ row.Text }</a>
			}
			if trimmed > 0 {
				<a class="y-here__more" href={ templ.URL(s.Href) } data-rail-trimmed={ strconv.Itoa(trimmed) } data-rail-dir={ dir }>{ fmt.Sprintf(more, trimmed) }</a>
			}
		</nav>
	}
}

// shelfRowLink is one row wherever a shelf shows rows as links, so a row cannot
// come to look different for being on a different width.
templ shelfRowLink(row Row) {
	<a class="ui-navitem" href={ templ.URL(row.Href) } data-desk-item>
		{ row.Text }
		if row.Mark != "" {
			<span class={ "ui-navitem__count", templ.KV("ui-navitem__count--warn", row.Fault) }>{ row.Mark }</span>
		}
	</a>
}

// ShelfPage is a shelf unfolded: everything on it, with a heading over each
// division so the page's own contents can reach one. It is the same shelf the
// desk shows a corner of, which is what keeps a block from ever listing
// something its page does not. The name, the measure and the sentence belong to
// the page's own header, which states them once above this.
templ ShelfPage(s Shelf) {
	if len(s.Rows) > 0 {
		<div class="y-list">
			for _, row := range s.Rows {
				@shelfPageRow(row)
			}
		</div>
	}
}

// shelfPageRow is one row at full width. A row that leads nowhere is still
// listed — an unwritten lesson is part of its course — and is written as text
// rather than as a link that goes to the page it is already on.
templ shelfPageRow(row Row) {
	if row.Href == "" {
		<span class="y-row" data-index-row>
			@shelfRowBody(row)
		</span>
	} else {
		<a class="y-row" href={ templ.URL(row.Href) } data-index-row>
			@shelfRowBody(row)
		</a>
	}
}

templ shelfRowBody(row Row) {
	<span class="y-row__title">{ row.Text }</span>
	if row.Mark != "" {
		<span class={ "y-row__measure", templ.KV("y-row__measure--warn", row.Fault) }>{ row.Mark }</span>
	}
}
