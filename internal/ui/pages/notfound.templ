package pages

import (
	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// NotFoundView is what a reader who asked for something that is not here needs
// to see. Asked is the path they typed, echoed back escaped like any other note
// text. Unreadable distinguishes a file that exists and could not be read from a
// path that names nothing. ParsePanic says its bytes opened but could not be
// parsed; Reason carries that parser's words.
type NotFoundView struct {
	Asked      string
	Unreadable bool
	ParsePanic bool
	Reason     string
	Sidebar    Sidebar
}

// NotFound answers a request for something the vault does not hold, inside the
// ordinary reading shell rather than as a bare line of text. A tool for walking
// between notes will be walked off the end of, and the shell carries what that
// reader needs: the folder tree, the search field, and a way home.
templ NotFound(v NotFoundView, c layouts.Chrome) {
	@layouts.Base(c) {
		<div class="y-nav-scrim" data-nav-close></div>
		<div class="y-shell2">
			@sidebar(v.Sidebar, c)
			<main id="_y-main" tabindex="-1" class="y-main">
				<article class="y-recovery" lang={ c.Lang.Tag() } aria-labelledby="notfound-title">
					// A file that exists and could not be read is a fault, and its
					// word above the title takes the diagnostics' ochre; an address
					// that names nothing is an absence and stays quiet. Neither is an
					// alarm: both are the same column, the same title and the same
					// ways out.
					if v.Unreadable && v.ParsePanic {
						@nothingToShow(nothingNotice{Kind: "notfound", Mark: wording.ParseFailedKicker.In(c.Lang), Title: wording.ParseFailedTitle.In(c.Lang), TitleID: "notfound-title", Page: true, Fault: true}) {
							<p>{ wording.ParseFailedLede.In(c.Lang) }</p>
							<p><code lang="en">{ v.Reason }</code></p>
						}
					} else if v.Unreadable {
						@nothingToShow(nothingNotice{Kind: "notfound", Mark: wording.NotReadableKicker.In(c.Lang), Title: wording.NotReadableTitle.In(c.Lang), TitleID: "notfound-title", Page: true, Fault: true}) {
							<p>{ wording.NotReadableLede.In(c.Lang) }</p>
						}
					} else {
						@nothingToShow(nothingNotice{Kind: "notfound", Mark: wording.NotFoundKicker.In(c.Lang), Title: wording.NothingHere.In(c.Lang), TitleID: "notfound-title", Page: true}) {
							<p>{ wording.NotFoundLede.In(c.Lang) }</p>
						}
					}
					if v.Asked != "" {
						<section class="y-recovery__detail" aria-labelledby="notfound-asked-title">
							<h2 id="notfound-asked-title">{ wording.AddressAsked.In(c.Lang) }</h2>
							<pre><code>{ v.Asked }</code></pre>
						</section>
					}
					// A file that is there and could not be read needs no way to look
					// for it: what to do is in the words above, and the first way out
					// is the read it asks for, a plain link to the same address. A
					// parse that failed also says what to check first.
					if v.Unreadable && v.ParsePanic {
						<section class="y-recovery__next" aria-labelledby="notfound-next-title">
							<h2 id="notfound-next-title">{ wording.WhatNext.In(c.Lang) }</h2>
							<p>{ wording.ParseFailedNext.In(c.Lang) }</p>
						</section>
					} else if !v.Unreadable {
						<section class="y-recovery__next" aria-labelledby="notfound-next-title">
							<h2 id="notfound-next-title">{ wording.WhatNext.In(c.Lang) }</h2>
							<p>{ wording.NotFoundNext.In(c.Lang) }</p>
						</section>
					}
					<nav class="y-recovery__actions" aria-label={ wording.LeaveThisPage.In(c.Lang) }>
						if again := v.againHref(); again != "" {
							<a class="y-recovery__action" href={ templ.SafeURL(again) } data-read-again>{ wording.ReadAgain.In(c.Lang) }</a>
						} else {
							<a class="y-recovery__action" href="/search">{ wording.SearchNotes.In(c.Lang) }</a>
						}
						<a class="y-recovery__action y-recovery__action--quiet" href="/">{ wording.BackHome.In(c.Lang) }</a>
					</nav>
				</article>
			</main>
		</div>
	}
}
