package pages

import "github.com/koopa0/yomihon/internal/wording"

// markNote is one mark in the margin: what the reader wrote, or where a question
// stands, and the day. It is the container a keyboard meets and the reader acts
// on, and the name a screen reader reads begins with the state. The words are
// the reader's own and are text, so they can be selected and read as any text;
// the day and the labels are drawn from attributes, as the margin beside a
// section draws its own, so that none of them is a word of the note's text.
//
// A mark of a whole section stands after its heading, where text would make a
// browser's landing on the heading miss, so its words are drawn from an
// attribute too and its name carries them in full.
templ markNote(m *MarkNote) {
	<aside
		class="y-mnote"
		id={ MarkNoteID(m.ID) }
		role="note"
		tabindex="0"
		data-mnote={ m.ID }
		data-kind={ m.Kind }
		data-state={ m.markState() }
		data-section?={ m.Section }
		data-changed?={ m.Changed }
		aria-label={ m.Name() }
	>
		if m.Words != "" && m.Section {
			<p class="y-mnote__words" data-text={ m.Words }></p>
		} else if m.Words != "" {
			<p class="y-mnote__words">{ m.Words }</p>
		} else if m.Quote != "" {
			<p class="y-mnote__words y-mnote__words--quote" data-text={ m.opening() }></p>
		}
		if m.Changed && m.Words != "" && m.Quote != "" {
			<p class="y-mnote__words y-mnote__words--quote" data-text={ m.opening() }></p>
		}
		<p class="y-mnote__meta" lang={ m.Lang.Tag() }>
			for _, lead := range m.leads() {
				<span class="y-mnote__lead" data-text={ lead }></span>
			}
			if m.Changed {
				<span class="y-mnote__lead" data-text={ wording.MarksChanged.In(m.Lang) }></span>
			}
			if !m.Day.IsZero() {
				<time datetime={ dateOf(m.Day) }></time>
			}
		</p>
	</aside>
}
