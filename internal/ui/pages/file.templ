package pages

import (
	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// File is the reading page for a vault file that is not a note: the shared
// header and navigation, the file's own name as the title, and one of four
// bodies. It carries no right rail — a file has no table of contents and no
// diagnostics — and no status bar, because the write face reaches only a
// note's status.
templ File(v FileView, c layouts.Chrome) {
	@layouts.Base(c) {
		<div class="y-nav-scrim" data-nav-close></div>
		<div class="y-shell y-shell--rail-empty">
			@sidebar(v.Sidebar, c)
			<main id="main-content" tabindex="-1" class="y-main">
				<article class="y-article">
					@fileHead(v, c.Lang)
					switch v.Kind {
						case FileSource:
							<div class="y-prose y-source">
								@templ.Raw(v.SourceHTML)
							</div>
						case FileImage:
							<div class="y-prose">
								// The picture is the whole page, so it is the largest
								// thing the reader is waiting for and the browser is
								// told to fetch it ahead of everything else. Decoding
								// synchronously keeps the page from painting once
								// without it and again with it. Nothing here is ever
								// off-screen, so deferring the load would only delay
								// the one thing the reader came for.
								<img src={ templ.URL(rawHref(v.RelPath)) } alt={ v.Title } fetchpriority="high" decoding="sync"/>
							</div>
						case FilePDF:
							<iframe class="y-fileframe" src={ templ.URL(rawHref(v.RelPath)) } title={ v.Title }></iframe>
						default:
							@fileInfo(v, c.Lang)
					}
				</article>
			</main>
		</div>
	}
}

// fileHead is the file's breadcrumb, name, and byte-level meta — the same shape
// a note's head takes, without the status chip a file cannot have.
templ fileHead(v FileView, lang wording.Lang) {
	if crumbs := Breadcrumb(v.RelPath); len(crumbs) > 0 {
		<div class="y-crumbs">
			for i, seg := range crumbs {
				if i > 0 {
					<span class="y-crumbs__sep" aria-hidden="true">·</span>
				}
				<a class="y-crumbs__link" href={ templ.URL(folderHref(seg.RelPath)) }>{ seg.Name }</a>
			}
		</div>
	}
	<h1 class="y-title">{ v.Title }</h1>
	<div class="y-metarow">
		<span class="ui-type">{ fileKindLabel(v.Kind, lang) }</span>
		<span>{ v.RelPath }</span>
	</div>
	<div class="y-seam" aria-hidden="true"></div>
}

// fileInfo is what yomihon says when it cannot show a file: what it is, how big
// it is, and where its bytes are. Honest, not clever.
templ fileInfo(v FileView, lang wording.Lang) {
	<div class="y-fileinfo">
		<p class="y-fileinfo__lead">{ wording.NoReaderForFile.In(lang) }</p>
		<dl class="y-fileinfo__list">
			<dt>{ wording.FileName.In(lang) }</dt>
			<dd>{ v.Title }</dd>
			<dt>{ wording.FileSize.In(lang) }</dt>
			<dd>{ humanSize(v.Size, lang) }</dd>
			<dt>{ wording.FileType.In(lang) }</dt>
			<dd>{ v.ContentType }</dd>
		</dl>
		<a class="y-fileinfo__raw" href={ templ.URL(rawHref(v.RelPath)) }>{ wording.OpenRawBytes.In(lang) }</a>
		<p class="y-fileinfo__note">{ wording.FileNotIndexed.In(lang) }</p>
	</div>
}
