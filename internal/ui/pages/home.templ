package pages

import (
	"fmt"
	"strconv"

	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// HomeView is the read-only landing surface: dashboard blocks assembled from
// one vault snapshot, then the rendered vault README. Sidebar carries the
// shared shell navigation; no mutation form appears in Home.
//
// A block whose projection was withheld renders nothing at all: it neither
// repeats the reason nor states an emptiness it cannot vouch for, because
// "say nothing" and "say there is nothing" are different sentences. Fault
// carries that reason once, for the whole page.
//
// Governed says whether anything claimed authority over this vault. A folder
// that claimed none has no lifecycle vocabulary to show, so that block is
// absent rather than empty or apologetic.
// homeReadmeRelPath and homeReadmeTitle name the folder's own introduction.
// Home links to it rather than reprinting it: it is a note, it has a page, and
// a reader who wants it is one click away.
const (
	homeReadmeRelPath = "README.md"
)

// HomeView is everything the landing page shows about a vault at one moment:
// whether a contract governs it at all, what is wrong with the vault or with
// this reading of it, and the blocks that answer "what has been happening" —
// recent notes, the lifecycle distribution, the courses in progress, and a
// search box. A folder that fills none of them gets a sentence instead.
type HomeView struct {
	Governed bool
	Fault    string
	// Degraded states that the vault snapshot behind this page could not read
	// everything: some sources are blocked, so the content may be incomplete
	// or held at an older generation. DegradedDetail carries the blocked
	// paths and their errors as technical detail. Empty means the snapshot is
	// whole and current, which is the ordinary case.
	Degraded       string
	DegradedDetail string
	// Subtitle names the content blocks this page actually carries. It is empty
	// when it would name none of them, because a line under the title promising
	// sections that are not below it is the same defect as a bordered box with
	// nothing in it.
	Subtitle string
	// StandIn is the line that takes the place of the content blocks when this
	// folder fills none of them. It states what the folder has rather than what
	// it lacks: a reader who will never write a contract is not missing
	// anything, and a page implying otherwise is an advertisement.
	StandIn HomeStandIn
	Recent  []HomeNote
	// RecentOrdered says the recorded times actually put these in order. A
	// fresh clone stamps every file with one moment, and the block then leads
	// with whatever name sorts first under a heading promising recency — so
	// when the times separate nothing, the block says so instead.
	RecentOrdered bool
	Lifecycle     []LifecycleItem
	Paths         []HomePath
	// ShowRecent, ShowLifecycle and ShowPaths say which blocks this page
	// carries. Each is one answer, decided where the blocks are gathered and
	// where the subtitle that names them and the stand-in that replaces them
	// are decided from the same three values. A template that re-derived them
	// from the lists and the closure flags would be a second place for the same
	// question, kept in step by whoever remembered both.
	ShowRecent    bool
	ShowLifecycle bool
	ShowPaths     bool
	ReadmeMissing bool
	Sidebar       Sidebar
}

// HomeStandIn carries the stand-in line's facts: how much is in this folder and
// which of it changed last. NewestRelPath is empty for a folder holding no files,
// the one case with nothing to point at.
type HomeStandIn struct {
	Shown         bool
	Files         int
	NewestName    string
	NewestRelPath string
	NewestDate    string
	NewestAt      string
}

// HomeNote is one item in the recently-changed block. Modified is the compact
// display date; ModifiedAt is its machine-readable RFC 3339 value.
type HomeNote struct {
	Title      string
	RelPath    string
	Type       string
	Status     string
	Modified   string
	ModifiedAt string

	// StatusOutsideEnum marks a note whose status value the contract does not
	// declare for this note's type. It is the per-note question, the one the
	// reading page and the search row ask — deliberately not the distribution
	// chip's, which speaks for an aggregated value and asks whether any
	// carrier declares it.
	StatusOutsideEnum bool
}

// HomePath is one study-path card with its total lesson count.
type HomePath struct {
	Title   string
	RelPath string
	Total   int
}

// Home renders the landing page inside the standard shell. The four
// data-home-block markers are the HTTP smoke sites: each names a block by its
// invariant, independent of where the layout places it.
templ Home(v HomeView, c layouts.Chrome) {
	@layouts.Base(c) {
		<div class="y-nav-scrim" data-nav-close></div>
		<div class="y-shell2">
			@sidebar(v.Sidebar, c.Nonce)
			<main id="main-content" tabindex="-1" class="y-main">
				<div class="y-home">
					<header class="y-home__head">
						<div class="y-home__kicker">{ wording.HomeKicker.In(c.Lang) }</div>
						<h1 class="y-title">{ wording.HomeTitle.In(c.Lang) }</h1>
						if v.Subtitle != "" {
							<p>{ v.Subtitle }</p>
						}
					</header>
					<div class="y-homegrid">
						if v.Fault != "" {
							<section class="y-homeblock y-homeblock--faults" data-home-block="faults" aria-labelledby="home-faults-title">
								@homeBlockHead("home-faults-title", wording.HomeFaultsTitle.In(c.Lang), wording.HomeFaultsLede.In(c.Lang))
								<p class="y-homeempty" data-home-fault>
									@browserDiagnostic(wording.HomeFaultsBrowser.In(c.Lang), v.Fault)
								</p>
							</section>
						}
						if v.Degraded != "" {
							<section class="y-homeblock y-homeblock--faults" data-home-block="degraded" aria-labelledby="home-degraded-title">
								@homeBlockHead("home-degraded-title", wording.HomeDegradedTitle.In(c.Lang), wording.HomeDegradedLede.In(c.Lang))
								<p class="y-homeempty" data-home-degraded>
									@browserDiagnostic(v.Degraded, v.DegradedDetail)
								</p>
							</section>
						}
						if v.StandIn.Shown {
							<p class="y-homestandin" data-home-standin>
								if v.StandIn.NewestRelPath == "" {
									{ wording.StandInEmpty.In(c.Lang) }
								} else {
									{ fmt.Sprintf(wording.StandInBefore.In(c.Lang), v.StandIn.Files) }<a href={ templ.URL(notesHref(v.StandIn.NewestRelPath)) }>{ v.StandIn.NewestName }</a>{ wording.StandInDateOpen.In(c.Lang) }<time datetime={ v.StandIn.NewestAt }>{ v.StandIn.NewestDate }</time>{ wording.StandInDateClose.In(c.Lang) }
								}
							</p>
						}
						if v.ShowRecent {
							<section class="y-homeblock y-homeblock--recent" data-home-block="recent" aria-labelledby="home-recent-title">
								if v.RecentOrdered {
									@homeBlockHead("home-recent-title", wording.HomeRecentTitle.In(c.Lang), wording.HomeRecentLede.In(c.Lang))
								} else {
									@homeBlockHead("home-recent-title", wording.HomeTiedTitle.In(c.Lang), wording.HomeTiedLede.In(c.Lang))
								}
								<div class="y-homerecent">
									for _, n := range v.Recent {
										<a class="y-homenote" href={ templ.URL(notesHref(n.RelPath)) } data-home-recent-note>
											<span class="y-homenote__main">
												<span class="y-homenote__title">{ n.Title }</span>
												<span class="y-homenote__path">{ n.RelPath }</span>
											</span>
											<span class="y-homenote__meta">
												if n.Status != "" {
													<span class={ "ui-status", "ui-status--" + n.Status }>{ n.Status }</span>
													if n.StatusOutsideEnum {
														@statusOutsideEnumMark()
													}
												}
												if n.Modified != "" {
													<time datetime={ n.ModifiedAt }>{ n.Modified }</time>
												}
											</span>
										</a>
									}
								</div>
							</section>
						}
						if v.ShowLifecycle {
							<section class="y-homeblock y-homeblock--lifecycle" data-home-block="lifecycle" aria-labelledby="home-lifecycle-title">
								@homeBlockHead("home-lifecycle-title", wording.HomeLifecycleTitle.In(c.Lang), wording.HomeLifecycleLede.In(c.Lang))
								<div class="y-homechips">
									for _, it := range v.Lifecycle {
										<a class={ "y-homechip", templ.KV("y-homechip--unknown", it.Unknown) } href={ templ.URL(statusHref(it.Name)) }>
											<span class={ "y-navdot", templ.KV("y-navdot--ready", it.Sealed) } aria-hidden="true"></span>
											<span>{ statusChipLabel(it.Name, c.Lang) }</span>
											if it.Unknown {
												@statusOutsideEnumMark()
											}
											<span class="y-homechip__count" aria-label={ fmt.Sprintf(wording.NoteCount.In(c.Lang), it.Count) }>{ strconv.Itoa(it.Count) }</span>
										</a>
									}
								</div>
							</section>
						}
						if v.ShowPaths {
							<section class="y-homeblock y-homeblock--paths" data-home-block="study-paths" aria-labelledby="home-paths-title">
								@homeBlockHead("home-paths-title", wording.HomePathsTitle.In(c.Lang), wording.HomePathsLede.In(c.Lang))
								<div class="y-homepaths">
									for _, p := range v.Paths {
										<a class="y-homepath" href={ templ.URL(syllabusHref(p.RelPath)) }>
											<span class="y-homepath__title">{ p.Title }</span>
											<span class="y-homepath__progress">{ fmt.Sprintf(wording.LessonCount.In(c.Lang), p.Total) }</span>
										</a>
									}
								</div>
							</section>
						}
						<section class="y-homeblock y-homeblock--search" data-home-block="search" aria-labelledby="home-search-title">
							@homeBlockHead("home-search-title", wording.HomeSearchTitle.In(c.Lang), wording.HomeSearchLede.In(c.Lang))
							<form class="y-homesearch" method="get" action="/search" role="search">
								<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
								<input type="search" name="q" placeholder={ wording.SearchLibraryPrompt.In(c.Lang) } aria-label={ wording.SearchNotes.In(c.Lang) }/>
								<button type="submit" class="y-xbtn">{ wording.SearchSubmit.In(c.Lang) }</button>
							</form>
						</section>
					</div>
					// The folder's own introduction is a note like any other, and
					// it has a page. Printing the whole of it here made it most of
					// the first screen — on one governed vault, seven tenths of
					// everything the page said — and it is the piece a returning
					// reader has read most often. A folder without one is not
					// missing anything: most folders in the world have no README,
					// and a reading tool whose opening move is an instruction to
					// go author a file in another program has told the reader to
					// leave.
					if !v.ReadmeMissing {
						<p class="y-homereadme" data-home-readme>
							<a href={ templ.URL(notesHref(homeReadmeRelPath)) }>{ wording.HomeReadmeTitle.In(c.Lang) }</a>
						</p>
					}
				</div>
			</main>
		</div>
	}
}

templ homeBlockHead(id, title, note string) {
	<header class="y-homeblock__head">
		<h2 id={ id }>{ title }</h2>
		<p>{ note }</p>
	</header>
}
