package pages

import (
	"strconv"

	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// HomeReadmeRelPath names the folder's own introduction. The desk links to it
// rather than reprinting it: it is a note, it has a page, and a reader who
// wants it is one click away.
//
// It is exported because the two halves of that sentence are decided on
// different sides of a package boundary — this one draws the link, and the
// handler asks whether the note is there — and the name they are deciding about
// has to be one name. Written twice, the copies agreed until somebody changed
// one, and nothing anywhere would have failed.
const HomeReadmeRelPath = "README.md"

// HomeView is the desk: the four ways into the library, and whatever is wrong
// with the vault or with this reading of it. A folder that fills none of the
// blocks gets a sentence instead. The faults sit below the seam, where a reader
// who came to read is not made to walk past them.
type HomeView struct {
	OpenThoughts      Shelf
	OpenThoughtsFault string
	Fault             string
	// Restart and PrivacyRestart are the reader's sentence for the one cause
	// the dictionary has words of its own for: the contract changed after
	// yomihon read it. Each stands where the quotation beside it would, in
	// place of it, so the contract's English line is not printed next to a
	// sentence that already says the same thing in the reader's language.
	Restart string
	// PrivacyFault is why the contract's egress declaration could not be used.
	// It is not folded into Fault, which explains an empty block: a refused
	// egress declaration empties nothing here, only the judging commands, whose
	// own output is written for a program to read.
	PrivacyFault   string
	PrivacyRestart string
	// Degraded states that the snapshot behind this page could not read
	// everything, so the content may be incomplete or held at an older
	// generation; DegradedDetail carries the blocked paths and their errors.
	Degraded       string
	DegradedDetail string
	// Notices are the standing facts about the folder that no unreadable file
	// explains, such as updates having stopped. They are drawn first among
	// the faults, since each says whether the desk above is current.
	Notices []FolderNotice
	// Blocks are the four ways in, in the order a reader meets them.
	Blocks        []DeskBlock
	ReadmeMissing bool
	// Continue is the way back to the place the reader kept, drawn ahead of
	// the four ways in. A reader who kept none gets no row.
	Continue ContinueRow
}

// HomeNote is one item in the recently-changed block. Modified is the compact
// display date; ModifiedAt is its machine-readable RFC 3339 value.
type HomeNote struct {
	Title   string
	RelPath string
	Type    string
	// Draft is whether the note declares itself unfinished, the one note the
	// row marks.
	Draft      bool
	Modified   string
	ModifiedAt string

	// Language is the note's own declared BCP 47 tag when the contract gave
	// the field authority and the frontmatter carried a valid value. Empty
	// otherwise, so a listing inherits the page language rather than guessing.
	Language string
}

// Home renders the desk. Each block is marked with the mode it opens, so a
// check names a block by what it is rather than by where the layout put it.
// The desk carries no left rail: the rail is the thing being read, and there is
// nothing being read here.
templ Home(v HomeView, c layouts.Chrome) {
	@layouts.Base(c) {
		<main id="_y-main" tabindex="-1" class="y-main y-deskmain">
			<div class="y-home">
				// The desk's name is a label, never the loudest thing on it: what
				// stands first is the place the reader kept, or the courses. With
				// a place kept the heading is left for the listener alone.
				if v.Continue.Show {
					<h1 class="y-offscreen y-offscreen--block">{ wording.HomeTitle.In(c.Lang) }</h1>
				} else {
					<h1 class="y-title y-desklabel">{ wording.HomeTitle.In(c.Lang) }</h1>
				}
				// There is no search field here: the header carries the one
				// search the product has, and a second field on the page asked
				// for as much of it as any of the ways in.
				//
				// Ahead of the ways in, because a reader who left a place came
				// back for it and the ways in are what they walk past when they
				// did not.
				@continueRow(v.Continue, c.Lang)
				for _, block := range v.Blocks {
					if v.leads(&block) {
						<div class="y-homelead">
							@ShelfBlock(block.Shelf, block.Mode, deskBlockItems, c.Lang, true)
						</div>
					}
				}
				<div class="y-homegrid">
					if v.OpenThoughts.Title != "" {
						@ShelfBlock(v.OpenThoughts, "open-thoughts", OpenThoughtsHomeRows, c.Lang, false) {
							if v.OpenThoughtsFault != "" {
								@nothingToShow(nothingNotice{Kind: "open-thoughts", Fault: true}) {
									<p>{ v.OpenThoughtsFault }</p>
								}
							}
						}
					}
					for _, block := range v.Blocks {
						if !v.leads(&block) {
							@ShelfBlock(block.Shelf, block.Mode, deskBlockItems, c.Lang, false)
						}
					}
				</div>
				// Below the four ways in the page stops being about reading and
				// starts being about the vault's own health.
				for i, notice := range v.Notices {
					<section class="y-homeblock y-homeblock--faults" data-home-block="notice" aria-labelledby={ "home-notice-title-" + strconv.Itoa(i) }>
						@nothingToShow(nothingNotice{Kind: "notice", Title: notice.Title, TitleID: "home-notice-title-" + strconv.Itoa(i), Fault: true}) {
							<p>
								@browserDiagnostic(notice.Summary, notice.Detail)
							</p>
						}
					</section>
				}
				if v.Fault != "" || v.Restart != "" {
					<section class="y-homeblock y-homeblock--faults" data-home-block="faults" aria-labelledby="home-faults-title">
						@homeBlockHead("home-faults-title", wording.HomeFaultsTitle.In(c.Lang), wording.HomeFaultsLede.In(c.Lang))
						<p class="y-homeempty" data-home-fault>
							if v.Restart != "" {
								@browserDiagnostic(v.Restart, "")
							}
							if v.Fault != "" {
								@browserDiagnostic(wording.HomeFaultsBrowser.In(c.Lang), v.Fault)
							}
						</p>
					</section>
				}
				if v.PrivacyFault != "" || v.PrivacyRestart != "" {
					<section class="y-homeblock y-homeblock--faults" data-home-block="privacy" aria-labelledby="home-privacy-title">
						@nothingToShow(nothingNotice{Kind: "privacy", Title: wording.HomePrivacyTitle.In(c.Lang), TitleID: "home-privacy-title", Fault: true}) {
							<p>{ wording.HomePrivacyLede.In(c.Lang) }</p>
							<p>
								if v.PrivacyRestart != "" {
									@browserDiagnostic(v.PrivacyRestart, "")
								}
								if v.PrivacyFault != "" {
									@browserDiagnostic(wording.HomePrivacyBrowser.In(c.Lang), v.PrivacyFault)
								}
							</p>
						}
					</section>
				}
				if v.Degraded != "" {
					<section class="y-homeblock y-homeblock--faults" data-home-block="degraded" aria-labelledby="home-degraded-title">
						@nothingToShow(nothingNotice{Kind: "degraded", Title: wording.HomeDegradedTitle.In(c.Lang), TitleID: "home-degraded-title", Fault: true}) {
							<p>
								@browserDiagnostic(v.Degraded, v.DegradedDetail)
							</p>
						}
					</section>
				}
				if !v.ReadmeMissing {
					<p class="y-homereadme" data-home-readme>
						<a href={ templ.URL(notesHref(HomeReadmeRelPath)) }>{ wording.HomeReadmeTitle.In(c.Lang) }</a>
					</p>
				}
				@deskHealth(c.Lang)
			</div>
		</main>
	}
}

// deskHealth is the way to the whole-folder view, the author's maintenance
// page rather than part of reading, so it is the desk's last line and a quiet
// one. It is drawn whether or not anything is found, because a way in that
// came and went with the findings would be missing exactly when a reader went
// looking for it to confirm there are none. It names the page and says nothing
// of what is on it: the desk is not where a reader is told how many things are
// wrong with the vault, and a number here would turn a way in into a debt.
templ deskHealth(lang wording.Lang) {
	<p class="y-deskhealth" data-home-health>
		<a href="/health">{ wording.HealthTitle.In(lang) }</a>
	</p>
}

templ homeBlockHead(id, title, note string) {
	<header class="y-homeblock__head">
		<h2 id={ id }>{ title }</h2>
		if note != "" {
			<p>{ note }</p>
		}
	</header>
}
