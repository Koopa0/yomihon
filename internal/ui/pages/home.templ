package pages

import (
	"strconv"

	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// HomeReadmeRelPath names the folder's own introduction. The desk links to it
// rather than reprinting it: it is a note, it has a page, and a reader who
// wants it is one click away.
//
// It is exported because the two halves of that sentence are decided on
// different sides of a package boundary — this one draws the link, and the
// handler asks whether the note is there — and the name they are deciding about
// has to be one name. Written twice, the copies agreed until somebody changed
// one, and nothing anywhere would have failed.
const HomeReadmeRelPath = "README.md"

// HomeView is the desk: the four ways into the library, and whatever is wrong
// with the vault or with this reading of it. A folder that fills none of the
// blocks gets a sentence instead. The faults sit below the seam, where a reader
// who came to read is not made to walk past them.
type HomeView struct {
	Fault string
	// PrivacyFault is why the contract's egress declaration could not be used.
	// It is not folded into Fault, which explains an empty block: a refused
	// egress declaration empties nothing here, only the judging commands, whose
	// own output is written for a program to read.
	PrivacyFault string
	// Degraded states that the snapshot behind this page could not read
	// everything, so the content may be incomplete or held at an older
	// generation; DegradedDetail carries the blocked paths and their errors.
	Degraded       string
	DegradedDetail string
	// Blocks are the four ways in, in the order a reader meets them.
	Blocks        []DeskBlock
	ReadmeMissing bool
}

// HomeNote is one item in the recently-changed block. Modified is the compact
// display date; ModifiedAt is its machine-readable RFC 3339 value.
type HomeNote struct {
	Title      string
	RelPath    string
	Type       string
	Status     string
	Modified   string
	ModifiedAt string

	// StatusOutsideEnum marks a note whose status value the contract does not
	// declare for its type — the per-note question the reading page and the
	// search row ask, not the distribution chip's aggregated one.
	StatusOutsideEnum bool
}

// Home renders the desk. Each block is marked with the mode it opens, so a
// check names a block by what it is rather than by where the layout put it.
// The desk carries no left rail: the rail is the thing being read, and there is
// nothing being read here.
templ Home(v HomeView, c layouts.Chrome) {
	@layouts.Base(c) {
		<main id="main-content" tabindex="-1" class="y-main y-deskmain">
			<div class="y-home">
				<header class="y-home__head">
					<div class="y-home__kicker">{ wording.HomeKicker.In(c.Lang) }</div>
					<h1 class="y-title">{ wording.HomeTitle.In(c.Lang) }</h1>
					<p>{ wording.HomeDeskLede.In(c.Lang) }</p>
				</header>
				// One row rather than a fifth block. The four ways in are what
				// the desk is for; a field is how a reader who already knows
				// what they want skips them, and it asked for as much of the
				// screen as any of them. The form itself stays whole: it is a
				// plain GET that works with no script at all, and the palette
				// in the header opens the same search for a reader who has one.
				<search class="y-homesearchrow" data-home-block="search">
					<form class="y-homesearch" method="get" action="/search">
						<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
						<input type="search" name="q" placeholder={ wording.SearchLibraryPrompt.In(c.Lang) } aria-label={ wording.SearchNotes.In(c.Lang) }/>
						<button type="submit" class="y-xbtn">{ wording.SearchSubmit.In(c.Lang) }</button>
					</form>
				</search>
				<div class="y-homegrid">
					for _, block := range v.Blocks {
						@ShelfBlock(block.Shelf, block.Mode, deskBlockItems, c.Lang)
					}
				</div>
				// Below this line the page stops being about reading and starts
				// being about the vault's own health. Saying where that line is
				// means a reader who arrives to a clean desk still knows where a
				// fault would have appeared.
				<div class="y-seam" aria-hidden="true"></div>
				<p class="y-homeseamnote">{ wording.HomeSeamNote.In(c.Lang) }</p>
				if v.Fault != "" {
					<section class="y-homeblock y-homeblock--faults" data-home-block="faults" aria-labelledby="home-faults-title">
						@homeBlockHead("home-faults-title", wording.HomeFaultsTitle.In(c.Lang), wording.HomeFaultsLede.In(c.Lang))
						<p class="y-homeempty" data-home-fault>
							@browserDiagnostic(wording.HomeFaultsBrowser.In(c.Lang), v.Fault)
						</p>
					</section>
				}
				if v.PrivacyFault != "" {
					<section class="y-homeblock y-homeblock--faults" data-home-block="privacy" aria-labelledby="home-privacy-title">
						@homeBlockHead("home-privacy-title", wording.HomePrivacyTitle.In(c.Lang), wording.HomePrivacyLede.In(c.Lang))
						<p class="y-homeempty" data-home-privacy>
							@browserDiagnostic(wording.HomePrivacyBrowser.In(c.Lang), v.PrivacyFault)
						</p>
					</section>
				}
				if v.Degraded != "" {
					<section class="y-homeblock y-homeblock--faults" data-home-block="degraded" aria-labelledby="home-degraded-title">
						@homeBlockHead("home-degraded-title", wording.HomeDegradedTitle.In(c.Lang), wording.HomeDegradedLede.In(c.Lang))
						<p class="y-homeempty" data-home-degraded>
							@browserDiagnostic(v.Degraded, v.DegradedDetail)
						</p>
					</section>
				}
				if !v.ReadmeMissing {
					<p class="y-homereadme" data-home-readme>
						<a href={ templ.URL(notesHref(HomeReadmeRelPath)) }>{ wording.HomeReadmeTitle.In(c.Lang) }</a>
					</p>
				}
			</div>
		</main>
	}
}

templ homeBlockHead(id, title, note string) {
	<header class="y-homeblock__head">
		<h2 id={ id }>{ title }</h2>
		<p>{ note }</p>
	</header>
}

// lifecycleChipBody is what every chip shows, link or not, so a chip that is
// not a link cannot drift into looking different from one that is.
templ lifecycleChipBody(it LifecycleItem, lang wording.Lang) {
	<span class={ "y-navdot", templ.KV("y-navdot--ready", it.Sealed) } aria-hidden="true"></span>
	<span>{ statusChipLabel(it.Name, lang) }</span>
	if it.Unknown {
		@statusOutsideEnumMark(lang)
	}
	<span class="y-homechip__count" aria-label={ plural(it.Count, wording.NoteCountOne, wording.NoteCountMany, lang) }>{ strconv.Itoa(it.Count) }</span>
}

// unstatedChipBody is what a cell shows when it stands for notes carrying no
// status. It has no status dot, there being no status for one to mark, and its
// words come from where a blank status has always taken them.
templ unstatedChipBody(it LifecycleItem, lang wording.Lang) {
	if it.Label != "" {
		<span>{ it.Label }</span>
	} else {
		<span>{ statusChipLabel(it.Name, lang) }</span>
	}
	<span class="y-homeunstated__count" aria-label={ plural(it.Count, wording.NoteCountOne, wording.NoteCountMany, lang) }>{ strconv.Itoa(it.Count) }</span>
}
