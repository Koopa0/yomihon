package pages

import (
	"strconv"

	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// homeReadmeRelPath and homeReadmeTitle name the folder's own introduction.
// Home links to it rather than reprinting it: it is a note, it has a page, and
// a reader who wants it is one click away.
const (
	homeReadmeRelPath = "README.md"
)

// HomeView is everything the landing page shows about a vault at one moment:
// whether a contract governs it, what is wrong with the vault or with this
// reading of it, and the blocks answering what has been happening. A folder
// that fills none of them gets a sentence instead. A withheld block renders
// nothing at all, Fault carrying its reason once for the whole page.
type HomeView struct {
	Governed bool
	Fault    string
	// PrivacyFault is why the contract's egress declaration could not be used.
	// It is not folded into Fault, which explains a missing block: a refused
	// egress declaration closes no block here, only the judging commands, whose
	// own output is written for a program to read.
	PrivacyFault string
	// Degraded states that the snapshot behind this page could not read
	// everything, so the content may be incomplete or held at an older
	// generation; DegradedDetail carries the blocked paths and their errors.
	Degraded       string
	DegradedDetail string
	// Subtitle names the content blocks this page carries, empty where it would
	// name none: a line promising sections that are not below it is the same
	// defect as a bordered box with nothing in it.
	Subtitle string
	// StandIn replaces the content blocks where this folder fills none. It
	// states what the folder has rather than what it lacks.
	StandIn HomeStandIn
	Recent  []HomeNote
	// RecentOrdered says the recorded times actually put these in order. A
	// fresh clone stamps every file with one moment, and where the times
	// separate nothing the block says so rather than promising recency.
	RecentOrdered bool
	// RecentScoped says the recent list covers the contract's declared
	// knowledge layer rather than the whole folder, which the lede then names:
	// the distribution beside it counts every indexed note.
	RecentScoped bool
	Lifecycle    []LifecycleItem
	// Unstated are the cells for notes carrying no status to be grouped by,
	// kept apart from Lifecycle so the markup cannot dress them as statuses.
	Unstated []LifecycleItem
	Paths    []HomePath
	// ShowRecent, ShowLifecycle and ShowPaths say which blocks this page
	// carries, decided once where the subtitle naming them and the stand-in
	// replacing them are decided from the same three values.
	ShowRecent    bool
	ShowLifecycle bool
	ShowPaths     bool
	ReadmeMissing bool
	Sidebar       Sidebar
}

// HomeStandIn carries the stand-in line's facts: how much is in this folder and
// which of it changed last. NewestRelPath is empty for a folder holding no
// files, the one case with nothing to point at.
type HomeStandIn struct {
	Shown         bool
	Files         int
	NewestName    string
	NewestRelPath string
	NewestDate    string
	NewestAt      string
}

// HomeNote is one item in the recently-changed block. Modified is the compact
// display date; ModifiedAt is its machine-readable RFC 3339 value.
type HomeNote struct {
	Title      string
	RelPath    string
	Type       string
	Status     string
	Modified   string
	ModifiedAt string

	// StatusOutsideEnum marks a note whose status value the contract does not
	// declare for its type — the per-note question the reading page and the
	// search row ask, not the distribution chip's aggregated one.
	StatusOutsideEnum bool
}

// HomePath is one study-path card with its total lesson count. Undetermined
// marks the zero that is a fault rather than an answer: the grammar could not
// read what the note lists. A path that genuinely plans nothing keeps a zero.
type HomePath struct {
	Title        string
	RelPath      string
	Total        int
	Undetermined bool
}

// Home renders the landing page inside the standard shell. The four
// data-home-block markers name each block by its invariant, independent of
// where the layout places it.
templ Home(v HomeView, c layouts.Chrome) {
	@layouts.Base(c) {
		<div class="y-nav-scrim" data-nav-close></div>
		<div class="y-shell2">
			@sidebar(v.Sidebar, c)
			<main id="main-content" tabindex="-1" class="y-main">
				<div class="y-home">
					<header class="y-home__head">
						<div class="y-home__kicker">{ wording.HomeKicker.In(c.Lang) }</div>
						<h1 class="y-title">{ wording.HomeTitle.In(c.Lang) }</h1>
						if v.Subtitle != "" {
							<p>{ v.Subtitle }</p>
						}
					</header>
					<div class="y-homegrid">
						if v.Fault != "" {
							<section class="y-homeblock y-homeblock--faults" data-home-block="faults" aria-labelledby="home-faults-title">
								@homeBlockHead("home-faults-title", wording.HomeFaultsTitle.In(c.Lang), wording.HomeFaultsLede.In(c.Lang))
								<p class="y-homeempty" data-home-fault>
									@browserDiagnostic(wording.HomeFaultsBrowser.In(c.Lang), v.Fault)
								</p>
							</section>
						}
						if v.PrivacyFault != "" {
							<section class="y-homeblock y-homeblock--faults" data-home-block="privacy" aria-labelledby="home-privacy-title">
								@homeBlockHead("home-privacy-title", wording.HomePrivacyTitle.In(c.Lang), wording.HomePrivacyLede.In(c.Lang))
								<p class="y-homeempty" data-home-privacy>
									@browserDiagnostic(wording.HomePrivacyBrowser.In(c.Lang), v.PrivacyFault)
								</p>
							</section>
						}
						if v.Degraded != "" {
							<section class="y-homeblock y-homeblock--faults" data-home-block="degraded" aria-labelledby="home-degraded-title">
								@homeBlockHead("home-degraded-title", wording.HomeDegradedTitle.In(c.Lang), wording.HomeDegradedLede.In(c.Lang))
								<p class="y-homeempty" data-home-degraded>
									@browserDiagnostic(v.Degraded, v.DegradedDetail)
								</p>
							</section>
						}
						if v.StandIn.Shown {
							<p class="y-homestandin" data-home-standin>
								if v.StandIn.NewestRelPath == "" {
									{ wording.StandInEmpty.In(c.Lang) }
								} else {
									{ plural(v.StandIn.Files, wording.StandInBeforeOne, wording.StandInBeforeMany, c.Lang) }<a href={ templ.URL(notesHref(v.StandIn.NewestRelPath)) }>{ v.StandIn.NewestName }</a>{ wording.StandInDateOpen.In(c.Lang) }<time datetime={ v.StandIn.NewestAt }>{ v.StandIn.NewestDate }</time>{ wording.StandInDateClose.In(c.Lang) }
								}
							</p>
						}
						if v.ShowRecent {
							<section class="y-homeblock y-homeblock--recent" data-home-block="recent" aria-labelledby="home-recent-title">
								@homeBlockHead("home-recent-title", homeRecentTitle(&v, c.Lang), homeRecentLede(&v, c.Lang))
								<div class="y-homerecent">
									for _, n := range v.Recent {
										<a class="y-homenote" href={ templ.URL(notesHref(n.RelPath)) } data-home-recent-note>
											<span class="y-homenote__main">
												<span class="y-homenote__title">{ n.Title }</span>
												<span class="y-homenote__path">{ n.RelPath }</span>
											</span>
											<span class="y-homenote__meta">
												if n.Status != "" {
													<span class={ "ui-status", "ui-status--" + n.Status }>{ n.Status }</span>
													if n.StatusOutsideEnum {
														@statusOutsideEnumMark(c.Lang)
													}
												}
												if n.Modified != "" {
													<time datetime={ n.ModifiedAt }>{ n.Modified }</time>
												}
											</span>
										</a>
									}
								</div>
							</section>
						}
						if v.ShowLifecycle {
							<section class="y-homeblock y-homeblock--lifecycle" data-home-block="lifecycle" aria-labelledby="home-lifecycle-title">
								@homeBlockHead("home-lifecycle-title", wording.HomeLifecycleTitle.In(c.Lang), wording.HomeLifecycleLede.In(c.Lang))
								<div class="y-homechips">
									for _, it := range v.Lifecycle {
										<a class={ "y-homechip", templ.KV("y-homechip--unknown", it.Unknown) } href={ templ.URL(statusHref(it.Name)) }>
											@lifecycleChipBody(it, c.Lang)
										</a>
									}
								</div>
								if len(v.Unstated) > 0 {
									<div class="y-homeunstated">
										for _, it := range v.Unstated {
											if it.Href == "" {
												<span class="y-homeunstated__cell">
													@unstatedChipBody(it, c.Lang)
												</span>
											} else {
												<a class="y-homeunstated__cell" href={ templ.URL(it.Href) }>
													@unstatedChipBody(it, c.Lang)
												</a>
											}
										}
									</div>
									<p class="y-homeblock__note">{ wording.LifecycleUnstatedNote.In(c.Lang) }</p>
								}
							</section>
						}
						if v.ShowPaths {
							<section class="y-homeblock y-homeblock--paths" data-home-block="study-paths" aria-labelledby="home-paths-title">
								@homeBlockHead("home-paths-title", wording.HomePathsTitle.In(c.Lang), wording.HomePathsLede.In(c.Lang))
								<div class="y-homepaths">
									for _, p := range v.Paths {
										<a class="y-homepath" href={ templ.URL(syllabusHref(p.RelPath)) }>
											<span class="y-homepath__title">{ p.Title }</span>
											<span class="y-homepath__progress">{ plural(p.Total, wording.LessonCountOne, wording.LessonCountMany, c.Lang) }</span>
											if p.Undetermined {
												<span class="y-navmark y-navmark--warn">{ wording.NoStructureRead.In(c.Lang) }</span>
											}
										</a>
									}
								</div>
							</section>
						}
						<section class="y-homeblock y-homeblock--search" data-home-block="search" aria-labelledby="home-search-title">
							@homeBlockHead("home-search-title", wording.HomeSearchTitle.In(c.Lang), wording.HomeSearchLede.In(c.Lang))
							<search>
								<form class="y-homesearch" method="get" action="/search">
									<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
									<input type="search" name="q" placeholder={ wording.SearchLibraryPrompt.In(c.Lang) } aria-label={ wording.SearchNotes.In(c.Lang) }/>
									<button type="submit" class="y-xbtn">{ wording.SearchSubmit.In(c.Lang) }</button>
								</form>
							</search>
						</section>
					</div>
					// The folder's own introduction is a note like any other and
					// has a page of its own, so this links to it rather than
					// printing the whole of it into most of the first screen.
					// A folder without one is not missing anything: a reading
					// tool whose opening move is an instruction to go author a
					// file in another program has told the reader to leave.
					if !v.ReadmeMissing {
						<p class="y-homereadme" data-home-readme>
							<a href={ templ.URL(notesHref(homeReadmeRelPath)) }>{ wording.HomeReadmeTitle.In(c.Lang) }</a>
						</p>
					}
				</div>
			</main>
		</div>
	}
}

templ homeBlockHead(id, title, note string) {
	<header class="y-homeblock__head">
		<h2 id={ id }>{ title }</h2>
		<p>{ note }</p>
	</header>
}

// lifecycleChipBody is what every chip shows, link or not, so a chip that is
// not a link cannot drift into looking different from one that is.
templ lifecycleChipBody(it LifecycleItem, lang wording.Lang) {
	<span class={ "y-navdot", templ.KV("y-navdot--ready", it.Sealed) } aria-hidden="true"></span>
	<span>{ statusChipLabel(it.Name, lang) }</span>
	if it.Unknown {
		@statusOutsideEnumMark(lang)
	}
	<span class="y-homechip__count" aria-label={ plural(it.Count, wording.NoteCountOne, wording.NoteCountMany, lang) }>{ strconv.Itoa(it.Count) }</span>
}

// unstatedChipBody is what a cell shows when it stands for notes carrying no
// status. It has no status dot, there being no status for one to mark, and its
// words come from where a blank status has always taken them.
templ unstatedChipBody(it LifecycleItem, lang wording.Lang) {
	if it.Label != "" {
		<span>{ it.Label }</span>
	} else {
		<span>{ statusChipLabel(it.Name, lang) }</span>
	}
	<span class="y-homeunstated__count" aria-label={ plural(it.Count, wording.NoteCountOne, wording.NoteCountMany, lang) }>{ strconv.Itoa(it.Count) }</span>
}
