package pages

import (
	"strconv"

	"github.com/koopa0/yomihon/internal/judge"
	"github.com/koopa0/yomihon/internal/nav"
	"github.com/koopa0/yomihon/internal/snapshot"
	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// HealthView is the whole-folder answer to "what needs attention". Every note
// page can say what is wrong with itself, but nobody opens every note; these
// are the same facts, gathered.
type HealthView struct {
	// Unwritten are citations to names no file carries and no ledger declared.
	Unwritten []snapshot.HealthLink
	// TitleOnly are citations naming a note's title — the note exists, and the
	// repair is an alias rather than a new note.
	TitleOnly []snapshot.HealthTitleLink
	// Islands are notes nothing cites in the body, grouped by folder.
	// A based_on declaration is not a citation here; the guide says so.
	Islands []HealthIslandGroup
	// IslandCount is every uncited note across the groups, so the page can tell
	// whether it has anything to report before it counts its own rows.
	IslandCount int
	// Collisions are names more than one file answers to.
	Collisions []HealthCollision
	// Blocked are vault sources the latest snapshot build could not read, so
	// the pages either lack them or hold their older captured content.
	Blocked []HealthBlockedSource
	// Skipped are paths the generation saw and did not index: a symbolic
	// link the scan passed over, or a note over the source bound. They are
	// separate from Blocked: nothing went wrong reading them, and no later
	// reading will pick them up as captured notes.
	Skipped []HealthSkippedSource
	// StatusOutsideEnum are the notes whose status value is outside their type's
	// declared list. An empty list renders nothing, the unknowable case
	// included.
	StatusOutsideEnum []HealthStatusNote
	// StatusUnreachable are the notes whose status is in its type's declared
	// group while no lifecycle row with that status applies to its type.
	StatusUnreachable []HealthStatusNote
	// FrontmatterUnreadable are the notes whose frontmatter is not valid YAML,
	// so nothing they declare could be judged at all.
	FrontmatterUnreadable []HealthNoteFindings
	// SchemaFaults are the notes whose frontmatter reads and carries something
	// the schema does not accept. The detail stays on each note's own page,
	// two accounts of one file being how the two start disagreeing.
	SchemaFaults []HealthNoteFindings
	// InstanceScopeUnknown and SchemaScopeUnknown are why a group of the lists
	// above could not be worked out, empty where it could: an empty list under
	// a silent heading reads as "nothing found", which is a different and here
	// a false statement. They are filled in different places because the facts
	// are met in different places — which files are instances is settled while
	// a generation is built, whether the vocabulary can be read is settled per
	// request. Each carries the diagnostic of the claim that actually failed,
	// never a sentence chosen in advance.
	InstanceScopeUnknown string
	SchemaScopeUnknown   string
	// LastComplete is when the folder was last read whole, which is not always
	// when this page's generation was built: a reading that lost some sources
	// carries the last copy of each. Empty means no whole read since startup.
	LastComplete string
	// Sort is the column the reader asked the table to be ordered by, already
	// read against the closed set.
	Sort    HealthColumn
	Sidebar Sidebar
}

// HealthStatusNote is one note carrying a status its own type never declared,
// named beside the value and that type. The value is the word the reader has to
// edit and the type is why it failed, so both travel with the link.
type HealthStatusNote struct {
	Note   nav.NoteRef
	Type   string
	Status string
}

// HealthNoteFindings is one note the schema had something to say about: how
// many things it said, and how heavy the heaviest of them was. What it said
// stays on that note's own page, because one file described twice in two
// places is how two accounts of it start to disagree.
type HealthNoteFindings struct {
	Note     nav.NoteRef
	Severity judge.Severity
	Count    int
}

// HealthBlockedSource is one path the snapshot build could not read, with the
// error it returned.
type HealthBlockedSource struct {
	Path   string
	Reason string
}

// HealthSkippedSource is one path the generation saw and did not index, with
// what it is instead of a captured note. Size is set for a note refused
// because it is over the source bound; a scan skip has no size to report.
type HealthSkippedSource struct {
	Path   string
	Reason string
	Size   int64
}

// HealthIslandGroup is one folder's uncited notes.
type HealthIslandGroup struct {
	Dir   string
	Name  string
	Notes []nav.NoteRef
}

// HealthCollision is one name several files claim, with every claimant: the
// vault never picks one, so neither does this page.
type HealthCollision struct {
	Name       string
	Candidates []nav.NoteRef
}

// Health is the page listing what the folder owes: citations with nowhere to
// land, notes nothing reaches, and names two files both answer to. It states
// and never repairs; a person edits the file.
templ Health(v HealthView, c layouts.Chrome) {
	@layouts.Base(c) {
		<div class="y-nav-scrim" data-nav-close></div>
		<div class="y-shell2">
			@sidebar(v.Sidebar, c)
			<main id="main-content" tabindex="-1" class="y-main">
				<article class="y-article">
					<h1 class="y-title">{ wording.HealthTitle.In(c.Lang) }</h1>
					<div class="y-seam" aria-hidden="true"></div>
					if v.clean() {
						@nothingToShow(nothingNotice{Kind: "health"}) {
							<p>{ wording.HealthAllClear.In(c.Lang) }<code lang="en">yomihon check</code>{ wording.HealthAllClearAfterCommand.In(c.Lang) }</p>
						}
					} else {
						<p class="y-healthlede">{ wording.HealthReportsOnly.In(c.Lang) }</p>
						@healthUnknown(wording.HealthInstanceScopeUnknown.In(c.Lang), v.InstanceScopeUnknown)
						@healthUnknown(wording.HealthSchemaScopeUnknown.In(c.Lang), v.SchemaScopeUnknown)
						@healthFindings(v, c)
					}
				</article>
			</main>
			<aside class="y-rail-right" aria-label={ wording.ReadingAids.In(c.Lang) }></aside>
		</div>
	}
}

// healthFindings is every finding as one table, and under it what each kind of
// finding means. One table rather than one per kind, because the two questions
// a reader opens this page with — what is worst, and what is wrong with this
// one file — are both answers about the whole set, and neither can be read off
// a page that has already split it. Ordering is a link per column and needs no
// script: the server hands back the same table in the order that was asked for.
// A page with nothing to tabulate draws no table. It is reachable: a contract
// that cannot be read closes the schema checks and says so above, and a folder
// whose links all resolve then has a page that has something to tell the reader
// and no findings to tell it with. A header row of four ordering links over
// nothing offers four controls that each do nothing.
templ healthFindings(v HealthView, c layouts.Chrome) {
	{{ rows := v.rows(c.Lang) }}
	if len(rows) > 0 {
		<table class="y-findings">
			<thead>
				<tr>
					for _, col := range healthColumns {
						<th scope="col" class={ "y-findings__head", "y-findings__head--" + string(col) } { healthSortedAttrs(col, v.Sort)... }>
							<a class="y-findings__sort" href={ templ.URL(col.href()) }>{ col.name(c.Lang) }</a>
						</th>
					}
				</tr>
			</thead>
			<tbody>
				for _, row := range rows {
					<tr>
						<td class="y-findings__file" data-col={ wording.HealthColumnFile.In(c.Lang) }>
							if row.File.RelPath != "" {
								<a class="y-healthlink" href={ templ.URL(notesHref(row.File.RelPath)) }><span { authoredLanguageAttrs(row.File.Language)... }>{ row.File.Name }</span></a>
							} else {
								<span class="y-findings__path">{ row.FilePath }</span>
							}
						</td>
						<td class="y-findings__finding" data-col={ wording.HealthColumnFinding.In(c.Lang) }>
							<span class="y-findings__kind">{ row.Kind.title(c.Lang) }</span>
							if len(row.Detail) > 0 {
								<span class="y-findings__detail">
									for i, detail := range row.Detail {
										if i > 0 {
											<span aria-hidden="true">・</span>
										}
										@healthEvidence(detail)
									}
								</span>
							}
						</td>
						<td class="y-findings__severity" data-col={ wording.HealthColumnSeverity.In(c.Lang) }>
							if row.Weighed {
								<span class={ "y-severity", "y-severity--" + row.Severity.String() } lang="en">{ row.Severity.String() }</span>
							}
						</td>
						<td class="y-findings__count" data-col={ wording.HealthColumnCount.In(c.Lang) }>{ strconv.Itoa(row.Count) }</td>
					</tr>
				}
			</tbody>
		</table>
		@healthGuide(v, healthTallies(rows), c)
	}
}

// healthEvidence shows one piece of a finding's evidence as the words whoever
// wrote them chose. A machine's words are set in the face the machinery uses
// everywhere else, and a note the evidence names is reachable from it.
templ healthEvidence(detail healthDetail) {
	if detail.Text != "" {
		if detail.Machine {
			<code lang="en">{ detail.Text }</code>
		} else {
			<span>{ detail.Text }</span>
		}
	}
	if detail.Link.RelPath != "" {
		<a class="y-healthlink" href={ templ.URL(notesHref(detail.Link.RelPath)) }><span { authoredLanguageAttrs(detail.Link.Language)... }>{ detail.Link.Name }</span></a>
	}
}

// healthGuide explains each kind of finding the table holds, and how many of it
// there are. It is closed to begin with because a reader who already knows what
// a row claims came for the rows.
templ healthGuide(v HealthView, tallies []healthTally, c layouts.Chrome) {
	if len(tallies) > 0 {
		<details class="y-findingsguide">
			<summary class="y-findingsguide__head">{ wording.HealthGuideTitle.In(c.Lang) }</summary>
			<dl class="y-findingsguide__list">
				for _, tally := range tallies {
					<dt class="y-findingsguide__term">
						{ tally.Kind.title(c.Lang) }
						<span class="ui-navitem__count">{ strconv.Itoa(tally.Count) }</span>
					</dt>
					<dd class="y-findingsguide__meaning">{ v.kindLede(tally.Kind, c.Lang) }</dd>
				}
			</dl>
		</details>
	}
}

// healthUnknown states that a group of findings could not be worked out, and
// why, rendering nothing where the group was evaluated. The reason is the
// diagnostic of whatever claim failed, shown as written: rewording it would put
// this page's guess in front of the account the contract gave.
templ healthUnknown(title, reason string) {
	if reason != "" {
		<section class="y-healthsection y-healthsection--unknown">
			<h2 class="y-healthsection__title">{ title }</h2>
			<p class="y-healthsection__lede">{ reason }</p>
		</section>
	}
}
