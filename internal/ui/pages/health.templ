package pages

import (
	"strconv"

	"github.com/koopa0/yomihon/internal/judge"
	"github.com/koopa0/yomihon/internal/nav"
	"github.com/koopa0/yomihon/internal/snapshot"
	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// HealthView is the whole-folder answer to "what needs attention". Every note
// page can say what is wrong with itself, but nobody opens every note; these
// are the same facts, gathered.
type HealthView struct {
	// NavigationFaults are readable notes whose navigation trees could not be built.
	NavigationFaults []nav.CoreFault

	// Unwritten are citations to names no file carries and no ledger declared.
	Unwritten []snapshot.HealthLink
	// TitleOnly are citations naming a note's title — the note exists, and the
	// repair is an alias rather than a new note.
	TitleOnly []snapshot.HealthTitleLink
	// Islands are notes nothing cites in the body, grouped by folder.
	// A based_on declaration is not a citation here; the guide says so.
	Islands []HealthIslandGroup
	// IslandCount is every uncited note across the groups, so the page can tell
	// whether it has anything to report before it counts its own rows.
	IslandCount int
	// Collisions are names more than one file answers to.
	Collisions []HealthCollision
	// Blocked are vault sources the latest snapshot build could not read, so
	// the pages either lack them or hold their older captured content.
	Blocked []HealthBlockedSource
	// Notices are the standing facts about the folder that no unreadable file
	// explains, such as updates having stopped. Each says whether everything
	// below it is current, so they are drawn above the findings and never
	// paged or sorted away with them.
	Notices []FolderNotice
	// Skipped are paths the generation saw and did not index: a symbolic
	// link the scan passed over, or a note over the source bound. They are
	// separate from Blocked: nothing went wrong reading them, and no later
	// reading will pick them up as captured notes.
	Skipped []HealthSkippedSource
	// FrontmatterUnreadable are the notes whose frontmatter is not valid YAML,
	// so nothing they declare could be judged at all.
	FrontmatterUnreadable []HealthNoteFindings
	// SchemaFaults are the notes whose frontmatter reads and carries something
	// the schema does not accept. Enum repair carries the same declared
	// vocabulary as the note's own page.
	SchemaFaults []HealthNoteFindings
	// UnmappedConcepts are the concepts no map links to, and EmptyBranches the
	// map headings no note stands under. They are how the folder's maps cover
	// it, said for the author to see, and neither is a finding: no weight, no
	// count, and neither makes the folder less than clear.
	UnmappedConcepts []nav.NoteRef
	EmptyBranches    []snapshot.HealthEmptyBranch
	// InstanceScopeUnknown and SchemaScopeUnknown are why a group of the lists
	// above could not be worked out, empty where it could: an empty list under
	// a silent heading reads as "nothing found", which is a different and here
	// a false statement. They are filled in different places because the facts
	// are met in different places — which files are instances is settled while
	// a generation is built, whether the vocabulary can be read is settled per
	// request. Each carries the diagnostic of the claim that actually failed,
	// never a sentence chosen in advance.
	InstanceScopeUnknown string
	SchemaScopeUnknown   string
	// LastComplete is when the folder was last read whole, which is not always
	// when this page's generation was built: a reading that lost some sources
	// carries the last copy of each. Empty means no whole read since startup.
	LastComplete string
	// Sort is the column the reader asked the table to be ordered by, already
	// read against the closed set.
	Sort HealthColumn
	// Page is the stretch of the table the reader asked for, already read
	// against its own closed set. The zero value is the first page, so a
	// request that named none still gets one.
	Page    PageNumber
	Sidebar Sidebar
}

// HealthNoteFindings is one note the schema had something to say about: how
// many things it said, and how heavy the heaviest of them was. What it said
// stays on that note's own page, except the enum vocabulary needed for repair.
type HealthNoteFindings struct {
	Note     nav.NoteRef
	Severity judge.Severity
	Count    int
	// EnumNotices names the actual field vocabularies for enum faults.
	EnumNotices [][]wording.SchemaPart
}

// HealthBlockedSource is one path the snapshot build could not read, with the
// error it returned.
type HealthBlockedSource struct {
	Path       string
	Reason     string
	ParsePanic bool
}

// HealthSkippedSource is one path the generation saw and did not index, with
// what it is instead of a captured note. Size is set for a note refused
// because it is over the source bound; a scan skip has no size to report.
type HealthSkippedSource struct {
	Path   string
	Reason string
	Size   int64
}

// HealthIslandGroup is one folder's uncited notes.
type HealthIslandGroup struct {
	Dir   string
	Name  string
	Notes []nav.NoteRef
}

// HealthCollision is one name several files claim, with every claimant: the
// vault never picks one, so neither does this page.
type HealthCollision struct {
	Name       string
	Candidates []nav.NoteRef
}

// Health is the page listing what the folder owes: citations with nowhere to
// land, notes nothing reaches, and names two files both answer to. It states
// and never repairs; a person edits the file.
templ Health(v HealthView, c layouts.Chrome) {
	@layouts.Base(c) {
		<div class="y-nav-scrim" data-nav-close></div>
		<div class="y-shell2">
			@sidebar(v.Sidebar, c)
			<main id="_y-main" tabindex="-1" class="y-main">
				// A sheet of findings, a table to each kind, each a row of four
				// things read across, so this page is laid out on the shelf the
				// other listing pages take rather than in the column a note is
				// read in. Its name is the largest text on it: the page is about
				// what the folder has to say, and no figure is set above that.
				<article class="y-healthpage">
					<h1 class="y-title">{ wording.HealthTitle.In(c.Lang) }</h1>
					if v.clean() {
						@nothingToShow(nothingNotice{Kind: "health"}) {
							<p>{ wording.HealthAllClear.In(c.Lang) }<code lang="en">yomihon check</code>{ wording.HealthAllClearAfterCommand.In(c.Lang) }</p>
						}
						@healthCoverage(v, c)
					} else {
						<p class="y-healthlede">{ wording.HealthReportsOnly.In(c.Lang) }</p>
						@templ.Join(healthNotices(v.Notices), healthUnknown(wording.HealthInstanceScopeUnknown.In(c.Lang), v.InstanceScopeUnknown))
						@healthUnknown(wording.HealthSchemaScopeUnknown.In(c.Lang), v.SchemaScopeUnknown)
						@healthFindings(v, c)
					}
				</article>
			</main>
		</div>
	}
}

// healthFindings is every finding, a table to each kind under that kind's own
// name, and above them the report's shape. A kind is a group because the two
// questions a reader opens this page with — what is worst, and what is wrong
// with this one file — are answered inside a kind: the repair of an unwritten
// link and of a shared name are different work, and a table that mixed them
// listed one beside the other for no reason a reader could name. Ordering is a
// link per column and needs no script: the server hands back the same groups
// with the rows of each in the order that was asked for.
//
// A page with nothing to tabulate draws no table. It is reachable: a contract
// that cannot be read closes the schema checks and says so above, and a folder
// whose links all resolve then has a page that has something to tell the reader
// and no findings to tell it with. A header row of four ordering links over
// nothing offers four controls that each do nothing.
//
// A long report is divided rather than scrolled: the rows are gathered and
// ordered whole, the shape line above is counted from all of them, and only the
// stretch this request asked for is drawn, each group on it under its heading.
// The way the folder's maps cover its concepts is said after the last of them.
templ healthFindings(v HealthView, c layouts.Chrome) {
	{{ rows := v.rows(c.Lang) }}
	if len(rows) > 0 {
		{{ window, strip := v.divide(rows) }}
		@healthShapeLine(healthShapeOf(rows), c.Lang)
		if strip.Number > 0 {
			<p class="y-healthrange">{ healthRange(&strip, c.Lang) }</p>
		}
		for _, group := range healthGroups(window) {
			@healthGroupSection(v, group, c)
		}
		@pager(strip, c.Lang)
		if strip.Number == 0 || strip.Last == strip.Total {
			@healthCoverage(v, c)
		}
	} else {
		@healthCoverage(v, c)
	}
}

// healthGroupSection is one kind of finding: its name, what it is as a fold
// that starts closed, and its rows as a table whose four columns stand at the
// widths every table on the page shares. What the fold holds is explanation;
// every row, its weight and its count are drawn in the table, and a fact about
// the group that is not an explanation stands between the two.
templ healthGroupSection(v HealthView, group healthGroup, c layouts.Chrome) {
	{{ id := "health-kind-" + strconv.Itoa(int(group.Kind)) }}
	<section class="y-healthgroup" aria-labelledby={ id }>
		<h2 class="y-healthgroup__title" id={ id }>{ group.Kind.title(c.Lang) }</h2>
		<details class="y-healthabout">
			<summary class="y-healthabout__head">
				@chevron()
				{ wording.HealthAbout.In(c.Lang) }
			</summary>
			<p class="y-healthabout__text">{ v.kindLede(group.Kind, c.Lang) }</p>
		</details>
		if standing := v.kindStanding(group.Kind, c.Lang); standing != "" {
			<p class="y-healthgroup__standing">{ standing }</p>
		}
		<table class="y-findings">
			<colgroup>
				<col class="y-findings__col--file"/>
				<col class="y-findings__col--finding"/>
				<col class="y-findings__col--severity"/>
				<col class="y-findings__col--count"/>
			</colgroup>
			<thead>
				<tr>
					for _, col := range healthColumns {
						<th scope="col" class={ "y-findings__head", "y-findings__head--" + string(col) } { healthSortedAttrs(col, v.Sort)... }>
							<a class="y-findings__sort" href={ templ.URL(col.href()) }>{ col.name(c.Lang) }</a>
						</th>
					}
				</tr>
			</thead>
			<tbody>
				for _, row := range group.Rows {
					<tr { sourceBoundHealthAttrs(row.ID)... }>
						<td class="y-findings__file" data-col={ wording.HealthColumnFile.In(c.Lang) }>
							if row.File.RelPath != "" {
								<a class="y-healthlink" href={ templ.URL(notesHref(row.File.RelPath)) }><span { authoredLanguageAttrs(row.File.Language)... }>{ row.File.Name }</span></a>
							} else {
								<span class="y-findings__path">{ row.FilePath }</span>
							}
						</td>
						<td data-col={ wording.HealthColumnFinding.In(c.Lang) }>
							if len(row.Detail) > 0 {
								<span class="y-findings__detail">
									for i, detail := range row.Detail {
										if i > 0 {
											<span aria-hidden="true">・</span>
										}
										@healthEvidence(detail)
									}
								</span>
							}
						</td>
						<td class="y-findings__severity" data-col={ wording.HealthColumnSeverity.In(c.Lang) }>
							if row.Weighed {
								@healthSeverityBadge(row.Severity)
							}
						</td>
						<td class="y-findings__count" data-col={ wording.HealthColumnCount.In(c.Lang) }>{ strconv.Itoa(row.Count) }</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
}

// healthCoverage is how the folder's maps cover it, in two groups that each
// appear only when there is something in them: the concepts no map links to, and
// the map headings no note stands under. They are lists, not tables, because
// there is nothing to weigh or count in them, and they sit apart from the
// findings: a concept waiting for its map is not wrong, and a heading waiting
// for its first note is a place the author meant to write.
templ healthCoverage(v HealthView, c layouts.Chrome) {
	if len(v.UnmappedConcepts) > 0 {
		<section class="y-healthgroup" aria-labelledby="health-unmapped-concepts" data-health-coverage="concepts">
			<h2 class="y-healthgroup__title" id="health-unmapped-concepts">{ wording.HealthUnmappedConceptsTitle.In(c.Lang) }</h2>
			<ul class="y-healthlist" role="list">
				for _, note := range v.UnmappedConcepts {
					<li>
						<a class="y-healthlink" href={ templ.URL(notesHref(note.RelPath)) }><span { authoredLanguageAttrs(note.Language)... }>{ note.Name }</span></a>
						<span class="y-findings__path">{ note.RelPath }</span>
					</li>
				}
			</ul>
		</section>
	}
	if len(v.EmptyBranches) > 0 {
		<section class="y-healthgroup" aria-labelledby="health-empty-branches" data-health-coverage="branches">
			<h2 class="y-healthgroup__title" id="health-empty-branches">{ wording.HealthEmptyBranchesTitle.In(c.Lang) }</h2>
			<ul class="y-healthlist" role="list">
				for _, branch := range v.EmptyBranches {
					<li>
						<a class="y-healthlink" href={ templ.URL(notesHref(branch.Map.RelPath)) }><span { authoredLanguageAttrs(branch.Map.Language)... }>{ branch.Map.Name }</span></a>
						<span class="y-healthlist__branch" { authoredLanguageAttrs(branch.Map.Language)... }>{ branch.Heading }</span>
					</li>
				}
			</ul>
		</section>
	}
}

// healthSeverityBadge is the weight the judging face gives a finding, in that
// face's own word. It is marked English because that vocabulary never
// localises, and it is one component rather than two copies of the same
// three classes so the table's rows and the shape line above them are always
// drawn from the same mark.
templ healthSeverityBadge(s judge.Severity) {
	<span class={ "y-severity", "y-severity--" + s.String() } lang="en">{ s.String() }</span>
}

// healthShapeLine states the complete findings total, each weight the judge
// names, and the distinct files the table touches. All counts come from the
// whole report, before pagination. Unweighed findings contribute to the total
// without acquiring a severity. Each weight links to the table ordered by it.
templ healthShapeLine(shape healthShape, lang wording.Lang) {
	if shape.Files > 0 {
		<p class="y-healthshape">
			<span class="y-healthshape__total">{ plural(shape.Total, wording.LibraryFindingOne, wording.LibraryFindingMany, lang) }</span>
			for _, weight := range shape.Weights {
				<span aria-hidden="true">·</span>
				<a class="y-healthshape__weight" href={ templ.URL(HealthBySeverity.href()) }>
					@healthSeverityBadge(weight.Severity)
					{ strconv.Itoa(weight.Count) }
				</a>
			}
			<span aria-hidden="true">·</span>
			<span>{ plural(shape.Files, wording.HealthShapeFilesOne, wording.HealthShapeFilesMany, lang) }</span>
		</p>
	}
}

// healthEvidence shows one piece of a finding's evidence as the words whoever
// wrote them chose. A machine's words are set in the face the machinery uses
// everywhere else, and a note the evidence names is reachable from it.
templ healthEvidence(detail healthDetail) {
	if len(detail.Parts) > 0 {
		<span>
			@schemaParts(detail.Parts)
		</span>
	}
	if detail.Text != "" {
		if detail.Machine {
			<code lang="en">{ detail.Text }</code>
		} else {
			<span>{ detail.Text }</span>
		}
	}
	if detail.Link.RelPath != "" {
		<a class="y-healthlink" href={ templ.URL(notesHref(detail.Link.RelPath)) }><span { authoredLanguageAttrs(detail.Link.Language)... }>{ detail.Link.Name }</span></a>
	}
}

// healthNotice states a standing fact about the folder that the findings below
// it cannot carry: they are as of the last reading the pages could make, and
// the notice says why that reading is not the folder as it is now. It is a
// section above the table rather than a row in it, because a row can be
// sorted onto another page and this has to be seen.
templ healthNotice(n FolderNotice) {
	<section class="y-healthsection y-healthsection--notice" data-health-notice>
		<h2 class="y-healthsection__title">{ n.Title }</h2>
		<p class="y-healthsection__lede">
			@browserDiagnostic(n.Summary, n.Detail)
		</p>
	</section>
}

// healthUnknown states that a group of findings could not be worked out, and
// why, rendering nothing where the group was evaluated. The reason is the
// diagnostic of whatever claim failed, shown as written: rewording it would put
// this page's guess in front of the account the contract gave.
templ healthUnknown(title, reason string) {
	if reason != "" {
		<section class="y-healthsection">
			<h2 class="y-healthsection__title">{ title }</h2>
			<p class="y-healthsection__lede">{ reason }</p>
		</section>
	}
}
