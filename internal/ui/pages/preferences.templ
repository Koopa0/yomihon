package pages

import (
	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// PreferencesView is the reading as this browser currently has it set: every
// choice on offer, in the order the page shows them, and the address applying
// them sends the reader back to.
//
// The values and their words are already resolved. This page decides how a
// choice looks and nothing about what a choice is — which of them exist, what
// each may be set to, and which is in force are all settled before the view is
// built, so no second answer to any of those questions is reachable from here.
type PreferencesView struct {
	Fields []PreferenceField
	// ReturnTo is the address every form carries, so applying a choice lands
	// the reader back on what they were reading. It has already been checked
	// as a path this site can return to.
	ReturnTo string
	// Settings is this page's own address with that same way back kept on it.
	// A choice only the server can make sends the reader here rather than home
	// to their article, so the visit survives the answer.
	Settings string
	// Reading is what the reader was holding when they came, and empty when
	// that was this page.
	Reading string
}

// PreferenceField is one choice: the form field it is submitted under, the
// heading it sits behind, the sentence that says what it does and what it
// leaves alone, the sentence it says when a choice cannot be kept, and the
// options a reader picks between. Options is never empty, and exactly one of
// them is marked. Note may be empty: a row whose options say all there is to
// say draws no sentence, and its options then carry no description to point at.
type PreferenceField struct {
	Name    string
	Legend  string
	Note    string
	Refused string
	Options []PreferenceOption
}

// PreferenceOption is one answer a choice may be given: the value the form
// sends, the word the reader picks it by, whether it is the answer in force for
// this request, whether picking it stores anything, and whether it is the
// answer a browser storing nothing here is looking at.
//
// The last two are what let the page be read back correctly by something other
// than the server. Exactly one option of a choice is Unset; an option that is
// not Stores is held by the absence of a stored value, so choosing it removes
// one rather than writing one.
type PreferenceOption struct {
	Value   string
	Label   string
	Checked bool
	Stores  bool
	Unset   bool
}

// Preferences is the page a reader sets the reading on.
//
// It carries no folder tree. Every other page here is somewhere in the library
// and needs the way onward; this one is reached from a control on whatever page
// the reader was already holding, and returns them to it the moment a choice is
// applied. A rail down the side would invite a walk this page has no business
// starting.
//
// The choices are one form with one submit, so a reader who sets a size and a
// typeface in the same visit gets both: nothing picked can be discarded,
// because everything picked is sent. It is a plain post, so the page works with
// no scripting at all — which is not a courtesy here but the mechanism: the
// words on a page are written by the server, and the only honest way to change
// them is to ask the server for the page again.
//
// Each choice is a column section named by a small heading, not a box cut by a
// title — the rest of the interface separates a group of controls by space and
// a label, never a frame, and this page is drawn the same way. The keyboard
// shortcuts, which the ? key also lists in a panel over any page, get the same
// treatment: a heading of their own rather than a list sitting under nothing.
//
// On a wide window the page is a bench of two columns: the choices down the
// left, and beside them a sheet of reading set in whatever the choices say,
// which stays in view while the column scrolls (see preferenceSheet). On a
// narrower one the sheet stands above the choices and scrolls away with the
// page. The choices come first in the document either way, so the order a
// keyboard meets them in is the order they are read in.
//
// Where scripting is running, that same form is the ground rather than the
// path. Each option carries what a reader of the page other than the server
// needs to keep a choice as it is picked — the address to come back to, what
// the choice is called where it is stored, whether picking it stores anything,
// and which option answers for storing nothing — and the submit that is then
// not needed is taken off the page rather than left sitting there promising a
// step that is already done. Nothing is marked here that the form did not
// already have to say in order to be refused correctly.
templ Preferences(v PreferencesView, c layouts.Chrome) {
	@layouts.Base(c) {
		<main id="_y-main" tabindex="-1" class="y-prefs">
			<h1 class="y-title">{ wording.PreferencesTitle.In(c.Lang) }</h1>
			<p class="y-prefs__lede">{ wording.PreferencesLede.In(c.Lang) }</p>
			<div class="y-prefs__bench">
				<div class="y-prefs__controls">
					<form method="post" action="/preferences" data-prefs data-prefs-settings={ v.Settings }>
						for _, field := range v.Fields {
							@preferenceField(field)
						}
						<input type="hidden" name="next" value={ v.ReturnTo }/>
						<button class="y-prefs__apply y-prefs__fallback" type="submit">{ wording.PrefApply.In(c.Lang) }</button>
					</form>
					if v.Reading != "" {
						// The way back, for the reader whose choices are kept as they
						// pick them and who therefore never presses the control above.
						<a class="y-prefs__return" href={ templ.URL(v.Reading) }>{ wording.PrefReturn.In(c.Lang) }</a>
					}
					@preferenceReset(v.ReturnTo, c.Lang)
					<section class="y-prefs__shortcuts">
						<h2>{ wording.PrefKeyboardShortcutsTitle.In(c.Lang) }</h2>
						@layouts.KeyboardKeys(c.Lang)
					</section>
					<footer class="y-prefs__storage">
						<h2>{ wording.PrefStorageTitle.In(c.Lang) }</h2>
						<ul>
							<li>{ wording.PrefStorageCookies.In(c.Lang) }</li>
							<li>{ wording.PrefStorageLocal.In(c.Lang) }</li>
							<li>{ wording.PrefStorageSession.In(c.Lang) }</li>
						</ul>
						<p>{ wording.PrefStorageNote.In(c.Lang) }</p>
					</footer>
				</div>
				@preferenceSheet(c.Lang)
			</div>
		</main>
	}
}

// preferenceSheet is a piece of reading set beside the choices: a section's
// heading with the buttons a note draws beside one, and a paragraph with code in
// it. It is not a picture of a note but a note's own markup under a note's own
// classes, so the stylesheet that sets the reading sets it too, from the same
// attributes on the root. A choice picked above moves the root, and the sheet
// moves with it in the same frame, with nothing written to keep it in step;
// where no script runs it shows the choices the page was drawn with, which are
// the ones a note would be drawn with as well.
//
// It is hidden from assistive technology and holds nothing that takes focus.
// What it shows is how the reading looks, which the words of the choices
// already say to a reader who cannot see it; read out, it would be a paragraph
// about starting a server in the middle of the settings. The buttons beside the
// heading are therefore drawn as words and not as controls: they answer the
// pointer the way a note's do, and do nothing.
templ preferenceSheet(lang wording.Lang) {
	<div class="y-prefs__sheet" lang={ lang.Tag() } aria-hidden="true">
		<div class="y-prose">
			<div class="y-sect">
				<div data-level="2">{ wording.PrefSampleHeading.In(lang) }</div>
				<div class="y-margin">
					<span class="y-margin__act" data-text={ wording.QuestionControl.In(lang) }></span>
					<span class="y-margin__act" data-text={ wording.ThoughtDoor.In(lang) }></span>
				</div>
			</div>
			<p>{ wording.PrefSampleOpen.In(lang) }<code>{ wording.PrefSampleAddress.In(lang) }</code>{ wording.PrefSampleMiddle.In(lang) }<code>{ wording.PrefSampleKey.In(lang) }</code>{ wording.PrefSampleClose.In(lang) }</p>
		</div>
	</div>
}

// preferenceField is one choice, grouped under the heading that names it. It
// carries no submit of its own: the choice is kept the moment it is picked
// where anything is running to keep it, and where nothing is, the one control
// at the foot of the form sends this choice along with every other, so nothing
// picked further up the page is lost.
//
// The line under the options is empty on arrival and stays empty for as long as
// the choices are being kept. It is announced rather than merely drawn, because
// a reader who cannot see the radio go back needs to be told that it did.
templ preferenceField(f PreferenceField) {
	<fieldset class="y-preffield" data-pref-field={ f.Name }>
		<legend>{ f.Legend }</legend>
		@preferenceNote(f)
		<div class="y-preffield__options">
			for _, option := range f.Options {
				<label>
					<input
						type="radio"
						name={ f.Name }
						value={ option.Value }
						checked?={ option.Checked }
						data-pref-stores?={ option.Stores }
						data-pref-unset?={ option.Unset }
						if f.Note != "" {
							aria-describedby={ "pref-note-" + f.Name }
						}
					/><span>{ option.Label }</span>
				</label>
			}
		</div>
		@layouts.Reply("y-preffield__status", templ.Attributes{"data-pref-status": true, "data-pref-refused": f.Refused, "data-reply-tone": "refused"})
	</fieldset>
}

// preferenceNote is the sentence under a choice's heading, drawn only where the
// choice has one. It is a component of its own so that leaving it out changes
// nothing else in the bytes of the row.
templ preferenceNote(f PreferenceField) {
	if f.Note != "" {
		<p class="y-preffield__note" id={ "pref-note-" + f.Name }>{ f.Note }</p>
	}
}

// preferenceReset clears everything the page above it can set. It stays a form
// of its own because it is the opposite act: the form above applies what a
// reader picked, and this one throws all of it away, so pressing either must
// never be able to mean the other. It is a single button rather than a pair of
// options because there is no second state to choose: the sentence beside it
// names what goes, including the one thing a reader would not predict — the
// interface comes back speaking the language it started in.
templ preferenceReset(returnTo string, lang wording.Lang) {
	<form method="post" action="/preferences">
		<fieldset class="y-preffield">
			<legend>{ wording.PrefReset.In(lang) }</legend>
			<p class="y-preffield__note" id="pref-note-reset">{ wording.PrefResetNote.In(lang) }</p>
			<input type="hidden" name="next" value={ returnTo }/>
			<button class="y-prefs__apply" type="submit" name="reset" value="1" aria-describedby="pref-note-reset">{ wording.PrefReset.In(lang) }</button>
		</fieldset>
	</form>
}
