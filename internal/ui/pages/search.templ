package pages

import (
	"strconv"

	"github.com/koopa0/yomihon/internal/nav"
	"github.com/koopa0/yomihon/internal/ui/layouts"
)

// SearchView is everything the search results page needs. Diagnostic names a
// metadata capability failure and is distinct from an ordinary empty result.
// Its fields are plain values (not internal/search types) so internal/ui/pages
// does not import internal/search — the search handler maps its results onto
// SearchResult, keeping the import one-directional (search → pages), like the
// reading page.
type SearchView struct {
	Query      string
	Results    []SearchResult
	Diagnostic string

	// Nav is the whole-vault navigation model for the shared sidebar: the
	// search page renders inside the same shell as every other page, so a
	// topbar chip or a search never strands the reader in a chromeless view.
	Nav *nav.Model
}

// SearchResult is one rendered hit: the note's path (linked), display title,
// status, and a context snippet.
type SearchResult struct {
	RelPath string
	Title   string
	Status  string
	Snippet string
}

// Search is the results page: a GET form and a flat list of hits, rendered in
// the shared shell — header and navigation sidebar included, mounted with no
// current note so every branch renders closed, the same wiring the report
// shell uses. The form remains the no-JavaScript path; the live-search data
// hooks let the shared script refresh only the result region while typing.
templ Search(v SearchView, c layouts.Chrome) {
	@layouts.Base(c) {
		<div class="y-nav-scrim" data-nav-close></div>
		<div class="y-shell2">
			@sidebar(NewSidebar(v.Nav, ""))
			<main class="y-main">
				<div class="y-searchpage" data-live-search data-live-search-endpoint="/search/results">
					<form class="y-searchpage__form" method="get" action="/search" role="search" data-live-search-form>
						<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
						<input type="search" name="q" value={ v.Query } placeholder="Search notes" aria-label="Search notes" data-live-search-input autofocus/>
						<button type="submit" class="y-xbtn">Search</button>
					</form>
					<p class="y-live-search__status" data-live-search-status role="status" aria-live="polite" aria-atomic="true"></p>
					@SearchResults(v.Query, v.Results, v.Diagnostic)
				</div>
			</main>
		</div>
	}
}

// SearchResults is the server-rendered lexical-results fragment shared by the
// full results page and the progressive search fields. The outer data marker is
// the HTML-to-JavaScript contract; the result links remain ordinary navigation.
templ SearchResults(query string, results []SearchResult, diagnostic string) {
	<div class="y-searchresults" data-live-search-results data-result-count={ strconv.Itoa(len(results)) } aria-busy="false">
		if diagnostic != "" {
			<div class="y-searchpage__empty" data-search-diagnostic>
				<p>Metadata search unavailable.</p>
				<p class="y-searchpage__hint">{ diagnostic }</p>
			</div>
		} else if len(results) > 0 {
			<div class="y-results">
				for _, r := range results {
					<a class="y-result" href={ templ.URL(notesHref(r.RelPath)) }>
						<span class="y-result__title">{ r.Title }</span>
						<span class="y-result__meta">
							{ r.RelPath }
							if r.Status != "" {
								<span class="y-result__sep" aria-hidden="true">·</span>
								{ r.Status }
							}
						</span>
						if r.Snippet != "" {
							<span class="y-result__snippet">{ r.Snippet }</span>
						}
					</a>
				}
			</div>
		} else if query != "" {
			<div class="y-searchpage__empty">
				<p>No results for &quot;{ query }&quot;.</p>
				<p class="y-searchpage__hint">Try fewer or different words, or narrow by lifecycle with status:draft.</p>
			</div>
		}
	</div>
}
