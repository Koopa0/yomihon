package pages

import (
	"strconv"

	"github.com/koopa0/yomihon/internal/nav"
	"github.com/koopa0/yomihon/internal/ui/layouts"
)

// SearchView is everything the search results page needs. Diagnostic names a
// metadata capability failure and is distinct from an ordinary empty result.
// Its fields are plain values (not internal/search types) so internal/ui/pages
// does not import internal/search — the search handler maps its results onto
// SearchResult, keeping the import one-directional (search → pages), like the
// reading page.
type SearchView struct {
	Query   string
	Results []SearchResult

	// Total is how many hits the query truly has. Results holds at most the
	// handler's bounded opening stretch of them, and the count line says both
	// numbers whenever the two differ.
	Total      int
	Diagnostic string

	// StepBacks are the loosened searches offered when nothing matched — each
	// one already run and known to find something, with its count, so the page
	// never again advises a search it has made useless.
	StepBacks []SearchStepBack

	// Governed says this generation has a lifecycle contract behind it. It
	// gates the advice offered when nothing matched: a status filter is only
	// worth suggesting where statuses exist, and a reader whose folder has none
	// followed that suggestion, got nothing again, and was handed the same
	// sentence a second time.
	Governed bool

	// Nav is the whole-vault navigation model for the shared sidebar: the
	// search page renders inside the same shell as every other page, so
	// arriving at a search never strands the reader in a chromeless view.
	Nav *nav.Model
}

// SearchResult is one rendered hit: the entry's path (linked), display title,
// status, and a context snippet.
type SearchResult struct {
	RelPath string
	Title   string
	Status  string
	Snippet string

	// SnippetRuns is the same snippet cut into the stretches that matched the
	// query and the stretches that did not, so the page can mark the words the
	// reader typed. Readers were handed a grey block and left to find their own
	// term inside it; a doctor scanning mid-clinic and a musician with a bow in
	// one hand both said the same thing about it. Every run's text is rendered
	// as text, so a note can no more become markup here than it could before.
	SnippetRuns []SnippetRun

	// File marks a hit that is a vault file rather than a note. It is named on
	// the row because a file has no lifecycle and never will, so a reader
	// scanning a list of results does not read its missing status as a note
	// whose status went missing.
	File bool

	// StatusOutsideEnum marks a hit whose status value is not one the vault
	// contract declares for this note's type. The row printed the value as
	// plain text beside the path, which made a value nothing allows look
	// exactly like one everything does — and a reader filtering by that value
	// is precisely the reader who needs to be told.
	StatusOutsideEnum bool
}

// resultCount names how many hits a search returned, in the reader's
// language. When the list holds only the opening stretch of a larger answer,
// it says both numbers, so the count never claims the page shows more than it
// does.
func resultCount(shown, total int) string {
	if total > shown {
		return "共 " + strconv.Itoa(total) + " 筆，顯示前 " + strconv.Itoa(shown) + " 筆"
	}
	return "共 " + strconv.Itoa(total) + " 筆"
}

// SnippetRun is one stretch of a result's snippet, marked or not.
type SnippetRun struct {
	Text string
	Hit  bool
}

// Search is the results page: a GET form and a flat list of hits, rendered in
// the shared shell — header and navigation sidebar included, mounted with no
// current note so every branch renders closed, the same wiring the report
// shell uses. The form remains the no-JavaScript path; the live-search data
// hooks let the shared script refresh only the result region while typing.
// SearchStepBack is one loosened search the empty page offers: a query the
// index has already answered, with how many notes it found.
type SearchStepBack struct {
	Query string
	Count int
}

templ Search(v SearchView, c layouts.Chrome) {
	@layouts.Base(c) {
		<div class="y-nav-scrim" data-nav-close></div>
		<div class="y-shell2">
			@sidebar(NewSidebar(v.Nav, ""), c.Nonce)
			<main id="main-content" tabindex="-1" class="y-main">
				// data-live-search-sync-url marks the one live region whose results
				// the address bar describes: this page is the form's own target, so
				// after a live refresh the URL is rewritten to what submitting the
				// form would produce, and a copied address reproduces the results on
				// screen. The command-palette dialog floats over pages it does not
				// own and never carries the marker.
				<div class="y-searchpage" data-live-search data-live-search-endpoint="/search/results" data-live-search-sync-url>
					// The page opens by saying which page it is. Arriving here by
					// ear there was nothing to land on: the first thing announced
					// was a text field, with no word for where it sat. The count
					// is already stated above the hits, so this says only that.
					<h1 class="y-title">搜尋</h1>
					<form class="y-searchpage__form" method="get" action="/search" role="search" data-live-search-form>
						<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
						<input type="search" name="q" value={ v.Query } placeholder="搜尋筆記" aria-label="搜尋筆記" data-live-search-input autofocus/>
						<button type="submit" class="y-xbtn">搜尋</button>
					</form>
					<p class="y-live-search__status" data-live-search-status role="status" aria-live="polite" aria-atomic="true"></p>
					@SearchResults(v.Query, v.Results, v.Total, v.Diagnostic, v.Governed, v.StepBacks)
				</div>
			</main>
		</div>
	}
}

// SearchResults is the server-rendered lexical-results fragment shared by the
// full results page and the progressive search fields. The outer data marker
// is the HTML-to-JavaScript contract — it carries the true match tally, which
// the live-search status line announces, while the list below holds at most
// the handler's bounded opening stretch; the result links remain ordinary
// navigation.
templ SearchResults(query string, results []SearchResult, total int, diagnostic string, governed bool, stepBacks []SearchStepBack) {
	<div class="y-searchresults" data-live-search-results data-result-count={ strconv.Itoa(total) } aria-busy="false">
		if diagnostic != "" {
			<div class="y-searchpage__empty" data-search-diagnostic>
				<p>中介資料搜尋目前無法使用。</p>
				<p class="y-searchpage__hint">
					@browserDiagnostic("vault schema 的治理資料無法使用。", diagnostic)
				</p>
			</div>
		} else if len(results) > 0 {
			// The count lived only in the live region the client script writes,
			// so a reader looking at the page saw no number and a reader without
			// scripting got none at all. Four of them asked how many.
			<p class="y-results__count">{ resultCount(len(results), total) }</p>
			// The hits are one set, so they are marked as one: a listener is
			// told where it starts, how many it holds, and where it ends. The
			// role is written out because the style reset takes the markers
			// off, and a list without markers loses its meaning outright in
			// WebKit.
			<ol class="y-results" role="list">
				for _, r := range results {
					<li>
						<a class="y-result" href={ templ.URL(notesHref(r.RelPath)) }>
							<span class="y-result__title">{ r.Title }</span>
							<span class="y-result__meta">
								{ r.RelPath }
								if r.Status != "" {
									<span class="y-result__sep" aria-hidden="true">·</span>
									{ r.Status }
									if r.StatusOutsideEnum {
										// Words, not a colour: the row is read
										// by people who cannot see the amber,
										// and it is the link's own text, so
										// what is spoken is what is printed.
										<span class="y-result__flag">不在 schema 允許清單中</span>
									}
								}
								if r.File {
									<span class="y-result__sep" aria-hidden="true">·</span>
									<span class="y-result__kind">檔案</span>
								}
							</span>
							if len(r.SnippetRuns) > 0 {
								<span class="y-result__snippet">
									for _, run := range r.SnippetRuns {
										if run.Hit {
											<mark>{ run.Text }</mark>
										} else {
											{ run.Text }
										}
									}
								</span>
							} else if r.Snippet != "" {
								<span class="y-result__snippet">{ r.Snippet }</span>
							}
						</a>
					</li>
				}
			</ol>
		} else if query != "" {
			<div class="y-searchpage__empty">
				<p>找不到「{ query }」的結果。</p>
				if len(stepBacks) > 0 {
					<p class="y-searchpage__hint">
						退一步找：
						for i, step := range stepBacks {
							if i > 0 {
								<span aria-hidden="true">・</span>
							}
							<a href={ templ.URL(searchHref(step.Query)) }>「{ step.Query }」</a>
							（{ strconv.Itoa(step.Count) } 筆）
						}
					</p>
				}
				if governed {
					<p class="y-searchpage__hint">搜尋涵蓋筆記，以及任何能以文字呈現的檔案；圖片、PDF 與其他二進位檔案只在導覽中列出，內容不會被讀取。請嘗試較少或不同的詞，或用 <code>status:draft</code> 依生命週期縮小範圍。</p>
				} else {
					<p class="y-searchpage__hint">搜尋涵蓋筆記，以及任何能以文字呈現的檔案；圖片、PDF 與其他二進位檔案只在導覽中列出，內容不會被讀取。請嘗試較少或不同的詞。</p>
				}
			</div>
		}
	</div>
}
