package pages

import (
	"fmt"
	"github.com/koopa0/yomihon/internal/wording"
	"strconv"
	"strings"

	"github.com/koopa0/yomihon/internal/ui/layouts"
)

// SearchView is everything the search results page needs. Diagnostic names a
// metadata capability failure and is distinct from an ordinary empty result.
// Its fields are plain values, so the search handler maps its own results onto
// them and the import stays one-directional.
type SearchView struct {
	Query   string
	Results []SearchResult

	// Total is how many hits the query truly has. Results holds at most the
	// handler's bounded opening stretch of them, and the count line says both
	// numbers whenever the two differ.
	Total      int
	Diagnostic string

	// UnknownFilterKeys are the words this query wrote before a colon that the
	// grammar does not accept. Their terms were searched for as text, and
	// without saying so the reader is left believing a constraint ran.
	UnknownFilterKeys []string
	// FilterKeys are the keys the grammar does accept, so the reader can see
	// what to write instead. They come from the parser rather than a list kept
	// here, which would drift.
	FilterKeys []string

	// StepBacks are the loosened searches offered when nothing matched, each
	// already run and known to find something, so the page never advises a
	// search it has made useless.
	StepBacks []SearchStepBack

	// Facets is the column beside the results: what the current answer is made
	// of, and the narrower search each part of it leads to. It is empty on the
	// live-search dialog, which asks the same endpoint for the same rows and
	// has no column to put them in.
	Facets []SearchFacet

	// Governed says this generation has a lifecycle contract behind it, which
	// gates the advice offered when nothing matched: a status filter is only
	// worth suggesting where statuses exist.
	Governed bool

	// Sidebar is the resolved left navigation, built where every other page
	// builds it, so arriving at a search never strands the reader in a
	// chromeless view.
	Sidebar Sidebar
}

// SearchResult is one rendered hit: the entry's path (linked), display title,
// status, and a context snippet.
type SearchResult struct {
	RelPath string
	Title   string
	// Language is the note's own declared BCP 47 tag when the contract gave
	// the field authority and the frontmatter carried a valid value. Empty
	// otherwise, so a listing inherits the page language rather than guessing.
	Language string
	Status   string
	Snippet  string

	// SnippetRuns is the snippet cut into the stretches that matched the query
	// and the stretches that did not, so the page can mark the words the reader
	// typed. Every run's text is rendered as text, so a note can no more become
	// markup here than it could before.
	SnippetRuns []SnippetRun

	// PathRuns is where this note lives, cut the same way, so a hit reached
	// through its path can say so — such a hit has no snippet, nothing in its
	// words having matched. It is empty where the path holds nothing the query
	// asked for, which is most rows.
	PathRuns []SnippetRun

	// AliasRuns is the name that answered the query where it was not the title,
	// cut the same way. The row shows a title, so a reader who searched one of a
	// note's other names would otherwise see nothing of what they typed.
	AliasRuns []SnippetRun

	// TopicRuns is the declared subject that answered the query where title,
	// alias and body did not. A topic-only hit has no snippet, so without this
	// the query word appears nowhere on the row.
	TopicRuns []SnippetRun

	// File marks a hit that is a vault file rather than a note, named on the row
	// so a missing status does not read as a note's status gone missing.
	File bool

	// StatusOutsideEnum marks a hit whose status value the contract does not
	// declare for this note's type, so a value nothing allows does not look
	// exactly like one everything does.
	StatusOutsideEnum bool

	// Landing is the first-block stretch a browser text directive can find
	// for a body hit. Empty when the row has no body match, or when a
	// crossing match has nothing locatable in its first block.
	Landing string

	// LandingBare is the stretch to name where no words go ahead of it in the
	// directive: Landing grown out to the edges of the words it lies inside,
	// because a browser looks for a run introduced by nothing only where a
	// word begins and where one ends. It equals Landing for most matches, and
	// a row that carries a landing carries this too — a row filled in without
	// it offers the reader no directive at all.
	LandingBare string

	// LandingEnd is the last-block stretch of a crossing match, so the
	// directive can name a range instead of the first copy of a word.
	LandingEnd string

	// LandingPrefix is the run of words the match follows inside the block
	// its first stretch opens, so the directive can say which copy of that
	// stretch it means. A browser walks the whole page in order, and the
	// rail is drawn before the article. Empty where the match opens its
	// block.
	LandingPrefix string

	// BlockCrossing reports that the match continues into a later block, so
	// a directive built from the whole phrase would find nothing.
	BlockCrossing bool

	// FromFence marks a hit whose deciding excerpt is a fenced block. The
	// row names that, the way it names an alias or a topic, so the
	// excerpt can stay the fence's own lines.
	FromFence bool
}

// SnippetRun is one stretch of a result's snippet, marked or not.
type SnippetRun struct {
	Text string
	Hit  bool
}

// SearchStepBack is one loosened search the empty page offers: a query the
// index has already answered, with how many notes it found.
type SearchStepBack struct {
	Query string
	Count int
}

// SearchFacet is one key the current answer divides along: the name of the
// field in the reader's language, the key itself for a surface that needs to
// say which division it is looking at, and one row per value.
type SearchFacet struct {
	Key     string
	Heading string
	Rows    []SearchFacetRow
}

// SearchFacetRow is one value of a division: what it is called, how many of
// the current hits are at it, and the search that follows from it.
type SearchFacetRow struct {
	// Label is the value in the vault's own spelling, or the sentence standing
	// for the hits that declared none.
	Label string
	Count int

	// Query is the search this row leads to — the current query narrowed to
	// this value, or, for a value already in it, the current query with that
	// constraint taken out. It is empty where there is no search to offer: the
	// hits that declared nothing cannot be asked for, since the grammar has no
	// way to write "this field is absent", and neither can a value this
	// grammar cannot spell. A row with no query is a cell rather than a link.
	Query string

	// Active marks a value the current query already names, whose row leads
	// back out of it rather than further in.
	Active bool

	// OutsideEnum marks a value no note type carrying it declares, so a value
	// nothing allows does not look exactly like one everything does. It is the
	// same verdict the result rows wear, reached the same way.
	OutsideEnum bool

	// Unstated marks the row standing for the hits that declared no value for
	// this key. It is kept off the values rather than sorted among them,
	// because "no domain declared" is not a domain.
	Unstated bool
}

// Search is the results page: a GET form and a flat list of hits in the shared
// shell, mounted with no current note so every branch renders closed. The form
// is the no-JavaScript path; the live-search data hooks let the shared script
// refresh only the result region while typing.
templ Search(v SearchView, c layouts.Chrome) {
	@layouts.Base(c) {
		<div class="y-nav-scrim" data-nav-close></div>
		<div class="y-shell2">
			@sidebar(v.Sidebar, c)
			<main id="main-content" tabindex="-1" class="y-main">
				// data-live-search-sync-url marks the one live region whose
				// results the address bar describes. This page is the form's
				// own target, so after a live refresh the URL is rewritten to
				// what submitting would produce and a copied address reproduces
				// the results. The command-palette dialog floats over pages it
				// does not own and never carries the marker.
				// The endpoint carries the one difference between this page and
				// the command palette, which asks the same route for the same
				// rows: only a page with a column beside the results asks for
				// the divisions that go in it. The script builds its request
				// from this attribute and sets the query on top, so the marker
				// rides along without the script knowing it is there.
				<div class="y-searchpage" data-live-search data-live-search-endpoint="/search/results?facets=1" data-live-search-sync-url>
					// The page opens by saying which page it is, so arriving by
					// ear lands on something other than an unexplained text
					// field. The count is already stated above the hits, so this
					// says only that.
					<h1 class="y-title">{ wording.SearchTitle.In(c.Lang) }</h1>
					// The field is not focused on arrival. Inside the palette that
					// is the whole point — it opens on a keystroke and the reader
					// is already typing — but this page is reached deliberately,
					// and a reader who follows a result and comes back would land
					// in the text box rather than near the result they left, with
					// the skip link already behind them.
					<search>
						<form class="y-searchpage__form" method="get" action="/search" data-live-search-form>
							<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
							<input type="search" name="q" value={ v.Query } placeholder={ wording.SearchNotesField.In(c.Lang) } aria-label={ wording.SearchNotesField.In(c.Lang) } data-live-search-input/>
							<button type="submit" class="y-xbtn">{ wording.SearchSubmit.In(c.Lang) }</button>
						</form>
					</search>
					@layouts.LiveSearchStatus(c.Lang)
					@SearchResults(v, c.Lang)
				</div>
			</main>
		</div>
	}
}

// SearchResults is the server-rendered results fragment shared by the full page
// and the progressive search fields. The outer data marker carries the true
// match tally, which the live-search status line announces, while the list below
// holds at most the handler's bounded opening stretch.
templ SearchResults(v SearchView, lang wording.Lang) {
	<div class="y-searchresults" data-live-search-results data-result-count={ strconv.Itoa(v.Total) } aria-busy="false">
		if len(v.Facets) > 0 {
			@searchFacets(v.Facets, lang)
		}
		<div class="y-searchresults__body">
			if v.Query != "" {
				// Which query these rows answer, carried with them and hidden. The
				// live search shows it when a refresh fails and leaves them standing;
				// with no script there is no such moment, and the page is unchanged.
				<p class="y-live-search__status" data-live-search-stale={ v.Query } hidden>{ fmt.Sprintf(wording.LiveSearchStaleFmt.In(lang), v.Query) }</p>
			}
			if len(v.UnknownFilterKeys) > 0 {
				// Said whatever the outcome: this is about how the query was read,
				// not how many notes answered it, so a query that also found
				// something still hears it.
				<p class="y-searchpage__hint" data-unknown-filter>
					{ fmt.Sprintf(wording.UnknownFilterFmt.In(lang), strings.Join(v.UnknownFilterKeys, wording.ListSeparator.In(lang))) }
					for i, key := range v.FilterKeys {
						if i > 0 {
							{ wording.ListSeparator.In(lang) }
						}
						<code>{ key + ":" }</code>
					}
					{ wording.UnknownFilterEnd.In(lang) }
				</p>
			}
			if v.Diagnostic != "" {
				<div class="y-searchpage__empty" data-search-diagnostic>
					<p>{ wording.MetadataSearchUnavailable.In(lang) }</p>
					<p class="y-searchpage__hint">
						@browserDiagnostic(wording.GovernanceUnavailable.In(lang), v.Diagnostic)
					</p>
				</div>
			} else if len(v.Results) > 0 {
				// Printed rather than left to the live region the client writes,
				// so a reader without scripting still learns how many the query
				// found, and a reader looking at the page sees a number at all.
				<p class="y-results__count">{ resultCount(len(v.Results), v.Total, lang) }</p>
				// The hits are one set, so they are marked as one: a listener is
				// told where it starts, how many it holds, and where it ends. The
				// role is written out because the style reset takes the markers
				// off, and a list without markers loses its meaning outright in
				// WebKit.
				<ol class="y-results" role="list">
					for _, r := range v.Results {
						<li>
							<a class="y-result" href={ templ.URL(notesHref(r.RelPath) + hitFragment(&r)) }>
								<span class="y-result__title" { authoredLanguageAttrs(r.Language)... }>{ r.Title }</span>
								<span class="y-result__meta">
									if len(r.PathRuns) > 0 {
										@hitRuns(r.PathRuns)
									} else {
										{ r.RelPath }
									}
									if r.Status != "" {
										<span class="y-result__sep" aria-hidden="true">·</span>
										{ r.Status }
										if r.StatusOutsideEnum {
											@statusOutsideEnumMark(lang)
										}
									}
									if r.File {
										<span class="y-result__sep" aria-hidden="true">·</span>
										<span class="y-result__kind">{ wording.ResultKindFile.In(lang) }</span>
									}
									if r.FromFence {
										<span class="y-result__sep" aria-hidden="true">·</span>
										<span class="y-result__source">{ wording.ResultSourceLabel.In(lang) }</span>
									}
									if len(r.TopicRuns) > 0 {
										<span class="y-result__sep" aria-hidden="true">·</span>
										<span class="y-result__topic">
											{ wording.ResultTopicLabel.In(lang) }
											@hitRuns(r.TopicRuns)
										</span>
									}
									if len(r.AliasRuns) > 0 {
										<span class="y-result__sep" aria-hidden="true">·</span>
										<span class="y-result__alias">
											{ wording.ResultAliasLabel.In(lang) }
											@hitRuns(r.AliasRuns)
										</span>
									}
								</span>
								if note := unlocatedNote(&r, lang); note != "" {
									<span class="y-result__snippet">{ note }</span>
								} else if len(r.SnippetRuns) > 0 {
									<span class="y-result__snippet" { authoredLanguageAttrs(r.Language)... }>
										@hitRuns(r.SnippetRuns)
									</span>
								} else if r.Snippet != "" {
									<span class="y-result__snippet" { authoredLanguageAttrs(r.Language)... }>{ r.Snippet }</span>
								}
							</a>
						</li>
					}
				</ol>
			} else if v.Query != "" {
				<div class="y-searchpage__empty">
					<p>{ fmt.Sprintf(wording.NoResultsFmt.In(lang), v.Query) }</p>
					if len(v.StepBacks) > 0 {
						<p class="y-searchpage__hint">
							{ wording.StepBackLabel.In(lang) }
							for i, step := range v.StepBacks {
								if i > 0 {
									<span aria-hidden="true">・</span>
								}
								<a href={ templ.URL(searchHref(step.Query)) }>{ wording.StepBackOpen.In(lang) }{ step.Query }{ wording.StepBackClose.In(lang) }</a>
								{ fmt.Sprintf(wording.StepBackCountFmt.In(lang), step.Count) }
							}
						</p>
					}
					if v.Governed {
						<p class="y-searchpage__hint">{ wording.SearchScopeHintWithStatus.In(lang) }<code>status:draft</code>{ wording.SearchScopeHintAfterCommand.In(lang) }</p>
					} else {
						<p class="y-searchpage__hint">{ wording.SearchScopeHint.In(lang) }</p>
					}
				</div>
			} else {
				// Nothing has been asked yet, and a blank page is the one moment
				// with room to say which constraints this field understands
				// without standing between the reader and an answer.
				<div class="y-searchpage__empty" data-search-filters>
					<p class="y-searchpage__emptylede">{ wording.SearchEmptyLede.In(lang) }</p>
					<p class="y-searchpage__hint">
						{ wording.FilterKeysAvailable.In(lang) }
						for i, key := range v.FilterKeys {
							if i > 0 {
								{ wording.ListSeparator.In(lang) }
							}
							<code>{ key + ":" }</code>
						}
					</p>
				</div>
			}
		</div>
	</div>
}

// hitRuns writes one piece of a result — its path, an alias, or the body
// excerpt — with the stretches the query found marked and the rest plain. The
// three share this component because the whitespace templ keeps around a loop
// depends on what follows it, and the path's own copy was putting a space on
// either side of every mark: "Maps/ yomihon .md" is not the name of any file.
// Here the runs are the whole component, so nothing stands between them.
templ hitRuns(runs []SnippetRun) {
	for _, run := range runs {
		if run.Hit {
			<mark>{ run.Text }</mark>
		} else {
			{ run.Text }
		}
	}
}

// searchFacets is the column beside the results: what the answer is made of,
// each part of it a search. It is a fold in the markup and stays one at narrow
// widths, where a list of values standing above the results would push them off
// the first screen; the stylesheet holds it open where there is a column to put
// it in, and hides the control that would otherwise be the only way to close
// something that is not folded. Nothing here runs a script: every row is a link
// the server already knows the answer to.
//
// The navigation landmark inside carries the name, because at the width where
// the summary is hidden it is the only thing left to say what this region is.
templ searchFacets(facets []SearchFacet, lang wording.Lang) {
	<details class="y-facets" data-search-facets>
		<summary class="y-facets__summary">
			@chevron()
			{ wording.FacetsTitle.In(lang) }
		</summary>
		<nav class="y-facets__body" aria-label={ wording.FacetsTitle.In(lang) }>
			for _, facet := range facets {
				<section class="y-facetgroup" data-facet-key={ facet.Key }>
					<h2 class="y-facetgroup__head">{ facet.Heading }</h2>
					<ul class="y-facetlist" role="list">
						for _, row := range facet.Rows {
							<li>
								if row.Query != "" {
									<a
										class={ "y-facetrow", templ.KV("y-facetrow--active", row.Active) }
										href={ templ.URL(searchHref(row.Query)) }
										aria-label={ facetRowLabel(facet.Heading, row, lang) }
										data-facet-row
										data-facet-active?={ row.Active }
									>
										@facetRowBody(row, lang)
									</a>
								} else {
									<span class="y-facetrow y-facetrow--quiet" data-facet-row>
										@facetRowBody(row, lang)
									</span>
								}
							</li>
						}
					</ul>
				</section>
			}
		</nav>
	</details>
}

// facetRowBody is what one row shows whether or not it is a link, so the two
// arms above cannot drift into showing different things.
templ facetRowBody(row SearchFacetRow, lang wording.Lang) {
	<span class="y-facetrow__label">{ row.Label }</span>
	if row.OutsideEnum {
		@statusOutsideEnumMark(lang)
	}
	<span class="y-facetrow__count" data-facet-count={ strconv.Itoa(row.Count) }>
		{ fmt.Sprintf(wording.FacetCountFmt.In(lang), row.Count) }
	</span>
}
