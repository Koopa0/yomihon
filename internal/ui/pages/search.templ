package pages

import (
	"fmt"
	"github.com/koopa0/yomihon/internal/wording"
	"strconv"
	"strings"
	"time"

	"github.com/koopa0/yomihon/internal/ui/layouts"
)

// SearchView is everything the search results page needs. Diagnostic names a
// metadata capability failure and is distinct from an ordinary empty result.
// Its fields are plain values, so the search handler maps its own results onto
// them and the import stays one-directional.
type SearchView struct {
	Query   string
	Results []SearchResult

	// Total is how many hits the query truly has. Results holds one page of
	// them, or — on a face with no strip under the rows — the bounded opening
	// stretch, and the count line says which of the two it is looking at.
	Total      int
	Diagnostic string

	// Sort is the two orders the answer can be read in, the one in use marked.
	// Each carries the address that reads the same answer in that order.
	Sort []SearchChoice

	// ByDate says the answer is read by last change, the order whose key a row
	// has to show: each item then ends its line with the day it changed, as of
	// Now.
	ByDate bool
	Now    time.Time

	// Kinds and Locations are the rows the answer can be narrowed along, each
	// counted over the answer as the other row leaves it. They are empty when
	// the answer is small enough to read through, which is the one case a
	// filter is not worth its row.
	Kinds     []SearchChoice
	Locations []SearchChoice

	// Shown is how many of the answer's notes the list holds, and More is the
	// address that reads twenty further. The address carries the count, so
	// coming back to the page finds the list as it was left.
	Shown int
	More  SearchMore

	// UnknownFilterKeys are the words this query wrote before a colon that the
	// grammar does not accept, and the whole of a term whose key it accepts and
	// whose value it does not. Their terms were searched for as text, and
	// without saying so the reader is left believing a constraint ran.
	UnknownFilterKeys []string
	// FilterKeys are the keys the grammar does accept, so the reader can see
	// what to write instead. They come from the parser rather than a list kept
	// here, which would drift.
	FilterKeys []string

	// StepBacks are the loosened searches offered when nothing matched, each
	// already run and known to find something, so the page never advises a
	// search it has made useless.
	StepBacks []SearchStepBack

	// Near is the word to offer in place of a query nothing matched.
	Near SearchNear

	// LiteralOperators names terms searched as words despite their operator
	// shape. FolderSuggestions repairs a basename to a counted full-path query.
	LiteralOperators  []string
	FolderSuggestions []SearchStepBack

	// Sidebar is the resolved left navigation, built where every other page
	// builds it, so arriving at a search never strands the reader in a
	// chromeless view.
	Sidebar Sidebar
}

// SearchResult is one rendered hit: the entry's path (linked), display title,
// whether it is a draft, and a context snippet.
type SearchResult struct {
	RelPath string
	Title   string
	// Language is the note's own declared BCP 47 tag when the contract gave
	// the field authority and the frontmatter carried a valid value. Empty
	// otherwise, so a listing inherits the page language rather than guessing.
	Language string
	// Draft is whether the note declares itself unfinished.
	Draft bool

	// TitleRuns is the title cut into what the query found and what it did
	// not, so the words the reader typed are marked in it too.
	TitleRuns []SnippetRun

	// Lead is the passage shown under the title, opening at the sentence that
	// holds the first hit. LeadNear is the same passage cut for a single line
	// and is empty where it would read the same. LeadCode says the passage is
	// a line of code, set in the monospace face. Every run is rendered as text.
	Lead     []SnippetRun
	LeadNear []SnippetRun
	LeadCode bool

	// Kind is the word for what the note is, empty for an ordinary note.
	// WhereRuns is the last two levels of the folder it lives in, or the word
	// for the vault's top. It carries a hit only when nothing else on the row
	// does: the title and the excerpt are where a hit is marked.
	Kind      string
	WhereRuns []SnippetRun

	// Changed is when the note last changed, shown only to a reader of the
	// answer by date.
	Changed time.Time

	// AliasRuns is the name that answered the query where it was not the title,
	// cut the same way. The row shows a title, so a reader who searched one of a
	// note's other names would otherwise see nothing of what they typed.
	AliasRuns []SnippetRun

	// TagRuns names the frontmatter tag that answered a tag-only query.
	TagRuns []SnippetRun

	// Landing is the first-block stretch a browser text directive can find
	// for a body hit. Empty when the row has no body match, or when a
	// crossing match has nothing locatable in its first block.
	Landing string

	// LandingBare is the stretch to name where no words go ahead of it in the
	// directive: Landing grown out to the edges of the words it lies inside,
	// because a browser looks for a run introduced by nothing only where a
	// word begins and where one ends. It equals Landing for most matches, and
	// a row that carries a landing carries this too — a row filled in without
	// it offers the reader no directive at all.
	LandingBare string

	// LandingEnd is the last-block stretch of a crossing match, so the
	// directive can name a range instead of the first copy of a word. It
	// arrives grown to the edges of the words it lies inside, because a
	// browser holds it to both of them in either place it can take — closing
	// a range, or travelling alone where the first block held nothing
	// locatable — and spends the whole directive when it cannot find it.
	LandingEnd string

	// LandingPrefix is the run of words the match follows inside the block
	// its first stretch opens, so the directive can say which copy of that
	// stretch it means. A browser walks the whole page in order, and the
	// rail is drawn before the article. Empty where the match opens its
	// block.
	LandingPrefix string

	// LandingSuffix is the run of characters after the last term the
	// directive names, up to the nearest boundary every segmenter agrees on,
	// so the match may end anywhere: a browser holds a term with nothing
	// behind it to end where a word does. For a crossing match it follows
	// the far end. Empty where the term already ends at such a boundary.
	LandingSuffix string

	// BlockCrossing reports that the match continues into a later block, so
	// a directive built from the whole phrase would find nothing.
	BlockCrossing bool

	// FromFence marks a hit whose deciding excerpt is a fenced block. The
	// row names that, the way it names an alias or a topic, so the
	// excerpt can stay the fence's own lines.
	FromFence bool
}

// SnippetRun is one stretch of a result's snippet, marked or not.
type SnippetRun struct {
	Text string
	Hit  bool
	// Deleted preserves the author's retraction independently of a query hit.
	Deleted bool
}

// SearchStepBack is one loosened search the empty page offers: a query the
// index has already answered, with how many notes it found.
type SearchStepBack struct {
	Query string
	Count int
}

// SearchChoice is one way to read the answer: an order, a kind, a place. It
// carries the address that reads the same answer that way, and whether the
// answer is being read that way now. Count is how many notes the choice holds,
// or negative where it does not say.
type SearchChoice struct {
	Label  string
	Count  int
	Href   string
	Active bool
}

// SearchMore is the way on from the notes the list holds: how many it brings
// and where it is read from. The zero value is the end of the answer.
type SearchMore struct {
	Count int
	Href  string
}

// SearchPanelView is what opens under a field or fills the phone's surface: a
// few notes, the folders whose names match, and the way to the rest. Query is
// empty for a field that was only focused, which has nothing to answer.
type SearchPanelView struct {
	Query   string
	Notes   []SearchPanelNote
	Folders []SearchPanelFolder
	// Total is how many notes the query has in all, and AllHref reads them.
	Total   int
	AllHref string
	Near    SearchNear
	// Diagnostic is the sentence standing in for an answer the index could not
	// give; the panel shows no rows then.
	Diagnostic bool
}

// SearchPanelNote is one row of the panel: the title cut near the hit, and the
// folder it is in, last level only.
type SearchPanelNote struct {
	TitleRuns []SnippetRun
	Folder    string
	Href      string
	Language  string
}

// SearchPanelFolder is a folder whose name the query matches: its name cut
// where it matched, the folder above it, and how many notes it holds.
type SearchPanelFolder struct {
	NameRuns []SnippetRun
	Parent   string
	Count    int
	Href     string
}

// SearchNear is the closest word the vault's titles hold to a query nothing
// matched, and the search for it. Empty when nothing is near.
type SearchNear struct {
	Word string
	Href string
}

// Search is the results page: a GET form and a flat list of hits in the shared
// shell, mounted with no current note so every branch renders closed. The form
// is the no-JavaScript path; the live-search data hooks let the shared script
// refresh only the result region while typing.
templ Search(v SearchView, c layouts.Chrome) {
	@layouts.Base(c) {
		<div class="y-nav-scrim" data-nav-close></div>
		<div class="y-shell2">
			@sidebar(v.Sidebar, c)
			<main id="_y-main" tabindex="-1" class="y-main">
				// data-live-search-sync-url marks the one live region whose
				// results the address bar describes. This page is the form's
				// own target, so after a live refresh the URL is rewritten to
				// what submitting would produce and a copied address reproduces
				// the results. The command-palette dialog floats over pages it
				// does not own and never carries the marker.
				// The endpoint carries the one difference between this page and
				// the command palette, which asks the same route for the same
				// rows: only a page with a column beside the results asks for
				// the divisions that go in it. The script builds its request
				// from this attribute and sets the query on top, so the marker
				// rides along without the script knowing it is there.
				<div class="y-searchpage" data-live-search data-live-search-endpoint="/search/results" data-live-search-sync-url>
					// The field is not focused on arrival. Inside the palette that
					// is the whole point — it opens on a keystroke and the reader
					// is already typing — but this page is reached deliberately,
					// and a reader who follows a result and comes back would land
					// in the text box rather than near the result they left, with
					// the skip link already behind them.
					// The field is the phone's: a wider window asks through the header.
					<search>
						<form class="y-searchpage__form" method="get" action="/search" data-live-search-form>
							<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
							<input type="search" name="q" value={ v.Query } placeholder={ wording.SearchNotesPrompt.In(c.Lang) } aria-label={ wording.SearchNotes.In(c.Lang) } enterkeyhint="search" autocomplete="off" spellcheck="false" data-live-search-input/>
							<button type="button" class="y-searchpage__clear" aria-label={ wording.SearchClearField.In(c.Lang) } data-live-search-clear hidden?={ v.Query == "" }>
								@layouts.Icon("close")
							</button>
						</form>
					</search>
					@layouts.LiveSearchStatus(c.Lang)
					@SearchResults(v, c.Lang)
				</div>
			</main>
		</div>
	}
}

// SearchResults is the server-rendered results fragment shared by the full page
// and the live refreshes. The outer data marker carries the true match tally,
// which the live-search status line announces, while the list below holds the
// notes read so far.
templ SearchResults(v SearchView, lang wording.Lang) {
	<div class="y-searchresults" data-live-search-results data-result-count={ strconv.Itoa(v.Total) } aria-busy="false">
		// The page is named by what it answers: the query in brackets on a
		// screen wide enough for a title, and on a phone by the field, which is
		// the first thing there. A page with nothing asked is the search page.
		<h1 class="y-title y-searchpage__title">
			if v.Query != "" {
				{ wording.SearchQueryOpen.In(lang) }{ v.Query }{ wording.SearchQueryClose.In(lang) }
			} else {
				{ wording.SearchTitle.In(lang) }
			}
		</h1>
		<div>
			if v.Query != "" {
				// Which query these rows answer, carried with them and hidden. The
				// live search shows it when a refresh fails and leaves them standing.
				<p class="y-live-search__status" data-live-search-stale={ v.Query } hidden>{ fmt.Sprintf(wording.LiveSearchStaleFmt.In(lang), v.Query) }</p>
			}
			if len(v.UnknownFilterKeys) > 0 {
				// Said whatever the outcome: this is about how the query was read,
				// not how many notes answered it, so a query that also found
				// something still hears it.
				<p class="y-searchpage__hint" data-unknown-filter>
					{ fmt.Sprintf(wording.UnknownFilterFmt.In(lang), strings.Join(v.UnknownFilterKeys, wording.ListSeparator.In(lang))) }
					for i, key := range v.FilterKeys {
						if i > 0 {
							{ wording.ListSeparator.In(lang) }
						}
						<code>{ key + ":" }</code>
					}
					{ wording.UnknownFilterEnd.In(lang) }
				</p>
			}
			if v.Diagnostic != "" {
				<div class="y-searchpage__empty" data-search-diagnostic>
					<p>{ wording.MetadataSearchUnavailable.In(lang) }</p>
					<p class="y-searchpage__hint">
						@browserDiagnostic(wording.GovernanceUnavailable.In(lang), v.Diagnostic)
					</p>
				</div>
			} else if len(v.Results) > 0 {
				<div class="y-countline y-countline--search">
					<p class="y-results__count">{ searchCount(&v, lang) }</p>
					<span class="y-seg" role="group" aria-label={ wording.SearchSortLabel.In(lang) }>
						for _, c := range v.Sort {
							<a href={ templ.URL(c.Href) } data-search-choice aria-pressed={ strconv.FormatBool(c.Active) }>{ c.Label }</a>
						}
					</span>
				</div>
				if len(v.Kinds) > 0 || len(v.Locations) > 0 {
					<div class="y-searchfilters">
						if len(v.Kinds) > 0 {
							@searchChoiceRow(wording.SearchKindLabel.In(lang), v.Kinds, false)
						}
						if len(v.Locations) > 0 {
							@searchChoiceRow(wording.SearchLocationLabel.In(lang), v.Locations, true)
						}
					</div>
				}
				// The hits are one set, so they are marked as one: a listener is
				// told where it starts, how many it holds, and where it ends. The
				// role is written out because the style reset takes the markers
				// off, and a list without markers loses its meaning outright in
				// WebKit.
				<ol class="y-found" role="list">
					for _, r := range v.Results {
						<li>
							<a class="y-found__item" href={ templ.URL(notesHref(r.RelPath) + hitFragment(&r)) }>
								<span class="y-found__title" { authoredLanguageAttrs(r.Language)... }>
									if len(r.TitleRuns) > 0 {
										@hitRuns(r.TitleRuns)
									} else {
										{ r.Title }
									}
								</span>
								if note := unlocatedNote(&r, lang); note != "" {
									<span class="y-found__lead">{ note }</span>
								} else if len(r.Lead) > 0 {
									// One passage serves every width unless the hit sits too
									// far into the sentence for a one-line lead to show it; then
									// the narrow cut is written beside it and the stylesheet
									// shows the one the width has room for.
									<span class={ "y-found__lead", templ.KV("y-found__lead--code", r.LeadCode) } { authoredLanguageAttrs(r.Language)... }>
										if len(r.LeadNear) > 0 {
											<span class="y-found__wide">@hitRuns(r.Lead)</span>
											<span class="y-found__narrow">@hitRuns(r.LeadNear)</span>
										} else {
											@hitRuns(r.Lead)
										}
									</span>
								}
								<span class="y-found__where">
									@foundWhere(&r, v.ByDate, v.Now, lang)
								</span>
							</a>
						</li>
					}
				</ol>
				if v.More.Count > 0 {
					<div class="y-more">
						<a class="y-more__button" href={ templ.URL(v.More.Href) } data-search-choice>{ fmt.Sprintf(wording.SearchShowMoreFmt.In(lang), v.More.Count) }</a>
						<span class="y-more__tally">{ fmt.Sprintf(wording.SearchShownOfFmt.In(lang), Thousands(v.Shown), Thousands(v.Total)) }</span>
					</div>
				}
			} else if v.Query != "" {
				// The page title is the query, the line under it says nothing
				// matched it, and what is left is the nearest way out. Nothing here
				// explains how the index works.
				<p class="y-results__count y-searchnone__lead">{ fmt.Sprintf(wording.SearchNoneFmt.In(lang), v.Query) }</p>
				<div class="y-searchnone" data-search-none>
					if v.Near.Word != "" {
						<p class="y-searchnone__near">
							{ strings.SplitN(wording.SearchDidYouMeanFmt.In(lang), "%s", 2)[0] }<a href={ templ.URL(v.Near.Href) }>{ v.Near.Word }</a>{ strings.SplitN(wording.SearchDidYouMeanFmt.In(lang), "%s", 2)[1] }
						</p>
					}
					if len(v.LiteralOperators) > 0 {
						<p class="y-searchnone__hint" data-literal-operator>{ wording.LiteralOperatorSentence(lang, v.LiteralOperators) }</p>
					}
					if len(v.FolderSuggestions) > 0 {
						<p class="y-searchnone__hint" data-folder-suggestion>
							{ wording.FolderSuggestionsLabel.In(lang) }
							for i, step := range v.FolderSuggestions {
								if i > 0 {
									<span aria-hidden="true">・</span>
								}
								<a href={ templ.URL(searchHref(step.Query)) }>{ wording.StepBackOpen.In(lang) }{ step.Query }{ wording.StepBackClose.In(lang) }</a>
								{ fmt.Sprintf(wording.StepBackCountFmt.In(lang), step.Count) }
							}
						</p>
					}
					if len(v.StepBacks) > 0 {
						<p class="y-searchnone__hint">
							{ wording.StepBackLabel.In(lang) }
							for i, step := range v.StepBacks {
								if i > 0 {
									<span aria-hidden="true">・</span>
								}
								<a href={ templ.URL(searchHref(step.Query)) }>{ wording.StepBackOpen.In(lang) }{ step.Query }{ wording.StepBackClose.In(lang) }</a>
								{ fmt.Sprintf(wording.StepBackCountFmt.In(lang), step.Count) }
							}
						</p>
					}
					<p class="y-searchnone__way"><a href="/folders">{ wording.SearchBrowseFolders.In(lang) }</a></p>
				</div>
			} else {
				// Nothing has been asked yet. The reader's recent searches, kept in
				// this browser, are written here by the script; with none, the page
				// is the field and nothing else.
				@recentSearches(lang)
			}
		</div>
	</div>
}

// searchChoiceRow is one row of ways to narrow the answer. Each choice is a
// link, so the row works as plain navigation. Where the row is a place it is a
// native select at phone width, where a row of folder names would wrap to many
// lines; the stylesheet shows the one the width has room for.
templ searchChoiceRow(label string, choices []SearchChoice, asSelect bool) {
	<div class="y-searchfilter">
		<span class="y-searchfilter__label">{ label }</span>
		<span class={ "y-seg", templ.KV("y-seg--wide", asSelect) } role="group" aria-label={ label }>
			for _, c := range choices {
				<a href={ templ.URL(c.Href) } data-search-choice aria-pressed={ strconv.FormatBool(c.Active) }>
					{ c.Label }
					if c.Count >= 0 {
						<span class="y-seg__count">{ Thousands(c.Count) }</span>
					}
				</a>
			}
		</span>
		if asSelect {
			<select class="y-searchfilter__select" aria-label={ label } data-search-select>
				for _, c := range choices {
					<option value={ c.Href } selected?={ c.Active }>
						{ c.Label }
						if c.Count >= 0 {
							{ " " + Thousands(c.Count) }
						}
					</option>
				}
			</select>
		}
	</div>
}

// foundWhere is the line under an item that says what kind of note it is and
// where it lives, with whatever else made it an answer — the alias or tag the
// query reached it by — and, for an answer read by date, the day it changed,
// set after, in the same quiet type.
templ foundWhere(r *SearchResult, byDate bool, now time.Time, lang wording.Lang) {
	if r.Kind != "" {
		<span class="y-result__kind">{ r.Kind }</span>
		<span class="y-result__sep" aria-hidden="true">·</span>
	}
	<span>@hitRuns(r.WhereRuns)</span>
	if r.Draft {
		<span class="ui-status">{ wording.Draft.In(lang) }</span>
	}
	if len(r.TagRuns) > 0 {
		<span class="y-result__sep" aria-hidden="true">·</span>
		<span class="y-result__tag">
			{ wording.ResultTagLabel.In(lang) }
			@hitRuns(r.TagRuns)
		</span>
	}
	if len(r.AliasRuns) > 0 {
		<span class="y-result__sep" aria-hidden="true">·</span>
		<span class="y-result__alias">
			{ wording.ResultAliasLabel.In(lang) }
			@hitRuns(r.AliasRuns)
		</span>
	}
	if byDate && !r.Changed.IsZero() {
		<span class="y-result__sep" aria-hidden="true">·</span>
		<span class="y-found__date">{ listDate(r.Changed, now) }</span>
	}
}

// hitRuns writes one piece of a result — its path, an alias, or the body
// excerpt — with the stretches the query found marked and the rest plain. The
// three share this component because the whitespace templ keeps around a loop
// depends on what follows it, and the path's own copy was putting a space on
// either side of every mark: "Maps/ yomihon .md" is not the name of any file.
// Here the runs are the whole component, so nothing stands between them.
templ hitRuns(runs []SnippetRun) {
	for _, run := range runs {
		if run.Deleted {
			<del>
				if run.Hit {
					<mark>{ run.Text }</mark>
				} else {
					{ run.Text }
				}
			</del>
		} else if run.Hit {
			<mark>{ run.Text }</mark>
		} else {
			{ run.Text }
		}
	}
}

// SearchPanel is the fragment under a field and on the phone's surface. The
// first row is the one Enter opens; on the phone's surface the stylesheet takes
// that mark off, since a touch has no current row.
templ SearchPanel(v SearchPanelView, lang wording.Lang) {
	<div class="y-sp" data-live-search-results data-result-count={ strconv.Itoa(v.Total) } aria-busy="false">
		if v.Query == "" {
			@recentSearches(lang)
		} else if v.Diagnostic {
			<p class="y-sp__status" data-search-diagnostic>{ wording.MetadataSearchUnavailable.In(lang) }</p>
		} else if v.Total == 0 && len(v.Folders) == 0 {
			<p class="y-sp__status" data-search-none>{ fmt.Sprintf(wording.SearchNoneFmt.In(lang), v.Query) }</p>
			if v.Near.Word != "" {
				<a class="y-sp__row" href={ templ.URL(v.Near.Href) } data-live-search-row aria-current="true">
					<span class="y-sp__title">{ fmt.Sprintf(wording.SearchSearchFor.In(lang), v.Near.Word) }</span>
				</a>
			}
		} else {
			<div role="listbox" aria-label={ wording.SearchNotes.In(lang) }>
				for _, n := range v.Notes {
					<a class="y-sp__row" role="option" href={ templ.URL(n.Href) } data-live-search-row>
						<span class="y-sp__title" { authoredLanguageAttrs(n.Language)... }>@hitRuns(n.TitleRuns)</span>
						if n.Folder != "" {
							<span class="y-sp__where">{ n.Folder }</span>
						}
					</a>
				}
				for _, f := range v.Folders {
					<a class="y-sp__row y-sp__row--folder" role="option" href={ templ.URL(f.Href) } data-live-search-row>
						<span class="y-sp__icon">@layouts.Icon("folder")</span>
						<span class="y-sp__title">@hitRuns(f.NameRuns)</span>
						<span class="y-sp__where">
							if f.Parent != "" {
								{ f.Parent } ·{ " " }
							}
							{ noteCountFact(f.Count, lang) }
						</span>
					</a>
				}
			</div>
			<a class="y-sp__all" href={ templ.URL(v.AllHref) } data-live-search-row>{ fmt.Sprintf(wording.SearchSeeAllFmt.In(lang), Thousands(v.Total)) }</a>
		}
	</div>
}

// recentSearches is the reader's recent searches, kept in this browser. The
// script writes the rows and shows the section; with none to show the section
// stays hidden and the surface holds only the field.
templ recentSearches(lang wording.Lang) {
	<section class="y-recent" data-recent-searches hidden>
		<div class="y-lgroup__head">
			<h2 class="y-lgroup__name">{ wording.SearchRecent.In(lang) }</h2>
			<button type="button" class="y-lgroup__action" data-recent-clear>{ wording.SearchClear.In(lang) }</button>
		</div>
		<ul class="y-recent__list" role="list" data-recent-list></ul>
	</section>
}
