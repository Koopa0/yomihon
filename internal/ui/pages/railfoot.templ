package pages

import (
	"strconv"

	"github.com/koopa0/yomihon/internal/nav"
	"github.com/koopa0/yomihon/internal/wording"
)

// railFoot is where a left rail ends: which folder the reader is in, how large
// it is, and whether the judging face has anything to say about it. All three
// are three pages away otherwise, and the rail is the one surface every reading
// page carries.
//
// It is one component drawn by all three rails, and at narrow widths the same
// element becomes the drawer, so the foot of the drawer is this foot and cannot
// drift from it. The three rails are otherwise unlike each other — a whole-vault
// tree, one book, a course's parts — so a second copy of these three lines is
// how two of them would come to disagree about the same folder.
//
// The number is the health page's own, counted where that page counts its rows,
// and the dot only colours what the words beside it already say.
templ railFoot(v nav.Vault, lang wording.Lang) {
	<div class="y-railsep" aria-hidden="true"></div>
	<div class="y-railfoot" data-rail-foot data-health={ libraryHealthState(v.Findings) }>
		<p class="y-railfoot__name">{ libraryName(v.Name, lang) }</p>
		<p class="y-railfoot__size">{ plural(v.Notes, wording.NoteCountOne, wording.NoteCountMany, lang) }</p>
		<a class="y-railfoot__health" href="/health" data-rail-foot-findings={ strconv.Itoa(v.Findings) }>
			<span class="y-railfoot__dot" aria-hidden="true"></span>
			<span class="y-railfoot__label">{ wording.HealthTitle.In(lang) }</span>
			<span class="y-railfoot__count">{ libraryFindings(v.Findings, lang) }</span>
		</a>
	</div>
}
