package pages

import (
	"github.com/koopa0/yomihon/internal/wording"
	"strconv"

	"github.com/koopa0/yomihon/internal/nav"
	"github.com/koopa0/yomihon/internal/sequence"
	"github.com/koopa0/yomihon/internal/ui/layouts"
)

// Syllabus is the study-path page: the whole tree of one study-path rendered on
// a single fully-expanded page (no per-part page, no disclosure), with a left
// rail that switches paths and jumps to parts. It is the editorial full-page
// projection of the same nav.Map data the shared sidebar uses. All styling is
// shipped y-* / ui-* classes; no inline style.
templ Syllabus(v PathView, c layouts.Chrome) {
	@layouts.Base(c) {
		<div class="y-nav-scrim" data-nav-close></div>
		<div class="y-shell2">
			@syllabusRail(v, c)
			<main id="_y-main" tabindex="-1" class="y-main">
				<div class="y-syl">
					@syllabusHead(v, c.Lang)
					if len(v.Branches) == 0 {
						@syllabusNoCourse(v.NoCourse, c.Lang)
					}
					for _, sec := range v.Branches {
						@partBlock(sec, c.Lang)
					}
					for _, sec := range v.Appendix {
						@appendixBlock(sec, c.Lang)
					}
					@syllabusFoot(v, c.Lang)
				</div>
			</main>
		</div>
	}
}

// syllabusHead is the cover: the path kicker, the title, the note's own
// preface, the derived metarow (how large the course is, how much of it hangs
// in side branches, how many of its entries are not yet settled), and the one
// verb that opens the course with, where something is marked, the way to hear
// it. No path dek (subtitle) is rendered: there is no backing field for it, and
// no data means no render — the same treatment the reading page gives a note's
// subtitle.
templ syllabusHead(v PathView, lang wording.Lang) {
	<div class="y-syl-kicker">{ wording.SyllabusKicker.In(lang) }</div>
	<h1 class="y-title">{ v.Title }</h1>
	// The author's own words about the course: what a note that opens on its
	// title keeps under it, or what stands above the first heading of one that
	// does not. They are printed unchanged. A note with neither has none, and
	// nothing is drawn: the reader meets the counts one line sooner rather than
	// an empty box.
	if v.OpeningHTML != "" {
		@layouts.CodeCopy(lang)
		<div class="y-cover__opening y-prose" { authoredLanguageAttrs(v.OpeningLanguage)... }>
			@templ.Raw(v.OpeningHTML)
		</div>
	}
	<div class="y-metarow">
		for i, figure := range v.Extent(lang) {
			if i > 0 {
				<span aria-hidden="true">·</span>
			}
			<span>{ figure }</span>
		}
		// The exception and not the rule: a course whose entries are all settled
		// says nothing here, and so does one whose contract settles no status,
		// because the count would then be every entry.
		if note := v.UnsettledNote(lang); note != "" {
			<span aria-hidden="true">·</span>
			<span class="y-syl-unsettled" data-course-unsettled>{ note }</span>
		}
	</div>
	// The ways in belong to a path that has something to walk. The condition is
	// the one the body already asks before it explains itself, so the two halves
	// of the page cannot give different answers about whether this path has a
	// course.
	if len(v.Branches) > 0 && (v.Action.Href != "" || v.ListenHref != "") {
		<div class="y-cover__ways">
			// One verb, and it is the course's: open the first entry, or go
			// back to the place the reader kept inside it. The token beside it
			// says which without asking what language the page is in.
			if v.Action.Href != "" {
				<a
					class="y-cover__open"
					data-course-action={ v.Action.Token() }
					href={ templ.URL(v.Action.Href) }
				>
					<span class="y-cover__verb">{ v.Action.Verb(lang) }</span>
					if v.Action.Lesson != "" {
						<span class="y-cover__lesson" { authoredLanguageAttrs(v.Action.LessonLanguage)... }>{ v.Action.Lesson }</span>
					}
				</a>
			}
			// The same path as something to be listened to. It is offered only
			// where a note in it is marked to be read aloud, so it never leads
			// to a page that says there is nothing to hear.
			if v.ListenHref != "" {
				<a class="y-syl-read" href={ templ.URL(v.ListenHref) }>{ wording.ListenThisPath.In(lang) }<span aria-hidden="true">→</span></a>
			}
		</div>
	}
}

// syllabusFoot is the last line of the contents: the way to the note the path
// is drawn from, as a book ends its table of contents on where the rest is. It
// belongs to a path that has a course for the same reason the ways in do.
templ syllabusFoot(v PathView, lang wording.Lang) {
	if len(v.Branches) > 0 {
		<p class="y-cover__note">
			<a class="y-syl-read" href={ templ.URL(v.GuideHref) }>{ wording.ReadTheGuide.In(lang) }<span aria-hidden="true">→</span></a>
		</p>
	}
}

// ============================ MAIN — the path ============================

// partBlock renders one top-level branch (a part): an anchored editorial
// heading, then its entries and modules fully expanded inline. There is no
// per-part page (yomihon has no reading-progress model), so every part —
// completed or not — expands the same.
templ partBlock(sec PathBranchView, lang wording.Lang) {
	<section class="y-part-block">
		<h2 class="y-part" id={ sec.Anchor }>
			<span class="y-part__num">{ sec.PartLabel(lang) }</span>
			<span class="y-part__name">{ sec.Heading }</span>
		</h2>
		@branchItems(sec, lang)
	</section>
}

// appendixBlock is what the author kept out of the course and listed beneath
// it, under their own heading: an unnumbered list of titles with the sentences
// they wrote beside them. It has no count, no line through its rows and no step
// to or from them, because none of it is a stop on the walk — only a place to
// look something up, which a book's contents lists after its chapters.
templ appendixBlock(sec PathBranchView, lang wording.Lang) {
	<section class="y-part-block y-appendix">
		<h2 class="y-part">
			<span class="y-part__name">{ sec.Heading }</span>
		</h2>
		<ul class="y-reflist">
			for _, item := range sec.Items {
				if item.Entry != nil {
					<li>
						@refRow(*item.Entry, lang)
					</li>
				}
			}
		</ul>
	</section>
}

// refRow is one row of the appendix: a link to the note with the author's
// sentence run in after its title, or, for a row that reached no note, the same
// words with the reason it could not be opened. It carries the marks the course
// rows carry for which row the reader came from, and none for place or status:
// an entry outside the course has neither a position nor a settled state of
// its own to say here.
templ refRow(l PathEntryView, lang wording.Lang) {
	if l.Kind == nav.EntryResolved {
		<a class="y-ref" href={ templ.URL(l.Href) } { hereAttr(l.Here)... }>
			<span class="y-ref__title" { authoredLanguageAttrs(l.Language)... }>{ l.Name }</span>
			@glossRunIn(l)
		</a>
	} else {
		<span
			class="y-ref y-ref--broken"
			data-resolution={ entryResolutionCode(l.Kind) }
			title={ entryResolutionTitle(l.Kind, lang) }
		>
			<span class="y-ref__title" { authoredLanguageAttrs(l.Language)... }>{ l.Name }</span>
			@glossRunIn(l)
			<span class="y-navmark y-navmark--warn">{ entryResolutionLabel(l.Kind, lang) }</span>
		</span>
	}
}

// glossRunIn is the author's sentence about a row, set after its title as the
// same line of text and separated from it by a space, in the language the
// path's note was written in. It draws nothing for a row that wrote none.
templ glossRunIn(l PathEntryView) {
	if l.Gloss != "" {
		{ " " }<span class="y-gloss" { authoredLanguageAttrs(l.GlossLanguage)... }>{ l.Gloss }</span>
	}
}

// moduleBlock renders a nested branch (a module). It recurses for any deeper
// nesting the vault happens to have — the two real study paths are three levels
// deep (part → module → entry), and a deeper one keeps the module style rather
// than being flattened (nav's tree is rendered as-is, never forced to a shape).
templ moduleBlock(sec PathBranchView, lang wording.Lang) {
	<div class={ "y-module", templ.KV("y-module--local", sec.Local) }>
		@moduleHeading(sec, lang)
		@branchItems(sec, lang)
	</div>
}

// branchItems draws what a branch lists in the order the author wrote it. A
// side branch is drawn where it sits — under the lesson it hangs from — because
// the source order already says where it belongs; matching it back to a lesson
// by name would guess, and two lessons can share a name.
//
// A numbered run renders as a real ordered list, because that is what it is:
// the author declared the order, and look-alike sibling links would keep that
// fact from anyone reading the tree rather than the pixels. Each item carries
// its walk position as the HTML list-item value, so the main line counts on
// across the branches it spans while a side branch counts alone — an implied
// index would restart at every interruption and lie. Rows navigation never
// walks stay outside any list and carry no ordinal.
templ branchItems(sec PathBranchView, lang wording.Lang) {
	for _, run := range sec.Runs(lang) {
		if run.Fault != "" {
			<p class="y-syl-nocourse">{ run.Fault }</p>
		} else if run.Branch != nil {
			@moduleBlock(*run.Branch, lang)
		} else if run.Ordered {
			<ol class="y-lessons" aria-label={ run.Label }>
				for _, entry := range run.Entries {
					<li value={ strconv.Itoa(entry.Number) }>
						@entryRow(entry, lang)
						// A side branch is drawn inside the item of the row it
						// hangs from, which keeps the line the main line is read
						// along running past it to the row that follows.
						for _, branch := range entry.Branches {
							@moduleBlock(branch, lang)
						}
					</li>
				}
			</ol>
		} else {
			for _, entry := range run.Entries {
				@entryRow(entry, lang)
				for _, branch := range entry.Branches {
					@moduleBlock(branch, lang)
				}
			}
		}
	}
}

// moduleHeading preserves the outline represented by nav's recursive branch
// tree. HTML has only six heading levels, so unusually deep branches remain at
// h6 rather than falling out of the document outline entirely.
templ moduleHeading(sec PathBranchView, lang wording.Lang) {
	switch  {
		case sec.Depth <= 1:
			<h3 class="y-module__label">
				@moduleHeadingContent(sec, lang)
			</h3>
		case sec.Depth == 2:
			<h4 class="y-module__label">
				@moduleHeadingContent(sec, lang)
			</h4>
		case sec.Depth == 3:
			<h5 class="y-module__label">
				@moduleHeadingContent(sec, lang)
			</h5>
		default:
			<h6 class="y-module__label">
				@moduleHeadingContent(sec, lang)
			</h6>
	}
}

templ moduleHeadingContent(sec PathBranchView, lang wording.Lang) {
	if sec.Local {
		<span class="y-module__tag">{ wording.BranchTag.In(lang) }</span>
	}
	<span class="y-module__name">{ sec.Heading }</span>
	<span class="y-module__rule" aria-hidden="true"></span>
}

// entryRow links governed unique targets and leaves every warning reason visible
// and non-interactive in its original sequence position.
//
// The row the reader is standing on says so twice: to the eye as the heavier
// point on the line, and to a reader who is listening as the current location —
// the location and not the page, because the page is the whole course. The
// words beside the point are unchanged by it; where the reader stands is not a
// claim about what they have finished.
//
// The status at the row's far end is the exception: a lesson at a settled
// status prints none. The bookmark beside it is the reader's own, and marks the
// one lesson they left off in.
templ entryRow(l PathEntryView, lang wording.Lang) {
	if l.Kind == nav.EntryResolved {
		<a class={ "y-lesson", templ.KV("y-lesson--here", l.Here) } href={ templ.URL(l.Href) } { hereAttr(l.Here)... }>
			<span class="y-navdot" aria-hidden="true"></span>
			<span class="y-lesson__text">
				<span class="y-lesson__title" { authoredLanguageAttrs(l.Language)... }>{ l.Name }</span>
				@glossRunIn(l)
			</span>
			if l.Kept || l.labelled() {
				<span class="y-lesson__aside">
					if l.Kept {
						@keptPlace(lang)
					}
					if l.labelled() {
						<span class="ui-status">{ l.Status }</span>
					}
				</span>
			}
		</a>
	} else {
		<span
			class="y-lesson y-lesson--broken"
			data-resolution={ entryResolutionCode(l.Kind) }
			title={ entryResolutionTitle(l.Kind, lang) }
		>
			<span class="y-navmark y-navmark--warn" aria-hidden="true">!</span>
			<span class="y-lesson__text">
				<span class="y-lesson__title" { authoredLanguageAttrs(l.Language)... }>{ l.Name }</span>
				@glossRunIn(l)
			</span>
			<span class="y-navmark y-navmark--warn">{ entryResolutionLabel(l.Kind, lang) }</span>
		</span>
	}
}

// ============================ LEFT RAIL ============================

// syllabusRail is the left rail: the path switcher (every study-path, the
// current one active) over the "On this path" part jump-nav and the path-level
// progress bar.
templ syllabusRail(v PathView, c layouts.Chrome) {
	{{ lang := c.Lang }}
	<aside class="y-rail-left" id="_y-nav-rail" aria-label={ wording.StudyPathNav.In(lang) }>
		@railHead(c, false)
		<div class="y-railbody" id="_y-nav-rail-body">
			<div class="ui-side__label y-syl-raillabel">{ wording.StudyPaths.In(lang) }</div>
			for _, p := range v.Paths {
				@pathSwitch(p)
			}
			if len(v.Branches) > 0 {
				<div class="ui-side__label y-syl-raillabel y-syl-raillabel--gap">{ wording.ThisPath.In(lang) }</div>
				for _, sec := range v.Branches {
					<a class="ui-navitem y-pathitem" href={ templ.URL("#" + sec.Anchor) }>
						<span class="y-pathitem__num" aria-hidden="true">{ sec.Ordinal }</span>
						<span class="y-pathitem__name">{ sec.Heading }</span>
					</a>
				}
			}
			@railFoot(v.Vault, lang)
		</div>
	</aside>
	@settleRail(c)
}

// pathSwitch is one row of the path switcher: a link to another study-path, or
// the active (non-link) marker for the one shown.
templ pathSwitch(p PathLink) {
	if p.Active {
		<span class="ui-navitem is-active" aria-current="page">
			@pathIcon()
			<span class="y-pathitem__name">{ p.Title }</span>
			<span class="ui-navitem__count">{ strconv.Itoa(p.Entries) }</span>
		</span>
	} else {
		<a class="ui-navitem" href={ templ.URL(syllabusHref(p.RelPath)) }>
			@pathIcon()
			<span class="y-pathitem__name">{ p.Title }</span>
			<span class="ui-navitem__count">{ strconv.Itoa(p.Entries) }</span>
		</a>
	}
}

templ pathIcon() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 19V5a2 2 0 0 1 2-2h9l5 5v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"></path></svg>
}

// syllabusNoCourse is what the page says when it read the note and found no
// course in it. Without it the header's honest nought-parts-nought-lessons sat
// over an empty body, which reads as a course that exists and is empty — and
// the repair for that is nothing like the repair for the ordinary case, a note
// that lists its lessons in prose and never declares them.
//
// The empty states get three explanations, because no one sentence is true of
// all of them. A note that wrote no marker is taught the grammar: which markers
// declare structure, and that a heading without one is not read as a part. A
// note that wrote a marker the grammar could not use is told what a marker may
// say — telling that author no marker exists would be false. Both spell the
// three values the grammar accepts, from the grammar's own vocabulary, and both
// stop short of naming which heading a marker belongs on: that would be yomihon
// deciding what the author meant, and the file is the author's to edit.
//
// The third says only that the page has no explanation. It is reached when the
// grammar reports a rule this page has not been told about, and the honest
// answer there is neither of the other two: each of those is a claim about what
// the author wrote, and one of them would be wrong.
templ syllabusNoCourse(verdict markerVerdict, lang wording.Lang) {
	switch verdict {
		case markerWritten:
			<p class="y-syl-nocourse">{ wording.NoCourseMarkerFaultIntro.In(lang) }<code>{ sequence.RolePrimary.String() }</code>{ wording.ValueJoin.In(lang) }<code>{ sequence.RoleLocal.String() }</code>{ wording.ValueJoinLast.In(lang) }<code>{ sequence.RoleNone.String() }</code>{ wording.NoCourseMarkerFaultTail.In(lang) }</p>
		case markerUnknownRule:
			<p class="y-syl-nocourse">{ wording.NoCourseUnexplained.In(lang) }</p>
		default:
			<p class="y-syl-nocourse">{ wording.NoCourseIntro.In(lang) }<code>{ sequence.Marker(sequence.RolePrimary) }</code>{ wording.ValueJoin.In(lang) }<code>{ sequence.Marker(sequence.RoleLocal) }</code>{ wording.ValueJoinLast.In(lang) }<code>{ sequence.Marker(sequence.RoleNone) }</code>{ wording.NoCourseNoMarkerTail.In(lang) }</p>
	}
}
