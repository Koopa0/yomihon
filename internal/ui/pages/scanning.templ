package pages

import (
	"strconv"

	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// ScanningView is the vault while its first read is still running: which
// folder it is, and how many of its files have been read. Total is zero until
// the folder has been walked, and the page then says no count rather than a
// wrong one.
type ScanningView struct {
	VaultName string
	VaultPath string
	Done      int
	Total     int
}

// Scanning is what every address answers until the first read of the vault has
// finished, so a vault that is still being read is never taken for an empty
// one. It carries no sidebar, because there is nothing yet to put in one.
//
// The count and the meter are always drawn and hidden until there is a total,
// so the script that keeps them current has them to reveal. The script is on
// the page rather than among the client modules: it runs on this page only,
// and a module would join the import map every other page carries.
templ Scanning(v ScanningView, c layouts.Chrome) {
	@layouts.Base(c) {
		<div class="y-shell2">
			<main id="_y-main" tabindex="-1" class="y-main">
				<article class="y-recovery" lang={ c.Lang.Tag() } aria-labelledby="scanning-title" data-scanning>
					@nothingToShow(nothingNotice{Kind: "scanning", Mark: wording.ScanningKicker.In(c.Lang), Title: v.VaultName, TitleID: "scanning-title", Page: true}) {
						<p><code>{ v.VaultPath }</code></p>
						<p
							data-scanning-count
							if v.Total == 0 {
								hidden
							}
						>
							if v.Total > 0 {
								{ wording.ScanningProgress(c.Lang, v.Done, v.Total) }
							}
						</p>
						<progress
							class="y-scanning__meter"
							max={ strconv.Itoa(max(v.Total, 1)) }
							value={ strconv.Itoa(v.Done) }
							aria-label={ wording.ScanningKicker.In(c.Lang) }
							if v.Total == 0 {
								hidden
							}
						></progress>
					}
				</article>
			</main>
		</div>
		// Keeps the count current, and loads the page that was asked for once
		// the vault is ready. The route it asks exists only while the read
		// runs, so any answer that is not its own means the site has arrived.
		// The server writes the count in the reader's language, so there is no
		// wording here to translate.
		<script nonce={ c.Nonce }>
			{
				const page = document.querySelector("[data-scanning]");
				const count = page.querySelector("[data-scanning-count]");
				const meter = page.querySelector("progress");
				const show = (state) => {
					if (!(state.total > 0)) return;
					count.textContent = state.text;
					count.hidden = false;
					meter.max = state.total;
					meter.value = state.done;
					meter.hidden = false;
				};
				const poll = async () => {
					try {
						const reply = await fetch("/scan", { cache: "no-store", headers: { Accept: "application/json" } });
						if (!reply.ok || !(reply.headers.get("Content-Type") || "").startsWith("application/json")) {
							location.reload();
							return;
						}
						show(await reply.json());
						setTimeout(poll, 250);
					} catch {
						setTimeout(poll, 1000);
					}
				};
				setTimeout(poll, 250);
			}
		</script>
	}
}
