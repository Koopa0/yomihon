package pages

import (
	"github.com/koopa0/yomihon/internal/ui/layouts"
	"github.com/koopa0/yomihon/internal/wording"
)

// ReportView is the minimal shell a sandboxed report needs: what the report
// calls itself, the name of its file, and the shared navigation rail. The file
// name is also the key its /raw endpoint resolves against the allowlist, which
// is why it travels apart from the title. A report is not a note, so it has no
// contents, no status panel and no diagnostics.
type ReportView struct {
	// Name is the briefing's file name. It is the key the raw address carries
	// and the frame's secondary line, never its heading.
	Name string
	// Title is what the report calls itself, and is the page's heading.
	Title string
	// Label is the title with whatever tells it from another report sharing it
	// (see ReportLabel). It names the page in a tab and the frame to a screen
	// reader, where nothing beside it says which report this is.
	Label string
	// ReadingRail is the list of reports beside this briefing.
	ReadingRail ReadingRail
	// NeedsScript records that this document draws part of itself with a
	// script. Scripts never run here, and a chart-shaped hole with nothing
	// explaining it reads as a broken report rather than the boundary working.
	NeedsScript bool
	// Size and SourceLimit describe a refused briefing; a positive SourceLimit
	// replaces the frame with the refusal and an original-file download.
	Size        int64
	SourceLimit int64
	// RelPath names the original file for the streaming download route.
	RelPath string
}

// Report is the report shell page: the shared chrome, a title, and either a
// reading-limit refusal or one iframe. The iframe carries a bare sandbox, so authored
// scripts and automatic navigation stay disabled and the content lands in an
// opaque origin that cannot inherit yomihon's first-party authority. Its src is
// this report's verbatim /raw endpoint, so the source bytes stay unchanged.
templ Report(v ReportView, c layouts.Chrome) {
	@layouts.Base(c) {
		<div class="y-nav-scrim" data-nav-close></div>
		<div class="y-shell2">
			@readingRail(v.ReadingRail, c)
			<main id="_y-main" tabindex="-1" class="y-main y-reportmain">
				<div class="y-reporthead">
					<h1 class="y-reporttitle">{ v.Title }</h1>
					<p class="y-reportfile">{ v.Name }</p>
					if v.SourceLimit > 0 {
						<a class="y-reportraw" href={ templ.URL(rawHref(v.RelPath)) }>{ wording.DownloadFile.In(c.Lang) }</a>
					} else {
						<a class="y-reportraw" href={ templ.URL(reportRawHref(v.Name)) }>{ wording.OpenReportAsWritten.In(c.Lang) }</a>
					}
				</div>
				if v.NeedsScript {
					<p class="y-homeempty" data-report-inert>
						{ wording.ReportAsIs.In(c.Lang) }
					</p>
				}
				if v.SourceLimit > 0 {
					<p class="y-homeempty">{ ReportReadingLimitMessage(v.Size, v.SourceLimit, c.Lang) }</p>
				} else {
					<iframe
						class="y-reportframe"
						src={ templ.URL(reportRawHref(v.Name)) }
						sandbox=""
						title={ v.Label }
					></iframe>
				}
			</main>
		</div>
	}
}
