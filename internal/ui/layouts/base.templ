package layouts

import (
	"strconv"

	"github.com/koopa0/yomihon/internal/wording"
)

// Chrome is the per-request shell state rendered server-side: the page title
// and the persisted theme / furigana / text-size / single-key-shortcut signals
// stamped onto the root so the correct state paints on the first byte (no
// FOUC).
// The client runtime flips these attributes and their cookies; CSS reacts (see
// assets/css/*). The server-rendered page remains usable without enhancement.
type Chrome struct {
	Title string // page title (before " — yomihon")
	Nonce string // per-response nonce for application-owned scripts
	// Theme is the reader's stored choice: "light", "dark", or "" when they
	// never made one. A choice is stamped on the root so the first paint is
	// already right; no choice leaves the root unstamped and the stylesheet's
	// system-preference block decides.
	Theme string
	Ruby  string // "on" | "off"
	// TextSize scales the reading column: "m" (the default measure), "l", or
	// "xl". It tunes presentation only — the charter's bounded reading
	// preferences — and the chrome around the article keeps its own size.
	TextSize string
	// HasRuby says this page actually carries furigana. The control switches
	// them off; a folder with no Japanese in it has none to switch, and a
	// button for a capability the page does not have is the tool's provenance
	// showing through its chrome.
	HasRuby                   bool
	SingleKeyShortcutsEnabled bool // plain / and [ are enabled
	// Lang is the language the interface speaks for this request, and the
	// language the document declares. The article inside it may declare its
	// own; that answers what the note is written in, which is a different
	// question from what the interface is saying.
	Lang wording.Lang
	// ReturnTo is this request's own address — path and query — carried into
	// the language form so the redirect after the switch lands the reader back
	// on the page they were reading. The server validates it as a local path
	// before following it.
	ReturnTo string
}

func singleKeyShortcutsState(enabled bool) string {
	if enabled {
		return "on"
	}
	return "off"
}

// Base is the document every page is rendered inside: the themed html element
// carrying the reader's own presentation choices, the head, the shared header,
// the search dialog, and the script that enhances all of it. A page supplies
// its own body as children; nothing above that body varies by page, which is
// what lets the chrome hold still while a navigation transition runs.
templ Base(c Chrome) {
	<!DOCTYPE html>
	<html
		lang={ c.Lang.Tag() }
		if c.Theme != "" {
			data-theme={ c.Theme }
		}
		data-ruby={ c.Ruby }
		data-textsize={ c.TextSize }
		data-single-key-shortcuts={ singleKeyShortcutsState(c.SingleKeyShortcutsEnabled) }
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ c.Title } — yomihon</title>
			<link rel="icon" type="image/svg+xml" href="/static/yomihon-mark.svg"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/chroma.css"/>
		</head>
		<body>
			<a class="y-skiplink" href="#main-content">{ wording.SkipToContent.In(c.Lang) }</a>
			<div class="yomihon">
				@header(c)
				{ children... }
				@searchDialog(c.Lang)
			</div>
			<script nonce={ c.Nonce } type="module" src="/static/yomihon.js"></script>
		</body>
	</html>
}

// header is the shared top chrome: the wordmark, ⌘K search entry, the
// furigana / text-size / theme toggles, and the language form. The
// single-key-shortcut preference is not here — it lives in the keyboard help
// panel beside the keys it governs, where a sentence can name them. The
// toggles are plain <button>s whose glyph state is CSS-driven from the root
// data-* attributes (no JS needed just to show the right icon); preferences.js
// only flips the attribute + cookie on click. Language is the exception: its
// words are the server's, so its control is a plain form the server answers.
// The search entry is a real link to /search (the no-JS fallback) that
// search.js upgrades into opening the dialog.
templ header(c Chrome) {
	<header class="y-header">
		<button class="y-iconbtn y-hamburger" type="button" data-nav-toggle aria-label={ wording.ToggleNavigation.In(c.Lang) } aria-expanded="false" aria-controls="nav-rail">
			<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
		</button>
		<div class="y-brand">
			<a class="y-brand__name" href="/"><img class="y-brand__mark" src="/static/yomihon-mark.svg" width="24" height="24" alt="" aria-hidden="true"/><span>yomihon</span></a>
			<span class="y-brand__tag">{ wording.BrandTag.In(c.Lang) }</span>
		</div>
		<div class="y-header__spacer"></div>
		<a class="y-searchbtn" href="/search" data-search-open aria-label={ wording.SearchNotes.In(c.Lang) }>
			<svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
			<span class="y-searchbtn__label">{ wording.SearchNotesPrompt.In(c.Lang) }</span>
			<span class="ui-kbd">⌘K</span>
		</a>
		if c.HasRuby {
			<button class="y-iconbtn y-rubybtn" type="button" data-ruby-toggle aria-label={ wording.ToggleFurigana.In(c.Lang) } aria-pressed={ strconv.FormatBool(c.Ruby == "on") }>
				<span class="y-rubybtn__glyph" aria-hidden="true">{ wording.FuriganaMark.In(c.Lang) }</span>
				<span class="y-rubybtn__on">{ wording.On.In(c.Lang) }</span>
				<span class="y-rubybtn__off">{ wording.Off.In(c.Lang) }</span>
			</button>
		}
		<a class="y-healthlinkbtn" href="/health" title={ wording.HealthLinkTitle.In(c.Lang) }>{ wording.HealthLink.In(c.Lang) }</a>
		// The three size names ride on the control in the page's own language,
		// so the script that moves the size — on a press, or re-syncing after a
		// back/forward-cache restore — renames the control from the same
		// dictionary the server used rather than from a second copy of the
		// words.
		<button class="y-iconbtn y-textsizebtn" type="button" data-textsize-toggle aria-label={ textSizeLabel(c.TextSize, c.Lang) } title={ wording.TextSizeCycle.In(c.Lang) } data-label-m={ wording.TextSizeMedium.In(c.Lang) } data-label-l={ wording.TextSizeLarge.In(c.Lang) } data-label-xl={ wording.TextSizeExtraLarge.In(c.Lang) }>
			<span aria-hidden="true">{ wording.TextSizeMark.In(c.Lang) }</span>
		</button>
		<button class="y-iconbtn y-helpbtn" type="button" popovertarget="kbd-help" aria-label={ wording.KeyboardHelpControl.In(c.Lang) }>
			<span aria-hidden="true">?</span>
		</button>
		<div id="kbd-help" popover class="y-kbdhelp" aria-label={ wording.KeyboardHelp.In(c.Lang) }>
			<h2 class="y-kbdhelp__title">{ wording.KeyboardHelp.In(c.Lang) }</h2>
			<dl class="y-kbdhelp__list">
				<dt><span class="ui-kbd">⌘K</span> / <span class="ui-kbd">Ctrl K</span></dt>
				<dd>{ wording.ShortcutSearch.In(c.Lang) }</dd>
				<dt><span class="ui-kbd">Esc</span></dt>
				<dd>{ wording.ShortcutCloseSearchOrFilter.In(c.Lang) }</dd>
				<dt><span class="ui-kbd">/</span></dt>
				<dd>{ wording.ShortcutJumpToFilter.In(c.Lang) }</dd>
				<dt><span class="ui-kbd">[</span></dt>
				<dd>{ wording.ShortcutToggleSidebar.In(c.Lang) }</dd>
			</dl>
			// The preference belongs beside the keys it governs. In the header
			// it was a permanent two-character control that named neither the
			// keys it turns on nor what "on" applied to; here the reader is
			// already asking about the keys, so the sentence can say which ones
			// and the control can sit under that sentence in its current state.
			<div class="y-kbdpref">
				<label class="y-shortcutpref">
					<input class="y-shortcutpref__input" type="checkbox" data-single-key-shortcuts-toggle aria-describedby="kbd-pref-note" checked?={ c.SingleKeyShortcutsEnabled }/>
					<span class="y-shortcutpref__label">{ wording.SingleKeyShortcuts.In(c.Lang) }</span>
					<span class="y-shortcutpref__on" aria-hidden="true">{ wording.CurrentlyOn.In(c.Lang) }</span>
					<span class="y-shortcutpref__off" aria-hidden="true">{ wording.CurrentlyOff.In(c.Lang) }</span>
				</label>
				// The two keys that keep working either way are named as well,
				// because "off" reads as "no keyboard" unless the sentence says
				// otherwise.
				<p class="y-kbdpref__note" id="kbd-pref-note">{ wording.SingleKeyShortcutsNote.In(c.Lang) }</p>
			</div>
		</div>
		// The language switch is a plain form, not a scripted button: the words
		// on every page are the server's, so the choice is stored server-side
		// and the same page asked for again — a redirect back to the address the
		// form carries. It works with no script at all, which matters most for
		// this control: a reader who cannot read the interface must still be
		// able to leave it.
		<form class="y-langform" method="post" action="/lang">
			<input type="hidden" name="lang" value={ string(otherLanguage(c.Lang)) }/>
			<input type="hidden" name="next" value={ c.ReturnTo }/>
			<button class="y-iconbtn y-langbtn" type="submit" aria-label={ wording.LanguageToggle.In(c.Lang) } title={ wording.LanguageToggle.In(c.Lang) }>
				<span aria-hidden="true">{ languageMark(c.Lang) }</span>
			</button>
		</form>
		<button class="y-iconbtn y-themebtn" type="button" data-theme-toggle aria-label={ wording.ThemeToggle.In(c.Lang) } aria-pressed={ strconv.FormatBool(c.Theme == "dark") }>
			<svg class="y-ico-sun" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
			<svg class="y-ico-moon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
		</button>
		<span class="y-readline" aria-hidden="true"></span>
	</header>
}

// languageMark labels the language control with the language it switches to
// rather than the one in force. A control that names the current state reads as
// a status line, and a reader who cannot read the interface they are looking at
// needs to recognise the way out of it.
func languageMark(lang wording.Lang) string {
	if lang == wording.En {
		return "中"
	}
	return "EN"
}

// otherLanguage is the language the form asks for: the one the interface is
// not speaking. It is the same answer languageMark draws, held as a value the
// server can store rather than a glyph a reader can recognise.
func otherLanguage(lang wording.Lang) wording.Lang {
	if lang == wording.En {
		return wording.ZhHant
	}
	return wording.En
}

// searchDialog is the ⌘K command palette: a native <dialog> (top layer,
// backdrop, focus trap, Esc — all free) whose body is a GET form to /search.
// The data hooks add live lexical results while preserving that ordinary form;
// without JavaScript the header link still reaches the full search page.
templ searchDialog(lang wording.Lang) {
	<dialog class="y-searchdialog ui-dialog" data-search data-live-search data-live-search-endpoint="/search/results" closedby="any" aria-label={ wording.SearchNotes.In(lang) }>
		<form class="y-searchdialog__form" method="get" action="/search" data-live-search-form>
			<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
			<input class="y-searchdialog__input" type="search" name="q" placeholder={ wording.SearchLibraryPrompt.In(lang) } aria-label={ wording.SearchNotes.In(lang) } data-live-search-input autofocus/>
			<span class="ui-kbd">esc</span>
		</form>
		<p class="y-live-search__status" data-live-search-status role="status" aria-live="polite" aria-atomic="true"></p>
		<div class="y-searchresults" data-live-search-results data-result-count="0" aria-busy="false"></div>
		<div class="y-searchdialog__foot">
			<span>↵ { wording.SearchDialogEnter.In(lang) }</span>
			<span>esc { wording.SearchDialogEsc.In(lang) }</span>
		</div>
	</dialog>
}

// textSizeLabel is the text-size control's accessible name, which carries the
// size the reader is at rather than the action the press performs. Its two
// neighbours in the header are two-state and say where they stand through
// aria-pressed; this one cycles through three, which no boolean carries, so
// the name is where its state has to live. The script keeps it current on
// every press, and a reader arriving on a reload finds the same answer.
func textSizeLabel(size string, lang wording.Lang) string {
	switch size {
	case "l":
		return wording.TextSizeLarge.In(lang)
	case "xl":
		return wording.TextSizeExtraLarge.In(lang)
	default:
		return wording.TextSizeMedium.In(lang)
	}
}
