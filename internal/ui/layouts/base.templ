// Package layouts holds the outer HTML shells. Visual identity lands later
// as Tailwind v4 @theme tokens (Claude design); M0 ships a minimal inline
// style so the walking skeleton is readable.
package layouts

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="zh-Hant">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — 蔵人</title>
			<link rel="stylesheet" href="/static/chroma.css"/>
			<style>
				body {
					max-width: 46rem;
					margin: 2rem auto;
					padding: 0 1rem;
					font-family: system-ui, "Hiragino Sans", "Noto Sans TC", sans-serif;
					line-height: 1.9;
				}
				header {
					color: #666;
					border-bottom: 1px solid #ddd;
					padding-bottom: 0.5rem;
					margin-bottom: 2rem;
				}
				.meta {
					color: #888;
					font-size: 0.85rem;
				}
				.diag {
					background: #fef3c7;
					border-left: 3px solid #d97706;
					padding: 0.5rem 0.75rem;
				}
				table {
					border-collapse: collapse;
				}
				td,
				th {
					border: 1px solid #ccc;
					padding: 0.3rem 0.6rem;
				}
				pre {
					background: #f6f6f6;
					padding: 0.75rem;
					overflow-x: auto;
				}

				/* Wikilinks (internal/render/wikilink.go) */
				a.wikilink {
					color: #0969da;
				}
				.wikilink-broken,
				.wikilink-ambiguous {
					border-bottom: 1px dashed #d97706;
					cursor: help;
				}
				.wikilink-ambiguous {
					border-bottom-color: #b91c1c;
				}

				/* Embeds (internal/render/wikilink.go's renderEmbed) */
				.embed {
					border-left: 3px solid #d0d7de;
					margin: 1rem 0;
					padding: 0.1rem 1rem;
				}
				.embed-media {
					background: #f6f6f6;
					border: 1px dashed #ccc;
					padding: 0.5rem 0.75rem;
					color: #666;
				}

				/* Callouts (internal/render/callout.go) — two buckets, two
					   tints (docs/vault-model.md's 兩桶配色 requirement). */
				.callout {
					border-radius: 0.5rem;
					border: 1px solid;
					margin: 1rem 0;
					padding: 0.1rem 1rem;
				}
				.callout-note {
					background: #f0f9ff;
					border-color: #7dd3fc;
				}
				.callout-warning {
					background: #fffbeb;
					border-color: #fbbf24;
				}
				.callout-title {
					font-weight: 600;
				}
				.callout-icon {
					margin-right: 0.4rem;
				}

				/* Highlight (internal/render/highlight.go) */
				mark {
					background: #fef08a;
					padding: 0 0.15rem;
				}

				/* Mermaid (internal/render/wikilink.go's consumeMermaid,
					   assets/js/kurodo.js). The raw source, preformatted, is
					   both the no-JS/SSR fallback presentation and what
					   stays visible if a diagram fails to parse client-side;
					   kurodo.js replaces it with a rendered SVG in place
					   when a diagram is present and the vendored mermaid
					   runtime (/static/mermaid.esm.min.mjs) loads
					   successfully. Mirrors koopa0.dev's editorial.css
					   .mermaid-diagram fallback styling. */
				.mermaid-diagram {
					margin: 1rem 0;
					padding: 0.75rem;
					overflow-x: auto;
					text-align: center;
					font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
					font-size: 0.85rem;
					color: #57606a;
					white-space: pre-wrap;
					background: #fafafa;
					border: 1px dashed #ccc;
				}
				.mermaid-diagram svg {
					max-width: 100%;
					height: auto;
				}

				/* TOC (internal/ui/pages/note.templ's plain nav) */
				nav.toc ul {
					padding-left: 1.2rem;
				}
				nav.toc li[data-level="3"] {
					margin-left: 1rem;
				}
				nav.toc li[data-level="4"],
				nav.toc li[data-level="5"],
				nav.toc li[data-level="6"] {
					margin-left: 2rem;
				}

				.render-diagnostics {
					list-style: none;
					padding: 0;
				}
				.render-diagnostics .diag {
					margin-bottom: 0.3rem;
				}
			</style>
		</head>
		<body>
			<header>蔵人 kurodo</header>
			<main>
				{ children... }
			</main>
			<script src="/static/kurodo.js" defer></script>
		</body>
	</html>
}
