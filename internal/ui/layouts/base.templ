package layouts

import (
	"strconv"

	"github.com/koopa0/yomihon/internal/wording"
)

// Base is the document every page is rendered inside: the themed html element
// carrying the reader's own presentation choices, the head, the shared header,
// the search dialog, and the script that enhances all of it. A page supplies
// its own body as children; nothing above that body varies by page, which is
// what lets the chrome hold still while a navigation transition runs.
templ Base(c Chrome) {
	<!DOCTYPE html>
	<html
		lang={ c.Lang.Tag() }
		if c.Theme != "" {
			data-theme={ c.Theme }
		}
		data-ruby={ c.Ruby }
		data-textsize={ c.TextSize }
		data-rail={ c.Rail }
		if c.Font != "" {
			data-font={ c.Font }
		}
		data-single-key-shortcuts={ singleKeyShortcutsState(c.SingleKeyShortcutsEnabled) }
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			// The drawer and every other scripted surface are styled under
			// data-js, and the module that would set it runs after the first
			// frame. Waiting for it laid a narrow screen out with the rail open
			// across the page and then slid it away on every page change. Setting
			// the mark here, before the first style, lays the page out as it will
			// stay. A browser with scripting off never runs this and keeps the
			// unscripted layout.
			//
			// The same lines say when this document is not the answer to a press,
			// so the content's arrival is not played for it: a page the browser
			// prepared before anyone asked for it, until the reader does ask, one
			// reached by going back or forward, one reloaded, and one opened at a
			// place in it: by a heading's address, by a stretch of text, which no
			// script can read from the location but the navigation can, or by the
			// distance below an anchor that a kept place carries in its query. A
			// reload brings back the page already being read, at the place it was
			// read, so nothing new arrives, and the arrival is a scale that would
			// move the text the reader is looking at, as it would at any place.
			// They are written once, as data attributes for the stylesheet, which
			// is where the arrival lives; a condition the stylesheet worked out for
			// itself would stop and start matching as the reader moved about the
			// page, and play the arrival again each time. The way in is not called
			// nav: the drawer already keeps that name on the root, and its first
			// write would overwrite this one.
			<script nonce={ c.Nonce }>
				{
					const d = document.documentElement;
					d.dataset.js = "on";
					const entry = performance.getEntriesByType("navigation")[0];
					const kept = new URLSearchParams(location.search).has("at");
					if (entry?.type === "back_forward") d.dataset.arrival = "traverse";
					else if (entry?.type === "reload") d.dataset.arrival = "reload";
					else if (kept || entry?.name.includes("#"))
						d.dataset.arrival = "place";
					if (document.prerendering) {
						d.dataset.prerender = "";
						document.onprerenderingchange = () => delete d.dataset.prerender;
					}
				}
			</script>
			// Every page change is a whole new document, so the wait between a
			// press and the page is the server's render time plus the trip. These
			// rules let the browser spend that time before the press: it fetches
			// the pages a reader is likely to open next, and the response waits
			// until a navigation asks for exactly that address. The rules are
			// data, not script, but a page that forbids inline code still wants
			// them signed. A browser that does not know the type ignores the
			// element.
			@speculationScript(c.Nonce)
			// Every page change is a whole new document, and a browser may paint
			// the header and the rail before the column they frame has arrived,
			// which reads as an empty column for a frame. This holds the first
			// paint until the main landmark has been parsed. A browser that does
			// not know the relation ignores it and paints as it always did.
			<link rel="expect" href="#_y-main" blocking="render"/>
			<title>{ c.Title } — yomihon</title>
			<link rel="icon" type="image/svg+xml" href={ templ.URL(c.Assets.URL("yomihon-mark.svg")) }/>
			<link rel="preload" as="font" type="font/woff2" href={ templ.URL(c.Assets.URL("fonts/Geist-Variable.woff2")) } crossorigin/>
			<link rel="preload" as="font" type="font/woff2" href={ templ.URL(c.Assets.URL("fonts/GeistMono-Variable.woff2")) } crossorigin/>
			<link rel="preload" as="font" type="font/woff2" href={ templ.URL(c.Assets.URL("fonts/Newsreader-Latin-Variable.woff2")) } crossorigin/>
			<link rel="stylesheet" href={ templ.URL(c.Assets.URL("app.css")) }/>
			<link rel="stylesheet" href={ templ.URL(c.Assets.URL("chroma.css")) }/>
			@importMapScript(c.Nonce, c.Assets)
		</head>
		<body>
			<a class="y-skiplink" href="#_y-main">{ wording.SkipToContent.In(c.Lang) }</a>
			<div class="yomihon">
				@header(c)
				// Overlay ids use underscores, which authored SectionID values cannot contain.
				@searchDialog(c.Lang)
				@keyboardHelp(c)
				{ children... }
			</div>
			<script nonce={ c.Nonce } type="module" src={ templ.URL(c.Assets.URL("yomihon.js")) }></script>
		</body>
	</html>
}

// header is the shared top chrome, and it carries only what reading needs: the
// wordmark, the furigana switch on a page that has furigana, the control for
// keeping a reading place on a note that offers one, the ⌘K search entry, and
// the way to the reading choices. The theme, the text size, the language and
// the single-key shortcuts are set on that page, beside the sentence that says
// what each one does; the whole-folder view is reached from the desk; the
// keyboard help is opened by its own key.
//
// The two controls a page may or may not draw stand next to the spacer, so the
// search entry and the way to the choices hold the same place on every page and
// only the controls about the note in front of the reader come and go.
//
// The furigana switch is drawn only where the page carries furigana. Its
// setting is one cookie for the whole site, so a reader who switched readings
// off on one Japanese note finds them off on the next; the settings page holds
// the same choice and is one press away on every page, so nobody is left
// without a way to switch them back on.
//
// The switch is a plain <button> whose look is CSS-driven from the root
// data-ruby attribute and its own aria-pressed; preferences.js only flips the
// attribute and the cookie on click. The search entry is a press that names
// the palette and leaves the opening to the browser, so it answers on a page
// running no script at all; the form inside the palette is the same ordinary
// GET to /search it always was.
templ header(c Chrome) {
	<header class="y-header">
		<button class="y-iconbtn y-hamburger" type="button" data-nav-toggle aria-label={ wording.ToggleNavigation.In(c.Lang) } aria-expanded="false" aria-controls="_y-nav-rail">
			<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
		</button>
		<div class="y-brand">
			<a class="y-brand__name" href="/"><img class="y-brand__mark" src={ templ.URL(c.Assets.URL("yomihon-mark.svg")) } width="24" height="24" alt="" aria-hidden="true"/><span>yomihon</span></a>
			<span class="y-brand__tag">{ wording.BrandTag.In(c.Lang) }</span>
		</div>
		<div class="y-header__spacer"></div>
		// Both lengths of the label are drawn and the stylesheet shows the one
		// the row has room for, because which of them fits is a question about
		// the window and the server answering it would have to guess. No single
		// rule going missing can leave the control wordless — the worst an
		// absent rule does is show both lengths at once, which is visibly
		// wrong, where a control that had lost its words would say nothing at
		// all and look deliberate.
		if c.Readings {
			<button class="y-iconbtn y-rubybtn" type="button" data-ruby-toggle aria-label={ wording.ToggleFurigana.In(c.Lang) } aria-pressed={ strconv.FormatBool(c.Ruby == "on") }>
				<span class="y-rubybtn__label y-rubybtn__label--long" aria-hidden="true">{ wording.FuriganaLabel.In(c.Lang) }</span>
				<span class="y-rubybtn__label y-rubybtn__label--short" aria-hidden="true">{ wording.FuriganaLabelShort.In(c.Lang) }</span>
			</button>
		}
		// The reader's own verb on the note in front of them. It is in the
		// header because the header is the piece of the page that stays put
		// while the note scrolls: a control the reader has to travel to records
		// where travelling to it left them, not where they were reading. From
		// the width the reading rail is drawn at, the rail carries the same
		// control and this one steps aside, so a reader is never shown two.
		if c.Mark != nil {
			@headerMark(c.Mark, c.Lang)
		}
		// Native invokers open the palette without script. The script keeps a
		// listener for engines without invokers; the link works without either.
		<button class="y-searchbtn" type="button" command="show-modal" commandfor="_y-search-dialog" data-search-open aria-label={ wording.SearchNotes.In(c.Lang) }>
			<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
			<span class="y-searchbtn__label">{ wording.SearchNotesPrompt.In(c.Lang) }</span>
			<span class="ui-kbd">⌘K</span>
		</button>
		<noscript><a class="y-searchfallback" href="/search">{ wording.SearchTitle.In(c.Lang) }</a></noscript>
		// The way to the reading choices. It carries the page the reader is on,
		// so applying a choice returns them to it. Where the row is narrow the
		// word gives way to a mark of three sliders — not a gear, which promises
		// a machine, where what is behind this is seven sentences — and the
		// link keeps the word as its name.
		<a class="y-prefslink" href={ templ.URL(preferencesHref(c.ReturnTo)) } aria-label={ wording.PreferencesLink.In(c.Lang) } data-carry-position { destinationAttrs(c.Path, "/preferences")... }>
			<svg class="y-prefslink__mark" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path><circle cx="16" cy="7" r="2"></circle><circle cx="10" cy="17" r="2"></circle></svg>
			<span class="y-prefslink__label" aria-hidden="true">{ wording.PreferencesLink.In(c.Lang) }</span>
		</a>
		<span class="y-readline" aria-hidden="true"></span>
	</header>
}

// headerMark is the second face of one control: the same hooks the reading
// rail's carries, so the same client module finds it, posts the same place to
// the same route, and says the same sentence back. Nothing about it is a
// second implementation — a copy would be a second way for the two faces to
// disagree about what a kept place is.
//
// In the row it is a bookmark rather than a sentence, so its words are its
// name and its pressed state says whether the place already kept is in this
// very note. A press on it while pressed keeps the place again, where the
// reader now is, as the rail's button does.
//
// The sentence about a place living on one machine is not repeated here. It is
// said on the desk beside the place it describes, where the reader is asking
// the question it answers; under a row this narrow it would be two lines of
// explanation hanging over the note.
templ headerMark(mark *MarkOffer, lang wording.Lang) {
	<div
		class="y-headermark"
		data-mark-control
		data-mark-path={ mark.Path }
		data-mark-identity={ mark.Identity }
		data-mark-endpoint={ mark.Endpoint }
		data-mark-saved={ wording.MarkSaved.In(lang) }
		data-mark-failed={ wording.MarkNotStored.In(lang) }
		data-mark-kept?={ mark.Kept }
	>
		<button class="y-iconbtn y-headermark__button" type="button" data-mark-button aria-pressed={ strconv.FormatBool(mark.Kept) } aria-label={ wording.MarkSetControl.In(lang) } title={ wording.MarkSetControl.In(lang) }>
			<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M6 3h12v18l-6-4.5L6 21z"></path></svg>
		</button>
		@Reply("y-headermark__said", templ.Attributes{"data-mark-said": true})
	</div>
}

// keyboardHelp is the panel the ? key opens: every key the interface answers
// to, and the way to the page where the single keys are switched on and off.
// It is a popover of its own rather than a part of the header, because what
// opens it is a key and not a control in the row, and a key works on every
// page wherever the reader's focus is.
templ keyboardHelp(c Chrome) {
	<div id="_y-kbd-help" popover class="y-kbdhelp" aria-label={ wording.KeyboardHelp.In(c.Lang) }>
		<h2 class="y-kbdhelp__title">{ wording.KeyboardHelp.In(c.Lang) }</h2>
		@KeyboardKeys(c.Lang)
		// A reader who opened this panel came looking for how the interface
		// behaves, and the rest of that answer, the switch for the single keys
		// included, is one page away.
		<a class="y-kbdhelp__prefs" href={ templ.URL(preferencesHref(c.ReturnTo)) } data-carry-position>{ wording.PreferencesLink.In(c.Lang) }</a>
	</div>
}

// KeyboardKeys is what the keyboard answers to, each key paired with what
// pressing it does. It is a component of its own so that a surface naming
// these keys names them from here: a second copy of the list would keep
// promising a key the day that key moves, and a promise the keyboard does not
// keep is worse than no help panel.
templ KeyboardKeys(lang wording.Lang) {
	<dl class="y-kbdhelp__list">
		<dt><span class="ui-kbd">⌘K</span> / <span class="ui-kbd">Ctrl K</span></dt>
		<dd>{ wording.ShortcutSearch.In(lang) }</dd>
		<dt><span class="ui-kbd">Esc</span></dt>
		<dd>{ wording.ShortcutCloseSearchOrFilter.In(lang) }</dd>
		<dt><span class="ui-kbd">/</span></dt>
		<dd>{ wording.ShortcutJumpToFilter.In(lang) }</dd>
		<dt><span class="ui-kbd">[</span></dt>
		<dd>{ wording.ShortcutToggleSidebar.In(lang) }</dd>
		<dt><span class="ui-kbd">?</span></dt>
		<dd>{ wording.ShortcutOpenHelp.In(lang) }</dd>
	</dl>
}

// searchDialog is the ⌘K command palette: a native <dialog> (top layer,
// backdrop, focus trap, Esc — all free) whose body is a GET form to /search.
// The data hooks add live lexical results while preserving that ordinary form.
//
// It carries an id because the header's press names it: the button declares
// the act and the browser opens the dialog, with no script in between. On a
// page running none, the form inside is still an ordinary GET to the search
// page, so the palette answers with or without the live rows.
templ searchDialog(lang wording.Lang) {
	<dialog id="_y-search-dialog" class="y-searchdialog ui-dialog" data-search data-live-search data-live-search-endpoint="/search/results" closedby="any" aria-label={ wording.SearchNotes.In(lang) }>
		// The palette a reader opens with the keyboard is the same capability
		// the full page offers, so it is announced as the same landmark. The
		// element carries that meaning itself, which is one fewer attribute to
		// keep in step across the two surfaces.
		<search>
			<form class="y-searchdialog__form" method="get" action="/search" data-live-search-form>
				<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
				<input class="y-searchdialog__input" type="search" name="q" placeholder={ wording.SearchNotesPrompt.In(lang) } aria-label={ wording.SearchNotes.In(lang) } data-live-search-input autofocus/>
				<span class="ui-kbd">esc</span>
			</form>
		</search>
		@LiveSearchStatus(lang)
		<div class="y-searchresults" data-live-search-results data-result-count="0" aria-busy="false"></div>
		<div class="y-searchdialog__foot">
			<span>↑↓ { wording.SearchDialogChoose.In(lang) }</span>
			<span>↵ { wording.SearchDialogEnter.In(lang) }</span>
			<span>esc { wording.SearchDialogEsc.In(lang) }</span>
		</div>
	</dialog>
}
