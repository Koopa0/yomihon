package layouts

import (
	"strconv"

	"github.com/koopa0/yomihon/internal/wording"
)

// Base is the document every page is rendered inside: the themed html element
// carrying the reader's own presentation choices, the head, the shared header,
// the search dialog, and the script that enhances all of it. A page supplies
// its own body as children; nothing above that body varies by page, which is
// what lets the chrome stay where it is from one page to the next.
templ Base(c Chrome) {
	<!DOCTYPE html>
	<html
		lang={ c.Lang.Tag() }
		if c.Theme != "" {
			data-theme={ c.Theme }
		}
		data-ruby={ c.Ruby }
		data-textsize={ c.TextSize }
		data-rail={ c.Rail }
		data-sectionbuttons={ c.SectionButtons }
		data-position={ c.Position }
		data-paper={ c.Paper }
		if c.Reading != nil {
			data-note-vault={ c.Reading.Vault }
			data-note-path={ c.Reading.Path }
		}
		if c.Font != "" {
			data-font={ c.Font }
		}
		data-single-key-shortcuts={ singleKeyShortcutsState(c.SingleKeyShortcutsEnabled) }
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			// The drawer and every other scripted surface are styled under
			// data-js, and the module that would set it runs after the first
			// frame. Waiting for it laid a narrow screen out with the rail open
			// across the page and then slid it away on every page change. Setting
			// the mark here, before the first style, lays the page out as it will
			// stay. A browser with scripting off never runs this and keeps the
			// unscripted layout.
			//
			// A page change plays no animation, so there is nothing else to tell
			// a document apart by: the one other mark is for a reader returning
			// to a kept place. That place is a distance below an anchor, carried
			// in the query, and only script can apply it once the anchor has been
			// measured. The mark holds the column out of sight until the page's
			// module has scrolled to the place and removed it, so the first frame
			// painted is the final one; the stylesheet reveals the column on a
			// timer if the module never runs. It is written once, as a data
			// attribute, because a condition the stylesheet worked out for itself
			// would stop and start matching as the reader moved about the page.
			// The way in is not called nav: the drawer already keeps that name on
			// the root, and its first write would overwrite this one.
			//
			// Motion waits for the first paint. Every duration is zero until the
			// root is marked is-ready, two frames after the first one, so the
			// preferences the server stamped on the root never play as a
			// transition on arrival, and a browser running no script never moves.
			<script nonce={ c.Nonce }>
				{
					const d = document.documentElement;
					d.dataset.js = "on";
					if (new URLSearchParams(location.search).has("at")) d.dataset.arrival = "kept";
					requestAnimationFrame(() => requestAnimationFrame(() => d.classList.add("is-ready")));
				}
			</script>
			// A note opens where the reader last stopped in it, and that can be
			// done only once the note is laid out, which is after the browser may
			// have painted its first frame. So the column is held out of sight
			// by the same mark a return to a bookmark uses, here, before the
			// first frame, and only when the browser's storage names a place
			// this note will open at: a note nothing is kept for is never held.
			// The way in decides it with the same three questions the module that
			// puts the place back asks. The setting is on; the address names no
			// section, because a fragment is where the reader asked to go; and
			// the document was opened afresh, because Back, Forward and a reload
			// are put back by the browser itself. The module reveals the column
			// whatever it finds, and the stylesheet does after a delay if the
			// module never runs.
			if c.Reading != nil {
				<script nonce={ c.Nonce }>
					{
						try {
							const d = document.documentElement;
							const way = performance.getEntriesByType("navigation")[0];
							if (d.dataset.position === "on" && !location.hash && way && way.type === "navigate") {
								const kept = JSON.parse(localStorage.getItem("yomihon.positions") || "[]");
								if (kept.some((p) => p.vault === d.dataset.noteVault && p.path === d.dataset.notePath)) d.dataset.arrival = "kept";
							}
						} catch {
							// A tab without storage has no places; the note opens at its top.
						}
					}
				</script>
			}
			// A diagram is drawn after the page is laid out, and the browser puts a
			// returning reader's position back against that first layout, so a
			// drawing that arrives later moves everything under it away from where
			// the reader left off. The drawing remembers how tall each diagram
			// came to, for this tab and this window; a page that comes back says so
			// here, before its first layout, and the stylesheet holds each
			// diagram's place at that height until it is drawn. Only a page that
			// carries a diagram says anything.
			if c.Diagrams {
				<script nonce={ c.Nonce }>
					{
						try {
							const d = document.documentElement;
							const kept = JSON.parse(sessionStorage.getItem("yomihon.diagramHeights") || "null");
							const layout = [innerWidth, d.dataset.textsize, d.dataset.font, d.dataset.rail, d.dataset.sectionbuttons].join("|");
							if (kept && kept.layout === layout) {
								const rules = Object.entries(kept.heights)
									.filter(([key, px]) => /^[0-9a-f]+$/.test(key) && Number.isFinite(px))
									.map(([key, px]) => "[data-mermaid-key=\"" + key + "\"]{--diagram-height:" + px + "px}");
								if (rules.length > 0) {
									const sheet = document.createElement("style");
									sheet.textContent = rules.join("");
									document.head.append(sheet);
								}
							}
						} catch {
							// A tab without storage has no heights; the diagrams are drawn as they always were.
						}
					}
				</script>
			}
			// Every page change is a whole new document, so the wait between a
			// press and the page is the server's render time plus the trip. These
			// rules let the browser spend that time before the press: it fetches
			// the pages a reader is likely to open next, and the response waits
			// until a navigation asks for exactly that address. The rules are
			// data, not script, but a page that forbids inline code still wants
			// them signed. A browser that does not know the type ignores the
			// element.
			@speculationScript(c.Nonce)
			// Every page change is a whole new document, and a browser may paint
			// the header and the rail before the column they frame has arrived,
			// which reads as an empty column for a frame. This holds the first
			// paint until the main landmark has been parsed. A browser that does
			// not know the relation ignores it and paints as it always did.
			<link rel="expect" href="#_y-main" blocking="render"/>
			<title>{ documentTitle(c.Title, c.Vault, c.TitleAlone) }</title>
			<link rel="icon" type="image/svg+xml" href={ templ.URL(c.Assets.URL("yomihon-mark-on-paper.svg")) }/>
			<link rel="preload" as="font" type="font/woff2" href={ templ.URL(c.Assets.URL("fonts/Geist-Variable.woff2")) } crossorigin/>
			<link rel="preload" as="font" type="font/woff2" href={ templ.URL(c.Assets.URL("fonts/GeistMono-Variable.woff2")) } crossorigin/>
			<link rel="preload" as="font" type="font/woff2" href={ templ.URL(c.Assets.URL("fonts/Newsreader-Latin-Variable.woff2")) } crossorigin/>
			<link rel="stylesheet" href={ templ.URL(c.Assets.URL("app.css")) }/>
			<link rel="stylesheet" href={ templ.URL(c.Assets.URL("chroma.css")) }/>
			@importMapScript(c.Nonce, c.Assets)
		</head>
		<body>
			<a class="y-skiplink" href="#_y-main">{ wording.SkipToContent.In(c.Lang) }</a>
			<div class="yomihon">
				@header(c)
				// Overlay ids use underscores, which authored SectionID values cannot contain.
				@searchDialog(c.Lang)
				@keyboardHelp(c)
				{ children... }
			</div>
			<script nonce={ c.Nonce } type="module" src={ templ.URL(c.Assets.URL("yomihon.js")) }></script>
		</body>
	</html>
}

// header is the shared top chrome, and it carries only what reading needs: the
// wordmark and the folder's name, the control for keeping a reading place on a note that offers one,
// the ⌘K search entry, the way to the reading choices, and where the left
// column is a drawer the button that opens it. The theme, the text size, the language and
// the single-key shortcuts are set on that page, beside the sentence that says
// what each one does; the whole-folder view is reached from the desk; the
// keyboard help is opened by its own key.
//
// The two controls a page may or may not draw stand next to the spacer, so the
// search entry and the way to the choices hold the same place on every page and
// only the controls about the note in front of the reader come and go.
//
// The search entry is a press that names
// the palette and leaves the opening to the browser, so it answers on a page
// running no script at all; the form inside the palette is the same ordinary
// GET to /search it always was.
templ header(c Chrome) {
	<header class="y-header">
		// First in the row, where the column it opens is, and shown only where
		// the left column is a drawer. Its word is its name wherever the word is
		// drawn and where a phone's row has room for a mark alone, so the name is
		// taken by reference from a word that stays in the page; aria-expanded
		// says which way a press goes.
		<button class="y-sidebtn" type="button" data-nav-toggle aria-expanded="false" aria-controls="_y-nav-rail" aria-labelledby="_y-sidebtn-word">
			<svg class="y-sidebtn__mark" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
			<span class="y-sidebtn__word" id="_y-sidebtn-word">{ wording.SidebarButton.In(c.Lang) }</span>
		</button>
		// The folder's name is the book's title and the wordmark its publisher:
		// both from 721, and on a phone the name alone, standing where the
		// wordmark was. The link is named by the wordmark's own text, which a
		// reference reads whether or not the word is drawn, so its name does not
		// depend on the width. The folder's name leads to the reading desk until
		// there is a card for the folder to open instead.
		<div class="y-brand">
			<a class="y-brand__name" href="/" aria-labelledby="_y-brand-word"><img class="y-brand__mark" src={ templ.URL(c.Assets.URL("yomihon-mark.svg")) } width="20" height="20" alt="" aria-hidden="true"/><span class="y-brand__word" id="_y-brand-word">yomihon</span></a>
			if c.Vault != "" {
				<span class="y-brand__rule" aria-hidden="true"></span>
				<a class="y-brand__vault" href="/">{ c.Vault }</a>
			}
		</div>
		<div class="y-header__spacer"></div>
		// The search is a field in the row where the row has room for one: an
		// ordinary GET form to the search page, which needs no script, and a
		// list that drops under it as the reader types where there is one. It
		// is not a dialog, so nothing covers the page the reader is searching
		// from (D94); Escape closes the list and a press outside it does too.
		<search class="y-searchfield" data-live-search data-live-search-endpoint="/search/results">
			<form class="y-searchfield__form" method="get" action="/search" data-live-search-form>
				<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
				<input type="search" name="q" value={ c.SearchQuery } placeholder={ wording.SearchNotesPrompt.In(c.Lang) } aria-label={ wording.SearchNotes.In(c.Lang) } enterkeyhint="search" autocomplete="off" spellcheck="false" data-live-search-input/>
				<span class="ui-kbd" aria-hidden="true">⌘K</span>
			</form>
			@LiveSearchStatus(c.Lang)
			<div class="y-searchfield__panel" data-live-search-panel hidden></div>
		</search>
		// A phone's row has no room for a field, so it carries the glass alone,
		// which opens the search over the whole screen. Native invokers open it
		// without script; the script keeps a listener for engines without
		// invokers, and the link works without either.
		<button class="y-searchbtn" type="button" command="show-modal" commandfor="_y-search-dialog" data-search-open aria-label={ wording.SearchNotes.In(c.Lang) }>
			<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
		</button>
		<noscript><a class="y-searchfallback" href="/search">{ wording.SearchTitle.In(c.Lang) }</a></noscript>
		// The reader's own verb on the note in front of them. It is in the
		// header because the header is the piece of the page that stays put
		// while the note scrolls: a control the reader has to travel to records
		// where travelling to it left them, not where they were reading. It is
		// the page's only face of the verb, at every width.
		if c.Mark != nil {
			@headerMark(c.Mark, c.Lang)
		}
		// The note's file for the reader's own editor, beside the bookmark
		// because both act on where the reader is now, which is why it is in
		// the row that stays put while the note scrolls.
		if c.FilePath != "" {
			@headerPath(c.FilePath, c.Lang)
		}
		@paperSwitch(c)
		// The page of what the reader has left in the notes, by its name, as
		// the settings link beside it is.
		<a class="y-headerlink" href="/marks" { destinationAttrs(c.Path, "/marks")... }>{ wording.OpenThoughtsTitle.In(c.Lang) }</a>
		// The way to the reading choices. It carries the page the reader is on,
		// so applying a choice returns them to it. Where the row is narrow the
		// word gives way to a mark of three sliders — not a gear, which promises
		// a machine, where what is behind this is seven sentences — and the
		// link keeps the word as its name.
		<a class="y-prefslink" href={ templ.URL(preferencesHref(c.ReturnTo)) } aria-label={ wording.PreferencesLink.In(c.Lang) } data-carry-position { destinationAttrs(c.Path, "/preferences")... }>
			<svg class="y-prefslink__mark" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path><circle cx="16" cy="7" r="2"></circle><circle cx="10" cy="17" r="2"></circle></svg>
			<span class="y-prefslink__label" aria-hidden="true">{ wording.PreferencesLink.In(c.Lang) }</span>
		</a>
		<span class="y-readline" aria-hidden="true"></span>
	</header>
}

// headerMark is the control for keeping a place: a bookmark with its words
// beside it where the row has the width, and the bookmark alone where it does
// not, its words then being its name. Its pressed state says whether the place
// already kept is in this very note, and a press on it while pressed keeps the
// place again, where the reader now is.
//
// The sentence a press earns is a small label that hangs under the row, or over
// the wordmark where the row is narrow, and stays until the reader's next press
// or key.
// It is positioned out of the row's flow, so it neither covers the title nor
// moves the search entry beside it, and it is said once here: the sentence about
// a place living on one machine is said on the desk, beside the place it
// describes, where the reader is asking the question it answers.
templ headerMark(mark *MarkOffer, lang wording.Lang) {
	<div
		class="y-headermark"
		data-mark-control
		data-mark-path={ mark.Path }
		data-mark-identity={ mark.Identity }
		data-mark-endpoint={ mark.Endpoint }
		data-mark-saved={ wording.MarkSaved.In(lang) }
		data-mark-failed={ wording.MarkNotStored.In(lang) }
		data-mark-kept?={ mark.Kept }
	>
		<button class="y-iconbtn y-headermark__button" type="button" data-mark-button aria-pressed={ strconv.FormatBool(mark.Kept) } aria-label={ wording.MarkSetControl.In(lang) } title={ wording.MarkSetControl.In(lang) }>
			<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M6 3h12v18l-6-4.5L6 21z"></path></svg>
			<span class="y-headermark__label" aria-hidden="true">{ wording.MarkSetControl.In(lang) }</span>
		</button>
		@Reply("y-headermark__said", templ.Attributes{"data-mark-said": true})
	</div>
}

// headerPath is the control that copies the note's full path, with the line of
// the file its current section's heading opens on where the page knows one,
// for the reader to paste into their own editor. It is drawn as the bookmark
// beside it is, a mark with its words, and only where the left column is a
// column: where it is a drawer the row has no room for one more control. Its
// reply hangs out of the row's flow as the bookmark's does. Where the browser
// refuses the copy, the reply holds the path itself, selected, so it can be
// copied by hand.
templ headerPath(path string, lang wording.Lang) {
	<div
		class="y-headerpath"
		data-path-control
		data-path={ path }
		data-path-copied={ wording.CodeCopied.In(lang) }
		data-path-failed={ wording.CopyPathByHand.In(lang) }
	>
		<button class="y-iconbtn y-headerpath__button" type="button" data-path-button aria-label={ wording.CopyPath.In(lang) } title={ wording.CopyPath.In(lang) }>
			<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="8" y="8" width="12" height="12" rx="1.5"></rect><path d="M16 4H5.5A1.5 1.5 0 0 0 4 5.5V16"></path></svg>
			<span class="y-headerpath__label" aria-hidden="true">{ wording.CopyPath.In(lang) }</span>
		</button>
		@Reply("y-headerpath__said", templ.Attributes{"data-path-said": true})
	</div>
}

// keyboardHelp is the panel the ? key opens: every key the interface answers
// to, and the way to the page where the single keys are switched on and off.
// It is a popover of its own rather than a part of the header, because what
// opens it is a key and not a control in the row, and a key works on every
// page wherever the reader's focus is.
templ keyboardHelp(c Chrome) {
	<div id="_y-kbd-help" popover class="y-kbdhelp" aria-label={ wording.KeyboardHelp.In(c.Lang) }>
		<h2 class="y-kbdhelp__title">{ wording.KeyboardHelp.In(c.Lang) }</h2>
		@KeyboardKeys(c.Lang)
		// A reader who opened this panel came looking for how the interface
		// behaves, and the rest of that answer, the switch for the single keys
		// included, is one page away.
		<a class="y-kbdhelp__prefs" href={ templ.URL(preferencesHref(c.ReturnTo)) } data-carry-position>{ wording.PreferencesLink.In(c.Lang) }</a>
	</div>
}

// KeyboardKeys is what the keyboard answers to, each key paired with what
// pressing it does. It is a component of its own so that a surface naming
// these keys names them from here: a second copy of the list would keep
// promising a key the day that key moves, and a promise the keyboard does not
// keep is worse than no help panel.
templ KeyboardKeys(lang wording.Lang) {
	<dl class="y-kbdhelp__list">
		<dt><span class="ui-kbd">⌘K</span> / <span class="ui-kbd">Ctrl K</span></dt>
		<dd>{ wording.ShortcutSearch.In(lang) }</dd>
		<dt><span class="ui-kbd">Esc</span></dt>
		<dd>{ wording.ShortcutCloseSearchOrFilter.In(lang) }</dd>
		<dt><span class="ui-kbd">/</span></dt>
		<dd>{ wording.ShortcutJumpToFilter.In(lang) }</dd>
		<dt><span class="ui-kbd">[</span></dt>
		<dd>{ wording.ShortcutToggleSidebar.In(lang) }</dd>
		<dt><span class="ui-kbd">?</span></dt>
		<dd>{ wording.ShortcutOpenHelp.In(lang) }</dd>
	</dl>
}

// searchDialog is the phone's search surface: a native <dialog> (top layer,
// backdrop, focus trap, Esc — all free) opened by the header's press, whose body
// is a GET form to /search with the answer's few rows under the field. The
// data hooks add live rows while preserving that ordinary form.
//
// It carries an id because the header's press names it: the button declares
// the act and the browser opens the dialog, with no script in between. On a
// page running none, the form inside is still an ordinary GET to the search
// page, so the surface answers with or without the live rows.
templ searchDialog(lang wording.Lang) {
	<dialog id="_y-search-dialog" class="y-searchsurface ui-dialog" data-search data-live-search data-live-search-endpoint="/search/results" closedby="any" aria-label={ wording.SearchNotes.In(lang) }>
		<search>
			<form class="y-searchsurface__bar" method="get" action="/search" data-live-search-form>
				<span class="y-searchsurface__field">
					<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
					<input type="search" name="q" placeholder={ wording.SearchNotesPrompt.In(lang) } aria-label={ wording.SearchNotes.In(lang) } enterkeyhint="search" autocomplete="off" spellcheck="false" data-live-search-input autofocus/>
					<button type="button" class="y-searchsurface__clear" aria-label={ wording.SearchClearField.In(lang) } data-live-search-clear hidden>
						@Icon("close")
					</button>
				</span>
				<button type="button" class="y-searchsurface__cancel" data-search-close>{ wording.SearchCancel.In(lang) }</button>
			</form>
		</search>
		@LiveSearchStatus(lang)
		<div class="y-searchsurface__panel" data-live-search-panel></div>
	</dialog>
}

// paperSwitch is the row's grounds: the three light papers and the night
// lamp. Each is its own small form posting what it sets to the page that
// stores reading choices, so it works with no script: a paper sets the light
// theme and itself together, the night lamp sets dark and
// leaves the paper kept for the day. Following the system is chosen on the
// settings page.
//
// Which option is lit is the stylesheet's to draw, from the root's theme and
// paper and, for a reader following the system, from the system's own
// preference, so the row is never left with none lit and follows the system
// as it changes without a script. The script keeps aria-pressed saying the
// same thing to a screen reader.
templ paperSwitch(c Chrome) {
	<div class="y-paperswitch" role="group" aria-label={ wording.PrefAppearance.In(c.Lang) }>
		@paperOption(c, "stone", wording.PrefPaperStone.In(c.Lang))
		@paperOption(c, "washi", wording.PrefPaperWashi.In(c.Lang))
		@paperOption(c, "white", wording.PrefPaperWhite.In(c.Lang))
		@paperOption(c, "dark", wording.PrefAppearanceDark.In(c.Lang))
	</div>
}

templ paperOption(c Chrome, option, label string) {
	<form class="y-paperswitch__form" method="post" action="/preferences">
		if option == "dark" {
			<input type="hidden" name="theme" value="dark"/>
		} else {
			<input type="hidden" name="theme" value="light"/>
			<input type="hidden" name="paper" value={ option }/>
		}
		<input type="hidden" name="next" value={ c.ReturnTo }/>
		<button class="y-paperswitch__option" type="submit" data-paper-option={ option } aria-pressed={ paperPressed(c.Theme, c.Paper, option) }>{ label }</button>
	</form>
}
