{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "plugins": ["./.github/synchronous-browser-waits.grit"],
  "linter": {
    "rules": {
      "complexity": {
        "useOptionalChain": "off"
      },
      "correctness": {
        "noUndeclaredVariables": "error"
      },
      "style": {
        "useTemplate": "off"
      },
      "suspicious": {
        "noDocumentCookie": "off",
        "noRedundantUseStrict": "off"
      }
    }
  }
}
